# Security headers untuk Cloudflare Workers Static Assets
# Sumber: DESIGN.md bagian aksesibilitas + konfigurasi CSP ketat.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # unsafe-inline: Astro inject scoped component styles. Fonts are self-hosted (@fontsource).
  # frame-src: hanya googletagmanager.com, untuk iframe noscript GTM.
  #   Kanvas layanan 01 memakai tangkapan layar statis (img), jadi tidak ada
  #   lagi iframe situs showcase dan tidak ada domain pihak ketiga di sini.
  # script-src: googletagmanager.com untuk container GTM-T4TCVQP8, plus
  #   static.cloudflareinsights.com untuk Cloudflare Web Analytics.
  # connect-src: wajib eksplisit. Tanpa directive ini beacon GA4 jatuh ke
  #   default-src 'self' lalu diblokir diam-diam (nol data, tanpa error terlihat).
  #   region1 adalah endpoint GA4 untuk trafik Eropa.
  # frame-src: googletagmanager.com untuk iframe noscript GTM.
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://cloudflareinsights.com; frame-src https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none';
