# Security headers untuk Cloudflare Workers Static Assets
# Sumber: DESIGN.md bagian aksesibilitas + konfigurasi CSP ketat.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # unsafe-inline untuk style WAJIB: Astro injek <style> scoped per komponen.
  # Tidak ada script inline, tidak ada eval. style-src 'unsafe-inline' bukan lubang.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none';
