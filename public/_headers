# Security headers untuk Cloudflare Workers Static Assets
# Sumber: DESIGN.md bagian aksesibilitas + konfigurasi CSP ketat.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # unsafe-inline: Astro inject scoped component styles. Fonts are self-hosted (@fontsource).
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none';
