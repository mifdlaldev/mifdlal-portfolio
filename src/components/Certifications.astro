---
import CertMark from './CertMark.astro'
import { featured, more, certTotals } from '../data/certificates'
import CodeComment from './CodeComment.astro'

const certAttrs = (c: (typeof featured)[number]) => ({
  'data-cert': '',
  'data-src': `/certs/${c.slug}.webp`,
  'data-title': c.title,
  'data-title-en': c.titleEn ?? c.title,
  'data-issuer': c.issuer,
  'data-meta': `${c.dateLabel} · ID ${c.credentialId}`,
  'data-meta-en': `${c.dateLabelEn ?? c.dateLabel} · ID ${c.credentialId}`,
  'data-verify': c.verifyUrl ?? '',
  'data-w': String(c.width),
  'data-h': String(c.height),
})
---

<section id="sertifikasi" class="section">
  <CodeComment text="// sertifikasi" textEn="// certifications" />
  <div class="wrap">
    <div class="section-head rise">
      <span class="fig-label" data-i18n-id="fig. 07 · sertifikasi">
        fig. 07 · certifications
      </span>
      <h2 class="section-headline" data-i18n-id="Sertifikasi.">
        Certifications.
      </h2>
      <p
        class="section-sub"
        data-i18n-id={`${certTotals.total} sertifikat dari ${certTotals.issuers} penerbit. Setiap ID dapat diperiksa sendiri di halaman verifikasi penerbitnya. Klik gambar untuk membuka sertifikat penuh.`}
      >
        {certTotals.total} certificates from {certTotals.issuers} issuers. Each ID can be verified
        directly on the issuer's verification page. Click an image to open the full certificate.
      </p>
    </div>

    <ul class="cert-grid">
      {featured.map((c, i) => (
        <li class="cert-card rise" data-rise="up" style={`--rise-delay:${i * 70}ms`}>
          <a
            class="cert-trigger"
            href="#cert-dialog"
            {...certAttrs(c)}
            aria-label={`Open certificate ${c.titleEn ?? c.title} from ${c.issuer}`}
            data-i18n-aria-id={`Buka sertifikat ${c.title} dari ${c.issuer}`}
          >
            <span class="cert-shot">
              <img
                src={`/certs/${c.slug}-thumb.webp`}
                width={c.thumbWidth}
                height={c.thumbHeight}
                alt=""
                draggable="false"
                loading="lazy"
                decoding="async"
              />
              <CertMark id={c.slug} />
              <span class="cert-zoom" aria-hidden="true" data-i18n-id="buka">
                open
              </span>
            </span>
            <span class="cert-body">
              <span class="cert-issuer">{c.issuer}</span>
              <span class="cert-name" data-i18n-id={c.title}>
                {c.titleEn}
              </span>
              {c.note && (
                <span class="cert-note" data-i18n-id={c.note}>
                  {c.noteEn}
                </span>
              )}
              <span class="cert-meta" data-i18n-id={`${c.dateLabel} · ID ${c.credentialId}`}>
                {c.dateLabelEn ?? c.dateLabel} · ID {c.credentialId}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    {more.length > 0 && (
      <div class="cert-cta rise">
        <button
          class="cert-more-btn"
          type="button"
          data-cert-list-open
          aria-haspopup="dialog"
          aria-controls="cert-list"
        >
          <span class="cert-more-btn-label" data-i18n-id="Lihat Lainnya">
            View all
          </span>
          <span class="cert-more-btn-count" aria-hidden="true">
            {more.length}
          </span>
        </button>
        <p
          class="cert-more-btn-note"
          data-i18n-id={`${certTotals.moreHackerrank} sertifikat keahlian HackerRank dan ${certTotals.moreOther} kelas dasar Dicoding.`}
        >
          {certTotals.moreHackerrank} HackerRank skill certificates and {certTotals.moreOther}{' '}
          Dicoding beginner classes.
        </p>

        <noscript>
          <ul class="cert-fallback">
            {more.map((c) => (
              <li>
                <a href="#cert-dialog">
                  {c.titleEn ?? c.title} · {c.issuer} · {c.dateLabelEn ?? c.dateLabel} · ID{' '}
                  {c.credentialId}
                </a>
              </li>
            ))}
          </ul>
        </noscript>
      </div>
    )}
  </div>

  <dialog class="cert-dialog" id="cert-dialog" aria-labelledby="cert-dialog-title">
    <div class="cert-dialog-box" data-lenis-prevent>
      <div class="cert-dialog-head">
        <p class="cert-dialog-issuer" data-dialog-issuer></p>
        <h3 class="cert-dialog-title" id="cert-dialog-title" tabindex="-1" data-dialog-title></h3>
      </div>
      <div class="cert-dialog-figure">
        <span class="cert-plate">
          <img class="cert-dialog-img" alt="" draggable="false" data-dialog-img />
          <CertMark id="dialog" />
        </span>
      </div>
      <div class="cert-dialog-foot">
        <p class="cert-dialog-meta" data-dialog-meta></p>
        {/* Tautan ini baru punya href setelah dialog dibuka untuk kredensial
            yang menyediakan verifyUrl. Sebelum itu href menunjuk ke seksi
            sertifikasi sendiri, supaya markup statis tidak menyisakan <a> tanpa
            href (audit crawlable-anchors skor 0). Elemennya tetap hidden, jadi
            yang tampil hanya setelah skrip mengisi href yang sebenarnya. */}
        <a
          class="cert-dialog-verify"
          data-dialog-verify
          href="#sertifikasi"
          hidden
          target="_blank"
          rel="noopener noreferrer"
          data-i18n-id="verifikasi di situs penerbit ↗"
        >
          verify on issuer site ↗
        </a>
        <button class="cert-dialog-close" type="button" data-dialog-close data-i18n-id="Tutup">
          Close
        </button>
      </div>
    </div>
  </dialog>

  <dialog class="cert-list" id="cert-list" aria-labelledby="cert-list-title">
    <div class="cert-list-box" data-lenis-prevent>
      <div class="cert-list-head">
        <p class="cert-list-fig fig-label" data-i18n-id="fig. 07b · daftar lengkap">
          fig. 07b · full list
        </p>
        <h3
          class="cert-list-title"
          id="cert-list-title"
          tabindex="-1"
          data-i18n-id="Sertifikat keahlian lainnya"
        >
          Other skill certificates
        </h3>
        <p
          class="cert-list-meta"
          data-i18n-id={`${more.length} sertifikat · ${certTotals.moreHackerrank} HackerRank · ${certTotals.moreOther} Dicoding`}
        >
          {more.length} certificates · {certTotals.moreHackerrank} HackerRank ·{' '}
          {certTotals.moreOther} Dicoding
        </p>
        <button class="cert-list-close" type="button" data-cert-list-close data-i18n-id="Tutup">
          Close
        </button>
      </div>

      <ul class="cert-grid cert-grid--list">
        {more.map((c) => (
          <li class="cert-card">
            <a
              class="cert-trigger"
              href="#cert-dialog"
              {...certAttrs(c)}
              aria-label={`Open certificate ${c.titleEn ?? c.title} from ${c.issuer}`}
              data-i18n-aria-id={`Buka sertifikat ${c.title} dari ${c.issuer}`}
            >
              <span class="cert-shot">
                <img
                  src={`/certs/${c.slug}-thumb.webp`}
                  width={c.thumbWidth}
                  height={c.thumbHeight}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
                <CertMark id={c.slug} />
                <span class="cert-zoom" aria-hidden="true" data-i18n-id="buka">
                  open
                </span>
              </span>
              <span class="cert-body">
                <span class="cert-issuer">{c.issuer}</span>
                <span class="cert-name" data-i18n-id={c.title}>
                  {c.titleEn}
                </span>
                <span class="cert-meta" data-i18n-id={`${c.dateLabel} · ID ${c.credentialId}`}>
                  {c.dateLabelEn ?? c.dateLabel} · ID {c.credentialId}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </dialog>
</section>

<style>
  .section-head {
    margin-bottom: 2.5rem;
    max-width: 60ch;
  }

  .section-sub {
    margin: 0.9rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* --- kartu unggulan ------------------------------------- */

  .cert-grid {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .cert-card {
    display: flex;
  }

  .cert-trigger {
    display: flex;
    flex-direction: column;
    width: 100%;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    transition:
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .cert-trigger:hover,
  .cert-trigger:focus-visible {
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }

  .cert-shot {
    position: relative;
    display: block;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-line-soft);
  }

  .cert-shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top center;
  }

  /* Tanda kepemilikan digambar oleh komponen CertMark (SVG sebaris). */

  /* Kotak gambar di dialog: label menempel di sudut gambar, bukan di sudut
     panel, supaya posisinya tetap benar walau gambar lebih sempit. */
  .cert-plate {
    position: relative;
    display: inline-flex;
    max-width: 100%;
    max-height: 100%;
  }

  /* Label "buka" hanya muncul saat hover/fokus. Sub-judul section sudah
     memberi instruksi, jadi label yang selalu tampil cuma menambah bising
     dan menutupi pojok sertifikat. */
  .cert-zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--paper-plate);
    background: color-mix(in srgb, var(--ink-plate) 78%, transparent);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }

  /* Label "buka" hanya di perangkat berpointer. Di layar sentuh hover bisa
     menempel setelah tap, dan labelnya menutupi pojok sertifikat. */
  @media (hover: hover) {
    .cert-trigger:hover .cert-zoom {
      opacity: 1;
    }
  }

  .cert-trigger:focus-visible .cert-zoom {
    opacity: 1;
  }

  .cert-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem 1.15rem;
    flex: 1 1 auto;
  }

  .cert-issuer {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
  }

  .cert-name {
    font-family: var(--font-display);
    font-size: var(--text-title-sm);
    font-weight: 600;
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-title);
    text-wrap: balance;
  }

  .cert-note {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .cert-meta {
    margin-top: auto;
    padding-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    color: var(--color-muted);
  }

  /* --- tombol daftar lengkap ------------------------------ */

  .cert-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.5rem;
  }

  .cert-more-btn {
    border-radius: 999px;
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.8rem 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .cert-more-btn:hover,
  .cert-more-btn:focus-visible {
    color: var(--color-paper);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  /* Angka di dalam tombol: penanda, bukan isi. */
  .cert-more-btn-count {
    font-size: var(--text-cap);
    color: var(--color-electric);
    transition: color var(--dur-fast) var(--ease);
  }

  .cert-more-btn:hover .cert-more-btn-count,
  .cert-more-btn:focus-visible .cert-more-btn-count {
    color: var(--color-lemon);
  }

  /* Tanpa JavaScript tombol tidak bisa membuka dialog, jadi 18 tautan
     ditulis apa adanya. Disembunyikan lagi begitu skrip jalan. */
  .cert-fallback {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    max-width: 100%;
  }

  .cert-fallback a {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }

  .cert-more-btn-note {
    margin: 0;
    max-width: 54ch;
    text-wrap: balance;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    line-height: var(--leading-ui);
    color: var(--color-muted);
    text-align: center;
  }

  /* --- dialog --------------------------------------------- */

  .cert-dialog {
    margin: auto;
    padding: 0;
    width: min(1100px, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
    overflow: hidden;
  }

  .cert-dialog::backdrop {
    background: color-mix(in srgb, var(--ink-plate) 82%, transparent);
  }

  .cert-dialog-box {
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 2rem);
  }

  .cert-dialog-head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem 0.75rem;
    border-bottom: 1px solid var(--color-line);
  }

  .cert-dialog-issuer {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
  }

  .cert-dialog-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-title);
  }

  .cert-dialog-title:focus {
    outline: none;
  }

  .cert-dialog-figure {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    background: var(--color-line-soft);
  }

  .cert-dialog-img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 14rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--color-line);
    background: var(--color-white);
  }

  .cert-dialog-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding: 0.85rem 1.25rem 1rem;
    border-top: 1px solid var(--color-line);
  }

  .cert-dialog-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    color: var(--color-muted);
  }

  .cert-dialog-verify {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .cert-dialog-verify[hidden] {
    display: none;
  }

  .cert-dialog-close {
    border-radius: 999px;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--electric);
    background: var(--electric);
    color: var(--paper);
    cursor: pointer;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .cert-dialog-close:hover {
    opacity: 0.85;
  }

  /* --- dialog daftar lengkap ------------------------------ */

  .cert-list {
    margin: auto;
    padding: 0;
    width: min(1180px, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
    overflow: hidden;
  }

  .cert-list::backdrop {
    background: color-mix(in srgb, var(--ink-plate) 82%, transparent);
  }

  .cert-list-box {
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Kepala lengket: judul tetap terlihat saat daftar digulir. */
  .cert-list-head {
    position: sticky;
    top: 0;
    z-index: var(--z-content);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.3rem 1.5rem;
    padding: 1.1rem clamp(1rem, 3vw, 2rem) 0.9rem;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .cert-list-fig {
    grid-column: 1;
    margin: 0;
  }

  .cert-list-title {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-title);
  }

  .cert-list-title:focus {
    outline: none;
  }

  .cert-list-meta {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    color: var(--color-muted);
  }

  .cert-list-close {
    border-radius: 999px;
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--electric);
    background: var(--electric);
    color: var(--paper);
    cursor: pointer;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .cert-list-close:hover,
  .cert-list-close:focus-visible {
    opacity: 0.85;
  }

  .cert-grid--list {
    margin: 0;
    padding: clamp(1rem, 2.5vw, 2rem);
  }

  @media (min-width: 620px) {
    .cert-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 980px) {
    .cert-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  const dialog = document.getElementById('cert-dialog') as HTMLDialogElement | null

  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-dialog-img]')
    const titleEl = dialog.querySelector<HTMLElement>('[data-dialog-title]')
    const issuerEl = dialog.querySelector<HTMLElement>('[data-dialog-issuer]')
    const metaEl = dialog.querySelector<HTMLElement>('[data-dialog-meta]')
    const verifyEl = dialog.querySelector<HTMLAnchorElement>('[data-dialog-verify]')
    const closeEl = dialog.querySelector<HTMLButtonElement>('[data-dialog-close]')

    const getLang = (): 'id' | 'en' => {
      try {
        const raw = localStorage.getItem('mifdlal-prefs')
        if (raw) {
          const p = JSON.parse(raw)
          if (p && p.lang === 'en') return 'en'
        }
      } catch {}
      return 'id'
    }

    const open = (trigger: HTMLElement) => {
      const d = trigger.dataset
      const en = getLang() === 'en'
      const title = (en ? d.titleEn : d.title) ?? d.title ?? ''
      const meta = (en ? d.metaEn : d.meta) ?? d.meta ?? ''
      if (img) {
        img.src = d.src ?? ''
        img.width = Number(d.w ?? 0)
        img.height = Number(d.h ?? 0)
        img.alt = en
          ? `Certificate ${title} from ${d.issuer ?? ''}`
          : `Sertifikat ${title} dari ${d.issuer ?? ''}`
      }
      if (titleEl) titleEl.textContent = title
      if (issuerEl) issuerEl.textContent = d.issuer ?? ''
      if (metaEl) metaEl.textContent = meta
      if (verifyEl) {
        if (d.verify) {
          verifyEl.href = d.verify
          verifyEl.hidden = false
        } else {
          verifyEl.hidden = true
          verifyEl.removeAttribute('href')
        }
      }
      document.documentElement.classList.add('cert-locked')
      dialog.showModal()
      titleEl?.focus()
    }

    document.querySelectorAll<HTMLElement>('[data-cert]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        const e = event as MouseEvent
        // Semua klik membuka dialog, termasuk klik dengan modifier:
        // gambar sertifikat tidak lagi bisa dibuka sebagai berkas.
        if (e.button !== 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey) return
        event.preventDefault()
        open(trigger)
      })
    })

    closeEl?.addEventListener('click', () => dialog.close())

    // Klik di luar kotak menutup dialog; klik di dalam kotak tidak.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })

    dialog.addEventListener('close', () => {
      // Dialog daftar bisa masih terbuka di bawah; jangan buka kunci scroll.
      if (!document.querySelector('dialog[open]')) {
        document.documentElement.classList.remove('cert-locked')
      }
      if (img) img.removeAttribute('src')
    })
  }

  const listDialog = document.getElementById('cert-list') as HTMLDialogElement | null

  if (listDialog) {
    const openBtn = document.querySelector<HTMLButtonElement>('[data-cert-list-open]')
    const closeBtn = listDialog.querySelector<HTMLButtonElement>('[data-cert-list-close]')
    const listTitle = listDialog.querySelector<HTMLElement>('#cert-list-title')

    openBtn?.addEventListener('click', () => {
      document.documentElement.classList.add('cert-locked')
      listDialog.showModal()
      listTitle?.focus()
    })

    closeBtn?.addEventListener('click', () => listDialog.close())

    // Klik di luar kotak menutup daftar; klik kartu di dalam tidak.
    listDialog.addEventListener('click', (event) => {
      if (event.target === listDialog) listDialog.close()
    })

    listDialog.addEventListener('close', () => {
      if (!document.querySelector('dialog[open]')) {
        document.documentElement.classList.remove('cert-locked')
      }
    })
  }
</script>

<style is:global>
  html.cert-locked {
    overflow: hidden;
  }
</style>
