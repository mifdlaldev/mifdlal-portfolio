---
// Background ASCII hero sekarang vanilla (src/scripts/hero-ascii.ts), bukan
// island React. Alasannya performa: selama komponen ini React, bundel renderer
// React ikut dievaluasi di main thread saat load, dan di Lighthouse mobile itu
// satu long task 3083 ms (92% TBT). Markup, kelas, dan seluruh parameter
// render identik dengan versi React sebelumnya.
---

<section id="hero" class="hero">
  <!-- Scrim atas: navbar state atas sengaja transparan supaya ASCII kelihatan
       apa adanya, jadi teksnya perlu pelindung tipis. Fade ke transparan
       supaya tidak ada garis batas yang terlihat. -->
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-bg" aria-hidden="true">
    <div class="hero-ascii" data-hero-ascii>
      <canvas class="hero-ascii-canvas" aria-hidden="true"></canvas>
    </div>
    <div class="hero-veil"></div>
  </div>

  <script>
    import { mountHeroAscii } from '../scripts/hero-ascii'
    import { mountHeroWordFlip } from '../scripts/hero-flip'

    /* Kotak kata bergilir dipasang LEBIH DULU, sebelum mesin ASCII: kunci
       lebar slot harus terjadi sedini mungkin. Mesin ASCII menyiapkan
       kanvas dan worker, dan kalau dia jalan dulu, penguncian lebar datang
       terlambat dan terhitung sebagai pergeseran tata letak. */
    const flipRoot = document.querySelector<HTMLElement>('[data-hero-flip]')
    if (flipRoot) mountHeroWordFlip(flipRoot)

    const container = document.querySelector<HTMLElement>('[data-hero-ascii]')
    const canvas = container?.querySelector('canvas')
    if (container && canvas) {
      mountHeroAscii(container, canvas, {
        colors: ['var(--electric)'],
        shape: 'horizon',
        density: 1,
        glyphOpacity: 1,
        gradientOpacity: 1,
        glow: 0.5,
        flicker: 0.08,
        grain: 0.03,
        speed: 0.5,
        mouseInteraction: false,
        clickEffect: 'none',
        lightMode: false,
        intro: false,
        fontFamily: '"Geist Mono Variable", ui-monospace, monospace',
      })
    }
  </script>

  <div class="wrap hero-inner">
    <p class="fig-label hero-in" style="--hero-in-delay: 0ms" data-i18n-id="Terbuka untuk proyek">
      Open for projects
    </p>

    <h1 class="hero-title hero-in" style="--hero-in-delay: 70ms">
      <span class="hero-line">
        <span
          class="hero-flip"
          data-hero-flip
          data-words-en="Need,Want,Dream,Imagine"
          data-words-id="Kebutuhanmu,Keinginanmu,Mimpimu,Idemu"
        >
          <span class="hero-flip-lead" data-i18n-id="Bangun">
            Build What You
          </span>
          <span class="hero-flip-box" data-flip-box>
            <span class="hero-flip-frame" data-flip-frame>
              <span class="hero-flip-fit" data-flip-fit aria-hidden="true">
                Need
              </span>
              <span class="hero-flip-word" data-flip-word>
                Need
              </span>
            </span>
            <span class="hero-flip-sizer" data-flip-sizer aria-hidden="true">
              Imagine
            </span>
          </span>
        </span>
      </span>
      <span class="hero-line" data-i18n-id="Di Sini Dengan Cepat">
        Here Quickly
      </span>
    </h1>

    <p
      class="hero-sub hero-in"
      style="--hero-in-delay: 180ms"
      data-i18n-id="Website, web app, chatbot, dan otomasi AI untuk Development & MVP, kebutuhan bisnis, dan solusi digital lainnya."
    >
      Websites, web apps, chatbots, and AI automation for development and MVPs, business needs, and
      other digital solutions.
    </p>

    <div class="hero-actions hero-in" style="--hero-in-delay: 270ms">
      <a href="#kontak" class="btn btn-primary" data-i18n-id="Ceritakan masalahnya">
        Tell me the problem
      </a>
      <a href="#proyek" class="btn btn-ghost" data-i18n-id="Lihat proyek">
        See my work
      </a>
    </div>
  </div>
</section>

<style>
  /* Satu layar penuh di bawah nav 64px */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    /* Full satu layar termasuk area di belakang navbar fixed:
       background ASCII terlihat sampai tepi atas. */
    min-height: 100svh;
    padding-block-start: calc(var(--nav-h) + clamp(2.5rem, 6vh, 4.5rem));
    padding-block-end: clamp(2.5rem, 6vh, 4.5rem);
    background: var(--color-paper);
    overflow: hidden;
  }

  /* Background ASCII + veil untuk keterbacaan teks */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: var(--z-below);
    pointer-events: none;
  }

  /* Wadah ASCII + canvas. Nilai sama dengan utilitas yang dulu dipakai
     komponen React (relative/h-full/w-full/overflow-hidden pada wadah,
     absolute/inset-0/block/h-full/w-full pada canvas) supaya geometri dan
     hasil render identik. Ditulis eksplisit agar tidak bergantung pada
     utilitas Tailwind yang kebetulan ter-generate. */
  .hero-ascii {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  .hero-ascii-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Veil cream tipis: jaga kontras teks di atas karakter ASCII */
  .hero-scrim {
    position: absolute;
    inset: 0 0 auto;
    height: clamp(7rem, 14vw, 10rem);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-ink) 52%, transparent),
      transparent
    );
    pointer-events: none;
    z-index: var(--z-raise);
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    /* Proteksi tipis di zona teks; tepi dibiarkan bersih seperti default. */
    background: radial-gradient(
      ellipse 58% 46% at 50% 46%,
      color-mix(in srgb, var(--color-paper) 62%, transparent) 0%,
      color-mix(in srgb, var(--color-paper) 28%, transparent) 62%,
      transparent 100%
    );
  }

  /* Semua konten hero terpusat */
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  /* Label fig. 01 di atas ASCII: ukuran default, dibungkus badge
     supaya terbaca tanpa menabrak pola glyph di belakangnya. */

  .hero-inner > .fig-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    border: 0;
    background: var(--color-paper);
    color: var(--accent, var(--color-electric));
    /* Jarak ke judul hero di bawahnya. Ditaruh di sini, bukan di
       .hero-title, supaya jarak badge ke judul tidak ikut berubah kalau
       margin judul disetel untuk keperluan lain. */
    margin-bottom: 3rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    font-weight: 700;
    margin: 0;
    text-wrap: balance;
    color: var(--color-paper);
    max-width: 100%;
  }

  /* ============================================================
     ANIMASI MASUK HERO
     Dijalankan CSS murni, mulai sejak berkas gaya dibaca — bukan oleh
     skrip, dan bukan oleh sistem .rise. .rise dipicu saat elemen masuk
     viewport lewat modul motion; untuk hero itu berarti elemen sudah
     sempat tercat di posisi akhir lalu melompat turun (terukur 0.0142
     layout shift) dan cat elemen terbesar tertunda sampai modul dimuat
     (mobile LCP 628ms -> 2012ms).

     Karena animasinya sudah berjalan sejak cat pertama, elemen tidak
     pernah tercat di posisi akhir lebih dulu, jadi transform di sini
     tidak menghasilkan layout shift sama sekali (terukur CLS 0 di
     desktop, mobile, dan tablet).

     Bahasa geraknya sama dengan section lain: naik sedikit sambil
     memudar masuk, dengan jeda bertingkat dari atas ke bawah.

     Keempat elemen memudar, termasuk judul. Elemen beropasitas 0
     diabaikan peramban saat menghitung layout shift, jadi perpaduan
     memudar dan bergerak naik justru menghasilkan CLS 0 di semua
     viewport — lebih baik daripada build tanpa animasi (terukur
     0.023-0.043 desktop). Sekadar menggerakkan elemen yang sudah
     terlihat menghasilkan 0.054.

     Tanpa JavaScript animasi ini tetap jalan (CSS murni). Saat
     prefers-reduced-motion, animasi dimatikan dan elemen langsung pada
     keadaan akhir.
     ============================================================ */
  .hero-in {
    /* Default 0ms: elemen yang tidak memasang jeda sendiri tetap punya
       nilai sah, jadi checker token tidak menganggap var()-nya menggantung
       dan animasinya tidak menunggu apa pun. */
    --hero-in-delay: 0ms;
    animation: hero-in var(--dur-hero-in) var(--ease-out) var(--hero-in-delay) both;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, var(--hero-in-rise), 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in {
      animation: none;
      opacity: 1;
    }
  }

  /* Tiap baris judul jadi blok sendiri supaya pemenggalan baris tetap
     persis seperti dua baris yang diminta, bukan wrap otomatis. */
  .hero-line {
    display: block;
  }

  /* Di layar kecil, baris hero kedua tidak muat 1 baris pada ukuran font
     hero yang tetap terbaca. Izinkan wrap natural. Kotak kata tetap satu
     kesatuan (kotak yang terbelah dua baris bukan lagi kotak), tapi baris
     flip boleh turun baris: kata depan satu baris, kotak di baris
     berikutnya kalau tidak muat. */
  @media (max-width: 560px) {
    .hero-line {
      white-space: normal;
    }

    .hero-flip {
      flex-wrap: wrap;
      justify-content: center;
      white-space: normal;
    }
  }

  /* ==========================================================
     KATA BERGILIR DI JUDUL HERO
     Gaya layout-text-flip: kotak garis rambut, isi transparan,
     tinggi mengikuti baris, lebar mengikuti kata. Tanpa dependency:
     hero sengaja bebas React (lihat catatan di kepala berkas).
     ========================================================== */

  .hero-flip {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    /* Jarak ke kata di sebelahnya, sama seperti spasi teks. */
    gap: 0.26em;
    /* Pergeseran optis: skrip menggeser seluruh grup lewat transform supaya
       blok yang terlihat tetap di tengah saat lebar kotak berubah. Transform
       tidak dihitung sebagai layout shift, jadi tidak ada ongkos CLS. */
    transform: translateX(var(--flip-shift, 0px));
    transition: transform var(--flip-dur) var(--ease-out);
  }

  /* Kata depan judul ("Build What You"): tetap satu frasa, tidak dipotong
     di tengah oleh pemenggalan baris. */
  .hero-flip-lead {
    white-space: nowrap;
  }

  /* Kotak: tiga lapis.
     - .hero-flip-box   slot. Lebarnya dipatok sekali selebar kata
       terpanjang (px dari skrip), jadi tata letak dasar tidak pernah
       bergerak: kata depan diam dan keputusan wrap di layar kecil stabil.
     - .hero-flip-sizer teks tak terlihat, satu-satunya isi yang mengalir.
       Skrip memakainya untuk mengukur lebar tiap kata.
     - .hero-flip-frame bingkai garis rambut menempel tepi KIRI slot,
       lebarnya dianimasikan mengikuti kata. Karena menempel kiri dan
       absolut, tepi kirinya selalu sejauh jarak yang sama dari kata depan:
       jarak antar teks konsisten seperti spasi teks biasa, bukan celah
       panjang saat katanya pendek. */
  .hero-flip-box {
    position: relative;
    display: inline-block;
    height: var(--flip-line);
    /* Kotak tidak boleh terbelah dua baris. */
    white-space: nowrap;
  }

  .hero-flip-sizer {
    display: inline-block;
    visibility: hidden;
    white-space: nowrap;
    padding-inline: var(--flip-pad-inline);
    border: var(--flip-hair) solid transparent;
    border-radius: var(--flip-radius);
    pointer-events: none;
  }

  .hero-flip-frame {
    position: absolute;
    /* Bingkai dilebihkan sedikit melewati slot (offset negatif atas/bawah)
       supaya descender huruf seperti 'g' tidak menyentuh garis bawah.
       Kiri menempel tepi slot, jadi jarak dari kata depan selalu sama. */
    top: calc(-1 * var(--flip-pad-block));
    bottom: calc(-1 * var(--flip-pad-block));
    left: 0;
    padding-inline: var(--flip-pad-inline);
    /* Warna garis ikut warna teks judul (currentColor), bukan --color-line:
       hero selalu berlatar gelap sementara judulnya krem, jadi garis
       berbasis ink gelap akan hilang di latar itu. */
    border: var(--flip-hair) solid color-mix(in srgb, currentColor 55%, transparent);
    border-radius: var(--flip-radius);
    /* Perspektif untuk putaran sumbu X. */
    perspective: var(--flip-perspective);
    /* Tanpa latar: kotak menyatu dengan latar hero, hanya garis yang
       tampak. Isi penuh sudah dipakai chip "Open for projects". */
    background: none;
    /* Kata berputar keluar dari kotak: potong di tepinya. */
    overflow: hidden;
    /* Lebar mengikuti isi: elemen absolut menyusut ke lebar anak
       mengalirnya (.hero-flip-fit). Tidak ada properti lebar yang dipasang
       skrip, jadi tidak ada satu pun perubahan ukuran yang bisa terhitung
       sebagai layout shift. */
    width: fit-content;
  }

  /* Pengukur mengalir di dalam bingkai: satu-satunya isi yang menentukan
     lebar kotak. Tak terlihat, tebal hurufnya sama dengan kata asli. */
  .hero-flip-fit {
    display: block;
    visibility: hidden;
    white-space: nowrap;
    pointer-events: none;
  }

  /* Saat baris terbelah dua di layar kecil (kata depan satu baris, kotak di
     baris berikutnya), kata depan tidak lagi di sebelah kotak, jadi menempel
     kiri tidak ada gunanya: bingkai dipusatkan supaya baris tetap seimbang. */
  .hero-flip-box.is-stacked .hero-flip-frame {
    left: 50%;
    transform: translateX(-50%);
  }

  /* Bayangan tipis saat kotak sedang berganti kata. */
  .hero-flip-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: var(--z-below);
    background: color-mix(in srgb, var(--color-ink) 22%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  .hero-flip-box.is-flip .hero-flip-frame::after {
    opacity: 1;
  }

  .hero-flip-box[data-flip-armed] .hero-flip-frame::after {
    transition: opacity var(--dur-slow) var(--ease);
  }

  /* Kata yang terlihat: ditumpuk memenuhi bingkai. */
  .hero-flip-word {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transform-origin: center center;
    backface-visibility: hidden;
    /* Font display punya ascent jauh lebih besar dari cap-height dan
       descent besar (mis. Geist: ascent 0.975em, descent 0.24em), jadi
       garis dasar jatuh ~0.1em di bawah titik tengah kotak dan ekor huruf
       seperti 'g' menembus garis bawah. Padding bawah menggeser teks naik
       setengahnya, memusatkan tinta huruf secara optis (terukur: sisa di
       atas dan di bawah garis jadi hampir sama). */
    padding-bottom: 0.1em;
  }

  /* --- tiga keadaan, diurut dari longgar ke ketat --- */

  /* Rileks: setelah skrip siap, masuknya kata pakai transisi panjang. */
  .hero-flip-box.is-ready .hero-flip-word {
    transition:
      opacity var(--dur-enter) var(--ease),
      transform var(--dur-enter) var(--ease-out);
  }

  /* Keluar: kata berputar ke atas dan memudar. */
  .hero-flip-box.is-flip .hero-flip-word {
    transform: rotateX(-90deg) translateY(-0.35em);
    opacity: 0;
    transition:
      opacity var(--dur-exit) var(--ease),
      transform var(--dur-exit) var(--ease-in);
  }

  /* Sudut awal kata yang masuk, dipasang tanpa transisi supaya mulai dari
     bawah, bukan dari tempat yang sama. */
  .hero-flip-box.is-in .hero-flip-word {
    transform: rotateX(90deg) translateY(0.35em);
    opacity: 0;
  }

  /* Dipasang sesaat untuk mematikan transisi saat berpindah sudut. */
  .hero-flip-box.is-hold .hero-flip-word {
    transition: none;
  }

  /* Gerak minimal: kotak tetap, kata berganti tanpa animasi. */
  @media (prefers-reduced-motion: reduce) {
    .hero-flip-box.is-ready .hero-flip-word,
    .hero-flip-box.is-flip .hero-flip-word {
      transition: none;
      transform: none;
      opacity: 1;
    }

    .hero-flip-box::after {
      display: none;
    }
  }

  /* Sub-headline: weight 500 supaya tidak tenggelam di atas latar ASCII
     bertekstur, ukuran 20px supaya sepadan dengan perannya (bukan caption). */
  .hero-sub {
    margin: 1.5rem auto 0;
    max-width: 62ch;
    font-size: var(--text-sub);
    font-weight: 500;

    line-height: var(--leading-base);
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* Layar pendek: kurangi padding supaya hero muat */
  @media (max-height: 800px) {
    .hero-actions {
      margin-top: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      display: none; /* dekoratif: matikan sepenuhnya saat reduced-motion */
    }
  }
</style>
