---
import { projects } from '../data/site'
const liveCount = projects.length
---

<section class="hero">
  <div class="wrap">
    <p class="fig-label">portfolio · fig. 01</p>

    <h1 class="hero-title">
      Web app dan otomasi AI,<br />dikerjakan sampai live.
    </h1>

    <p class="hero-sub">
      Freelance developer di Bandung. {liveCount} proyek live, kode terbuka di
      GitHub, dikerjakan sendiri dari desain sampai deploy, bukan handover file.
    </p>

    <div class="hero-actions">
      <a href="#proyek" class="btn btn-primary">Lihat proyek</a>
      <a href="#kontak" class="btn btn-ghost">Email saya</a>
    </div>

    <!-- Panel data gaya Warp: ringkasan bukti, bukan duplikat list proyek -->
    <section class="proof-panel" aria-label="Ringkasan portofolio">
      <div class="proof-cap">
        <span class="proof-label">fig. 01</span>
        <span class="proof-status">
          <span class="live-dot" aria-hidden="true"></span>
          {liveCount} proyek live &amp; terverifikasi
        </span>
      </div>

      <div class="proof-stats">
        <div class="stat">
          <span class="stat-label">proyek</span>
          <span class="stat-value">{String(liveCount).padStart(2, '0')}</span>
        </div>
        <div class="stat">
          <span class="stat-label">repo publik</span>
          <span class="stat-value">{String(liveCount).padStart(2, '0')}</span>
        </div>
        <div class="stat">
          <span class="stat-label">lokasi</span>
          <span class="stat-value">bandung, id</span>
        </div>
        <div class="stat">
          <span class="stat-label">status</span>
          <span class="stat-value">tersedia</span>
        </div>
      </div>
    </section>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 8vh, 5.5rem);
    padding-bottom: var(--space-section);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 1rem 0 0;
    text-wrap: balance;
  }

  .hero-sub {
    margin: 1.5rem 0 0;
    max-width: 52ch;
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.55;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.75rem;
  }

  /* Panel data gaya Warp: dl/dt/dd, bukan list proyek */
  .proof-panel {
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-paper) 88%, white);
  }

  .proof-cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--color-muted);
  }

  .proof-status {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
  }

  .proof-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  /* hapus border kanan di kolom ganjil, border bawah di baris terakhir */
  .stat:nth-child(2n) {
    border-right: 0;
  }
  .stat:nth-last-child(-n+2) {
    border-bottom: 0;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: lowercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    margin: 0;
  }

  .stat-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  @media (min-width: 620px) {
    .proof-stats {
      grid-template-columns: repeat(4, 1fr);
    }
    .stat {
      flex-direction: column;
      gap: 0.3rem;
      align-items: flex-start;
      border-bottom: 0;
    }
    .stat:nth-child(2n) {
      border-right: 1px solid var(--color-line);
    }
    .stat:last-child {
      border-right: 0;
    }
  }
</style>