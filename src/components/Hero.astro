---
import { projects } from '../data/site'
import GradientASCII from '../components/GradientASCII'

const liveCount = projects.length
---

<section class="hero">
  <!-- Background ASCII bergerak (React Bits). Dekoratif: aria-hidden di dalam komponen.
       client:visible -> hidrasi ditunda sampai terlihat, jaga LCP. -->
  <div class="hero-bg" aria-hidden="true">
    <GradientASCII
      client:visible
      colors={['#2a1eff', '#6b7bff', '#1a1522']}
      shape="horizon"
      density={1}
      glyphOpacity={1}
      gradientOpacity={1}
      glow={0.5}
      flicker={0.08}
      grain={0.03}
      speed={0.5}
      mouseInteraction={false}
      clickEffect="none"
      lightMode={false}
      fontFamily='"Azeret Mono Variable", ui-monospace, monospace'
    />
    <div class="hero-veil"></div>
  </div>

  <div class="wrap hero-inner">
    <p class="fig-label">portfolio · fig. 01</p>

    <h1 class="hero-title">
      Web app dan otomasi AI,<br />dikerjakan sampai live.
    </h1>

    <p class="hero-sub">
      Freelance developer di Bandung. {liveCount} proyek live, kode terbuka di
      GitHub, dikerjakan sendiri dari desain sampai deploy, bukan handover file.
    </p>

    <div class="hero-actions">
      <a href="#proyek" class="btn btn-primary">Lihat proyek</a>
      <a href="#kontak" class="btn btn-ghost">Email saya</a>
    </div>

    <!-- Panel data gaya Warp: ringkasan bukti, bukan duplikat list proyek -->
    <section class="proof-panel" aria-label="Ringkasan portofolio">
      <div class="proof-cap">
        <span class="proof-label">fig. 01</span>
        <span class="proof-status">
          <span class="live-dot" aria-hidden="true"></span>
          {liveCount} proyek live &amp; terverifikasi
        </span>
      </div>

      <div class="proof-stats">
        <div class="stat">
          <span class="stat-label">proyek</span>
          <span class="stat-value">{String(liveCount).padStart(2, '0')}</span>
        </div>
        <div class="stat">
          <span class="stat-label">repo publik</span>
          <span class="stat-value">{String(liveCount).padStart(2, '0')}</span>
        </div>
        <div class="stat">
          <span class="stat-label">lokasi</span>
          <span class="stat-value">bandung, id</span>
        </div>
        <div class="stat">
          <span class="stat-label">status</span>
          <span class="stat-value">tersedia</span>
        </div>
      </div>
    </section>
  </div>
</section>

<style>
  /* Satu layar penuh di bawah nav 64px */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    /* Full satu layar termasuk area di belakang navbar fixed:
       background ASCII terlihat sampai tepi atas. */
    min-height: 100svh;
    padding-block-start: calc(var(--nav-h) + clamp(2.5rem, 6vh, 4.5rem));
    padding-block-end: clamp(2.5rem, 6vh, 4.5rem);
    background: var(--color-paper);
    overflow: hidden;
  }

  /* Background ASCII + veil untuk keterbacaan teks */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero-bg :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Veil cream tipis: jaga kontras teks di atas karakter ASCII */
  .hero-veil {
    position: absolute;
    inset: 0;
    /* Proteksi tipis di zona teks; tepi dibiarkan bersih seperti default. */
    background: radial-gradient(
      ellipse 58% 46% at 50% 46%,
      color-mix(in srgb, var(--color-paper) 62%, transparent) 0%,
      color-mix(in srgb, var(--color-paper) 28%, transparent) 62%,
      transparent 100%
    );
  }

  /* Semua konten hero terpusat */
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  /* Label fig. 01 di atas ASCII: putih agar menyatu dengan glyph. */
  .hero-inner > .fig-label {
    color: var(--color-paper);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 1rem 0 0;
    text-wrap: balance;
  }

  .hero-sub {
    margin: 1.5rem auto 0;
    max-width: 48ch;
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.55;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* Panel data gaya Warp: ringkasan bukti, bukan duplikat list proyek */
  .proof-panel {
    width: 100%;
    max-width: 34rem;
    margin: clamp(2.25rem, 5vw, 3.25rem) auto 0;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-paper) 88%, white);
    text-align: left;
  }

  .proof-cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--color-muted);
  }

  .proof-status {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
  }

  .proof-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  /* hapus border kanan di kolom ganjil, border bawah di baris terakhir */
  .stat:nth-child(2n) {
    border-right: 0;
  }
  .stat:nth-last-child(-n+2) {
    border-bottom: 0;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: lowercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    margin: 0;
  }

  .stat-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  @media (min-width: 620px) {
    .proof-stats {
      grid-template-columns: repeat(4, 1fr);
    }
    .stat {
      flex-direction: column;
      gap: 0.3rem;
      align-items: flex-start;
      border-bottom: 0;
    }
    .stat:nth-child(2n) {
      border-right: 1px solid var(--color-line);
    }
    .stat:last-child {
      border-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      display: none; /* dekoratif: matikan sepenuhnya saat reduced-motion */
    }
  }
</style>
