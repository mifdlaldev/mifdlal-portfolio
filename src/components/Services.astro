---
import { services } from '../data/site'
import CodeComment from './CodeComment.astro'
---

<section id="layanan" class="section">
  <CodeComment text="// layanan" />
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 04 · layanan</span>
      <h2 class="section-headline">Yang bisa saya kerjakan untuk bisnis Anda.</h2>
    </div>

    <ul class="service-list">
      {services.map((s) => (
        <li class="service-card">
          <div class="service-media">
            {/* Gambar dummy: ganti file di public/services/ saat asli siap. */}
            <img
              src={s.image}
              alt={`Ilustrasi ${s.title}`}
              width="800"
              height="500"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="service-body">
            <span class="service-no">{s.no}</span>
            <h3 class="service-title">{s.title}</h3>
            <p class="service-text">{s.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  #layanan {
    /* Biru yang sama dengan kartu email di section kontak. */
  }

  /* Satu warna per section: tiga kartu memakai aksen section yang sama.
     Pembeda antar kartu = nomor dan judul, bukan warna. */

  /* Judul section di tengah: blok dibatasi 56ch lalu dipusatkan,
     isinya ikut center. */
  .section-head {
    margin: 0 auto 2.5rem;
    max-width: 56ch;
    text-align: center;
  }

  /* Kartu terpisah: tiap kartu punya border sendiri, jarak antar kartu
     pakai gap. Tidak ada border luar bersama. */
  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-top: 2px solid var(--accent, var(--color-line));
    background: var(--color-paper);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .service-card:hover {
    border-color: color-mix(in srgb, var(--color-ink) 34%, transparent);
    border-top-color: var(--accent, var(--color-line));
  }

  .service-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .service-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Blok teks kartu: permukaan biru, sama seperti kartu email di kontak.
     Area gambar tetap kertas supaya gambar tidak tenggelam. */
  .service-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.25rem 1.25rem 1.5rem;
    background: var(--accent, transparent);
  }

  /* Di atas biru: nomor pakai lemon, judul dan isi pakai kertas. */
  .service-no {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps-loose);
    color: var(--color-lemon);
  }

  .service-title {
    font-family: var(--font-display);
    color: var(--color-paper);
    font-size: var(--text-title);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-title);
    margin: 0;
    text-wrap: balance;
  }

  .service-text {
    margin: 0;
    color: color-mix(in srgb, var(--color-paper) 90%, transparent);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
  }

  /* Tiga kartu sejajar; di layar sempit menumpuk satu kolom. */
  @media (min-width: 860px) {
    .service-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transition: none;
    }
  }
</style>
