---
import { services } from '../data/site'
import CodeComment from './CodeComment.astro'
---

<section id="layanan" class="section">
  <CodeComment text="// layanan" />
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 04 · layanan</span>
      <h2 class="section-headline">Yang bisa saya kerjakan untuk bisnis kamu.</h2>
    </div>

    <ul class="service-list">
      {services.map((s) => (
        <li class="service-card">
          <div class="service-media">
            {/* Gambar dummy: ganti file di public/services/ saat asli siap. */}
            <img
              src={s.image}
              alt={`Ilustrasi ${s.title}`}
              width="800"
              height="500"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="service-body">
            <span class="service-no">{s.no}</span>
            <h3 class="service-title">{s.title}</h3>
            <p class="service-text">{s.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 2.5rem;
    max-width: 56ch;
  }

  /* Kartu terpisah: tiap kartu punya border sendiri, jarak antar kartu
     pakai gap. Tidak ada border luar bersama. */
  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    transition: border-color 160ms ease;
  }

  .service-card:hover {
    border-color: color-mix(in srgb, var(--color-ink) 34%, transparent);
  }

  .service-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .service-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .service-no {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-electric);
  }

  .service-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 0;
    text-wrap: balance;
  }

  .service-text {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Tiga kartu sejajar; di layar sempit menumpuk satu kolom. */
  @media (min-width: 860px) {
    .service-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transition: none;
    }
  }
</style>
