---
import { services } from '../data/site'
import CodeComment from './CodeComment.astro'
---

<section id="layanan" class="section">
  <CodeComment text="// layanan" />
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 04 · layanan</span>
      <h2 class="section-headline">Yang bisa saya kerjakan untuk bisnis kamu.</h2>
    </div>

    <ul class="service-list">
      {services.map((s) => (
        <li class="service-row">
          <span class="service-no">{s.no}</span>
          <div class="service-body">
            <h3 class="service-title">{s.title}</h3>
            <p class="service-text">{s.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 2.5rem;
    max-width: 56ch;
  }

  /* Baris dengan hairline: bukan 3 kartu sama */
  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .service-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem 1.25rem;
    padding: 1.75rem 0.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .service-no {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-electric);
    padding-top: 0.3rem;
  }

  .service-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0 0 0.4rem;
  }

  .service-text {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
    font-size: 0.9375rem;
    max-width: 58ch;
  }

  @media (min-width: 860px) {
    .service-row {
      grid-template-columns: 3rem 22rem 1fr;
      align-items: baseline;
    }
    .service-body {
      display: contents;
    }
    .service-title {
      margin: 0;
    }
    .service-text {
      max-width: 52ch;
    }
  }
</style>