---
import { services, showcaseSites } from '../data/site'
import CodeComment from './CodeComment.astro'
import ServiceBrowserIcon from './ServiceBrowserIcon'
import ServiceBotIcon from './ServiceBotIcon'
import ServiceWorkflowIcon from './ServiceWorkflowIcon'
import WorkflowCanvas from './WorkflowCanvas.tsx'
import SafariWindow from './ui/safari-window.tsx'
import ChatbotCanvas from './ChatbotCanvas.tsx'
import { AsciiArtStatic } from './ui/ascii-art'
---

<section id="layanan" class="section">
  <CodeComment text="// layanan" />
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 04 · layanan</span>
      <h2 class="section-headline">Yang dapat saya kerjakan untuk bisnis Anda.</h2>
      <p class="service-intro">
        Tiap layanan punya panelnya sendiri. Panel itu tempat alur kerjanya
        digambarkan, supaya Anda melihat mekanismenya, bukan hanya membaca
        daftar kemampuan.
      </p>
    </div>

    <ol class="service-list">
      {services.map((s) => (
        <li class="service-row">
          <div class="service-text">
            <span class="service-no">{s.no}</span>
            <div class="service-title-row">
              <h3 class="service-title service-title--blue">{s.title}</h3>
              {s.no === '01' && <ServiceBrowserIcon client:load />}
              {s.no === '02' && <ServiceBotIcon client:load />}
              {s.no === '03' && <ServiceWorkflowIcon client:load />}
            </div>
            <p class="service-desc">{s.body}</p>
          </div>

          <div class="service-panel">
            <div class="service-bar">
              <span class="service-dots" aria-hidden="true">
                <span></span><span></span><span></span>
              </span>
              <span class="service-bar-label">fig. 04.{s.no}</span>
            </div>
            <div class="service-frame">
              {/* Clip parallax: membungkus foto + overlay biru agar pergeseran
                  parallax TIDAK pernah meluber keluar frame. overflow:hidden
                  di sini aman — tidak menyentuh window Safari (sibling di luar
                  wrapper ini, jadi bayangan/handle tidak terpotong).
                  Foto mulai di BAWAH batas frame, naik saat halaman di-scroll. */}
              <div class="service-photo-clip">
                <div
                  class="service-photo"
                  style={`background-image: url('${s.image}')`}
                  role="img"
                  aria-label={`Foto layanan ${s.no}: ${s.title}`}
                ></div>
              </div>

              {/* ASCII tekstur — karakter elektrik samar, di atas overlay biru,
                  di bawah tile. AsciiArtStatic = sekali gambar, nol animasi.
                  Wrapper .service-ascii mengatur posisi/opacity — class tidak
                  diteruskan sebagai prop React oleh Astro, jadi div pembungkus
                  WAJIB. */}
              <div class="service-ascii">
                <AsciiArtStatic
                  client:idle
                  src={s.image}
                  resolution={64}
                  charset="dots"
                  color="var(--electric)"
                  backgroundColor="transparent"
                  objectFit="cover"
                  fontFamily={'"Geist Mono Variable", ui-monospace, monospace'}
                />
              </div>

              {/* Showcase browser window — hanya di layanan 01.
                  Window macOS-style dengan tab: tiap tab memuat situs showcase
                  lewat iframe. Resize bebas dari 8 pinggiran; tombol window
                  semua dinonaktifkan. Mengambang di atas foto + ASCII. */}
              {s.no === '01' && <SafariWindow client:visible tabs={showcaseSites} />}

              {/* Ilustrasi chatbot — hanya di layanan 02. Browser Safari di
                  latar belakang, widget chat melayang di atasnya, phone di
                  depan. Non-interaktif. */}
              {s.no === '02' && <ChatbotCanvas client:visible />}

              {/* Penanda sudut gambar teknik — sekarang sibling .service-photo
                  (z 3) agar di atas ASCII. */}
              <span class="service-corner service-corner--tl" aria-hidden="true"></span>
              <span class="service-corner service-corner--tr" aria-hidden="true"></span>
              <span class="service-corner service-corner--bl" aria-hidden="true"></span>
              <span class="service-corner service-corner--br" aria-hidden="true"></span>

              {s.no === '03' && <WorkflowCanvas client:visible />}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .section-head {
    max-width: 62ch;
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  /* Kalimat pembuka dibatasi 58ch: satu tarikan mata, bukan satu baris
     selebar section. */
  .service-intro {
    margin: 0.85rem 0 0;
    max-width: 58ch;
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
  }

  /* Satu baris = satu layanan. Baris dipisah garis rambut, bukan kotak:
     daftar, bukan tiga kartu berdampingan. */
  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .service-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    padding-block: clamp(2rem, 5vw, 3.25rem);
    border-bottom: 1px solid var(--color-line);
    align-items: center;
  }

  .service-text {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* Judul dan ikon berdiri sebaris: ikon di kanan judul, bukan turun ke
     baris berikutnya seperti elemen blok. align-items center membuat sumbu
     ikon sejajar sumbu teks walau tingginya berbeda. */
  .service-title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    min-height: 0;
  }

  .service-title-row .service-title {
    margin: 0;
    min-width: 0;
  }

  .service-browser-icon {
    display: inline-flex;
    flex: none;
    color: var(--electric);
  }

  .service-bot-icon {
    display: inline-flex;
    flex: none;
    color: var(--electric);
  }

  .service-workflow-icon {
    display: inline-flex;
    flex: none;
    color: var(--electric);
  }

  .service-no {
    font-family: var(--font-mono);
    font-size: calc(var(--text-label) + 0.125rem);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps-loose);
    color: var(--electric);
    text-transform: uppercase;
  }

  .service-title {
    margin: 0.1rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* Judul layanan 01 dan 03 memakai warna aksen biru; layanan 02 tetap
     tinta supaya dua judul tidak berdiri sebagai satu blok warna. */
  .service-title--blue {
    color: var(--electric);
  }

  .service-desc {
    margin: 0.15rem 0 0;
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
  }

  /* Panel: jendela gelap di atas kertas. Satu-satunya bidang gelap besar
     di section ini, jadi mata langsung jatuh ke sana. */
  .service-panel {
    background: var(--color-ink);
    overflow: hidden;
  }

  .service-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.85rem;
    background: var(--electric);
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 14%, transparent);
  }

  .service-dots {
    display: flex;
    align-items: center;
    align-self: center;
    gap: 0.5625rem;
  }

  /* Tiga titik jendela. 14px, monokrom (kertas dengan tiga opasitas) supaya
     tetap masuk palet empat warna. Ukuran ini penting: pada zoom peramban pecahan (80%, 90%)
     titik kecil dibulatkan raster jadi 7x6 dan terbaca lonjong; 14px turun ke
     11x11 tetap bulat. flex 0 0 auto mencegahnya dipencet flexbox. */
  .service-dots span {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-dot-close);
  }

  .service-dots span:nth-child(2) {
    background: var(--color-dot-min);
  }

  .service-dots span:nth-child(3) {
    background: var(--color-dot-max);
  }

  .service-bar-label {
    font-family: var(--font-mono);
    font-size: calc(var(--text-cap) + 0.125rem);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps-loose);
    text-transform: uppercase;
    color: var(--lemon);
  }

  .service-frame {
    position: relative;
    aspect-ratio: 16 / 10;
    /* Catatan: TIDAK ada overflow:hidden. Pergeseran parallax dibatasi
       5% tinggi frame, jauh di bawah headroom scale 1.12 (±6%), jadi
       tidak ada tepi kosong yang bocor. overflow:hidden akan memotong
       bayangan window Safari dan handle resize di pinggir. */
  }

  /* Clip parallax: hanya membungkus foto + overlay biru. overflow:hidden
     di sini memastikan pergeseran foto tidak pernah meluber ke section
     biru atau keluar frame. Window Safari berada DI LUAR wrapper ini,
     jadi bayangan dan handle resize tidak ikut terpotong. */
  .service-photo-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  /* Foto lebih tinggi dari frame (140%) dengan tepi atas -20%: cadangan
     20% di atas dan 20% di bawah. Rentang gerak parallax ±20% tinggi frame
     (total travel 40% ~ 160px pada frame 400px) supaya ilusi kedalaman
     terasa jelas, bukan sekadar geseran kecil.
     --parallax di-set JS: +20% (foto turun, masuk dari bawah) -> -20% (naik). */
  .service-photo {
    position: absolute;
    top: -20%;
    left: 0;
    right: 0;
    height: 140%;
    background-color: var(--ink-900);
    background-size: cover;
    background-position: center;
    /* Sedikit diturunkan saturasinya supaya lukisan masuk palet kertas-tinta. */
    filter: saturate(0.9) contrast(1.02);
    transform: translate3d(0, var(--parallax, 0px), 0);
    will-change: transform;
  }

  /* Overlay biru elektrik — menyatukan earth tone foto dengan palet situs.
     Multiply: highlight foto jadi biru muda, shadow tetap dalam. Foto tidak
     mati, hanya di-tone. 50% = foto masih terbaca, palet bersih, sedikit
     lebih dalam dari sebelumnya. */
  .service-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--electric);
    opacity: 0.5;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* ASCII tekstur — karakter elektrik samar di atas overlay, di bawah tile.
     Bukan elemen dekorasi: tekstur halftone yang membaca sebagai "gambar teknik".
     pointer-events: none WAJIB — kalau tidak, hover tooltip brain mati. */
  .service-ascii {
    position: absolute;
    inset: 0;
    z-index: var(--z-content);
    opacity: 0.3;
    pointer-events: none;
    font-size: 0; /* sembunyikan teks "Loading..." sebelum canvas render */
  }

  /* Root div komponen dirender React — tidak membawa atribut scope Astro,
     jadi wajib :global(). Tanpa ini tinggi root = tinggi canvas default
     (150px), clientHeight salah, grid ASCII gepeng. */
  .service-ascii > :global(div) {
    position: absolute;
    inset: 0;
  }

  .service-ascii :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Penanda sudut gambar teknik — empat L-bracket tipis. Pindah dari dalam
     .service-photo ke .service-frame agar bertumpuk di ATAS ASCII (z 3).
     .service-frame sudah position:relative, jadi posisi relatif frame sama. */
  .service-corner {
    position: absolute;
    width: var(--service-arm);
    height: var(--service-arm);
    border: 0 solid var(--paper-60);
    pointer-events: none;
    z-index: var(--z-corner);
  }

  .service-corner--tl {
    top: var(--service-inset);
    left: var(--service-inset);
    border-top-width: var(--service-hair);
    border-left-width: var(--service-hair);
  }

  .service-corner--tr {
    top: var(--service-inset);
    right: var(--service-inset);
    border-top-width: var(--service-hair);
    border-right-width: var(--service-hair);
  }

  .service-corner--bl {
    bottom: var(--service-inset);
    left: var(--service-inset);
    border-bottom-width: var(--service-hair);
    border-left-width: var(--service-hair);
  }

  .service-corner--br {
    bottom: var(--service-inset);
    right: var(--service-inset);
    border-bottom-width: var(--service-hair);
    border-right-width: var(--service-hair);
  }

  /* Layer animasi alur kerja (layanan 03) ditangani komponen WorkflowCanvas
     (React Flow), posisinya absolute di dalam .service-frame, menumpuk di atas foto. */

  /* Zigzag: baris ganjil teks di kiri, baris genap panel di kiri. */
  @media (min-width: 800px) {
    .service-row {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: clamp(2rem, 5vw, 4.5rem);
    }

    /* Kolom dibalik, bukan hanya urutannya. Tanpa ini panel pada baris
       genap masuk ke kolom sempit dan tampak lebih kecil dari baris lain. */
    .service-row:nth-child(even) {
      grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    }

    .service-row:nth-child(even) .service-text {
      order: 2;
    }

    .service-row:nth-child(even) .service-panel {
      order: 1;
    }
  }

  /* Layar kecil: frame lebih tinggi (4/3) supaya toolbar + tab bar +
     konten iframe punya ruang vertikal. Ketiga canvas (01 Safari, 02
     chatbot, 03 workflow) memakai .service-frame yang sama. */
  @media (max-width: 719px) {
    .service-frame {
      aspect-ratio: 4 / 3;
    }

    .service-bar {
      padding: 0.5rem 0.75rem;
    }

    .service-bar-label {
      font-size: var(--text-cap);
    }
  }

  /* Canvas 02 (chatbot) di layar HP: frame portrait 4/5 supaya phone
     mockup dapat tinggi. Tanpa ini phone hanya ~100px lebar dan bubble
     terpotong. Hanya baris layanan ke-2 (chatbot) yang berubah. */
  @media (max-width: 560px) {
    .service-row:nth-child(2) .service-frame {
      aspect-ratio: 4 / 5;
    }
  }
</style>

<!-- Larangan klik kanan (context menu) pada ketiga canvas layanan.
     Event listener di fase capture: diblokir sebelum elemen lain
     menanganinya. Cakupan: klik kanan dan long-press di seluruh area
     .service-frame beserta turunannya (foto, ASCII, tiles, window Safari,
     iframe). Menu sistem (Inspect Element, View Page Source, dll.) tidak
     pernah muncul di area canvas. -->
<script>
  document.addEventListener(
    'contextmenu',
    (e) => {
      const frame = (e.target as HTMLElement | null)?.closest('.service-frame');
      if (!frame) return;
      e.preventDefault();
      e.stopPropagation();
    },
    true
  );

  /* Parallax foto canvas layanan — versi clip: foto tidak pernah meluber.
     Foto di dalam .service-photo-clip (overflow:hidden). Pergeseran dibatasi
     ±20% tinggi frame = cadangan headroom foto (tinggi 140%, tepi atas -20%).
     Total travel 40% tinggi frame (~160px pada frame 400px) — gerakan cukup
     besar agar ilusi kedalaman terasa jelas, bukan sekadar geseran kecil.
     Lerp 0.12 membuat pergerakan mulus, tidak patah-patah di tiap scroll.
     Dimatikan saat prefers-reduced-motion: reduce. */
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!reduceMotion.matches) {
    const clips = Array.from(document.querySelectorAll<HTMLElement>('.service-photo-clip'));
    const SHIFT_MAX = 0.2; // ±20% tinggi frame (pas dengan headroom foto 140%)
    // LERP 1 (tanpa penghalusan): Lenis sudah me-smoothing input scroll,
    // jadi parallax mengikuti scroll yang sudah halus 1:1. Menambah lerp di
    // sini berarti dua lapis easing -> gerakan terasa lembab/mushy.
    const LERP = 1;
    const current = new Map<HTMLElement, number>();
    let running = false;

    const tick = () => {
      const vh = window.innerHeight;
      let animating = false;

      for (const clip of clips) {
        const rect = clip.getBoundingClientRect();
        const inView = rect.bottom > -vh * 0.2 && rect.top < vh * 1.2;
        if (!inView) continue;

        // p: 0 = frame baru masuk dari bawah, 1 = frame hampir keluar di atas
        const p = (vh - rect.top) / (vh + rect.height);
        // target: +20% (foto turun, masuk dari bawah) -> -20% (foto naik penuh)
        const target = (SHIFT_MAX - p * 2 * SHIFT_MAX) * rect.height;
        const prev = current.get(clip) ?? target;
        const next = prev + (target - prev) * LERP;

        current.set(clip, next);
        clip.style.setProperty('--parallax', `${next.toFixed(1)}px`);

        if (Math.abs(target - next) > 0.5) animating = true;
      }

      if (animating) {
        window.requestAnimationFrame(tick);
      } else {
        running = false;
      }
    };

    const kick = () => {
      if (running) return;
      running = true;
      window.requestAnimationFrame(tick);
    };

    kick();
    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick, { passive: true });
  }
</script>
