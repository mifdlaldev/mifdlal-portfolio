---
import { stack } from '../data/site'
---

<section id="tentang" class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 03 — tentang</span>
      <h2 class="section-headline">Developer di Bandung.</h2>
    </div>

    <div class="about-grid">
      <div class="about-copy">
        <p class="lede">
          Saya bangun aplikasi web dan otomasi AI untuk bisnis kecil dan menengah
          di Indonesia. Fokus: hasil yang jalan, bukan slide.
        </p>
        <p>
          Semua proyek di halaman ini bisa kamu buka dan periksa sendiri. Saya
          tangani setiap tahap sendiri, dari desain sampai deploy. AI saya pakai
          sebagai alat kerja untuk mengurangi kerja berulang.
        </p>
        <p class="learning">Sedang dipelajari: otomasi workflow dengan n8n.</p>
      </div>

      <aside class="about-stack" aria-label="Teknologi yang digunakan">
        <p class="stack-label">tools / stack</p>
        <ul class="stack-list">
          {stack.map((s, i) => (
            <li class="stack-item">
              <span class="stack-no">{String(i + 1).padStart(2, '0')}</span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 2rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .about-copy {
    max-width: 62ch;
  }

  .lede {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .about-copy p:not(.lede) {
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
  }

  .about-copy .learning {
    font-family: var(--font-mono);
    font-size: 0.6875rem !important;
    color: var(--color-muted);
    margin: 0 !important;
  }

  .about-stack {
    border-top: 1px solid var(--color-line);
  }

  .stack-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--color-muted);
    margin: 0;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .stack-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 1.5rem;
  }

  .stack-item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink);
  }

  .stack-no {
    color: var(--color-muted);
    font-size: 0.625rem;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
      gap: clamp(3rem, 8vw, 7rem);
      align-items: start;
    }
  }
</style>
