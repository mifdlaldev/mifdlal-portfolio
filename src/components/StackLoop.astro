---
import LogoLoop from './LogoLoop'
import { stack } from '../data/site'

const logos = stack.map((s) => ({ src: s.logo, alt: s.name }))
---

<section id="stack" class="section">
  <div class="wrap">
    <div class="loop-band">
      <LogoLoop
        client:visible
        logos={logos}
        speed={55}
        logoHeight={26}
        gap={0}
        fadeOut={false}
        pauseOnHover={true}
        scaleOnHover={false}
        ariaLabel="Teknologi yang dipakai"
      />
    </div>
  </div>
</section>

<style>
  /* Strip logo: dikurung di dalam container, sel rapat bergaris. */
  .loop-band {
    position: relative;
    border-block: 1px solid var(--color-line);
    overflow: hidden;
    background: var(--color-paper);
  }

  .loop-band :global(li) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.5rem;
    padding-inline: clamp(1.1rem, 2.4vw, 1.9rem);
    border-right: 1px solid var(--color-line);
  }

  /* Logo hitam dulu, warna asli saat hover. */
  .loop-band :global(img) {
    filter: brightness(0) saturate(100%);
    opacity: 0.72;
    transition: filter 180ms ease, opacity 180ms ease;
  }

  .loop-band :global(li:hover img) {
    filter: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-band :global(img) {
      transition: none;
    }
  }
</style>
