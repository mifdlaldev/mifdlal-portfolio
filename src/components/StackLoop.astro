---
import LogoLoop from './LogoLoop'
import { stack } from '../data/site'

const logos = stack.map((s) => ({ src: s.logo, alt: s.name, title: s.name }))
---

<section id="stack" class="section section--band">
  <div class="wrap">
    <div class="loop-band">
      <LogoLoop
        client:visible
        logos={logos}
        speed={55}
        logoHeight={34}
        gap={0}
        fadeOut={false}
        pauseOnHover={true}
        scaleOnHover={false}
        labels="hover"
        intro={false}
        ariaLabel="Teknologi yang dipakai"
      />
    </div>
  </div>
</section>

<style>
  /* Strip logo: dikurung di dalam container, sel rapat bergaris. */
  .loop-band {
    position: relative;
    overflow: hidden;
    /* Transparan: garis rail vertikal section tetap terlihat menembus pita. */
    background: transparent;
    /* Keluar dari padding .wrap supaya tepi loop pas di garis kiri/kanan. */
    margin-inline: calc(-1 * var(--grid-gutter));
  }

  /* Tinggi band dikunci: garis pemisah sel membentang penuh
     dari garis section atas sampai garis section berikutnya. */
  .loop-band {
    height: 5.75rem;
  }

  /* LogoLoop dirender di dalam <astro-island>, jadi root React bukan
     anak langsung .loop-band. Tinggi dipatok eksplisit (bukan 100%)
     supaya tidak ada dependensi sirkular tinggi yang bikin layout
     bergetar tiap frame. */
  .loop-band {
    --logoloop-pad: 0px;
    --band-h: 5.75rem;
  }

  .loop-band :global(astro-island),
  .loop-band :global(astro-island > div),
  .loop-band :global(astro-island > div > div),
  .loop-band :global(ul) {
    height: var(--band-h);
  }

  .loop-band :global(li) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--band-h);
    padding-block: 0;
    padding-inline: clamp(1.25rem, 2.6vw, 2.1rem);
    border-right: 1px solid var(--color-line);
  }

  /* Ujung strip: garis putus-putus, menutup rail solid di segmen ini
     supaya batas masuk/keluarnya logo terbaca. */
  .loop-band::before,
  .loop-band::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 5px;
    background-color: var(--color-paper);
    background-image: repeating-linear-gradient(
      to bottom,
      var(--color-line) 0 4px,
      transparent 4px 9px
    );
    background-size: 1px 100%;
    background-repeat: no-repeat;
    background-position: center;
    z-index: 3;
    pointer-events: none;
  }

  .loop-band::before {
    left: -2px;
  }

  .loop-band::after {
    right: -2px;
  }

  /* Tooltip nama tools: chip mono kecil di bawah logo. */
  .loop-band :global(li > span) {
    z-index: 4;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    padding: 0.15rem 0.4rem;
    /* Anchor ke tepi atas sel, bukan tinggi li: engine mengukur ulang
       tinggi li tiap frame dan itu membuat tooltip ikut bergetar. */
    top: 0.3rem;
    bottom: auto;
    margin: 0;
  }

  /* Logo hitam dulu, warna asli saat hover. */
  .loop-band :global(img) {
    filter: brightness(0) saturate(100%);
    opacity: 0.72;
    transition: filter 180ms ease, opacity 180ms ease;
  }

  .loop-band :global(li:hover img) {
    filter: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-band :global(img) {
      transition: none;
    }
  }
</style>
