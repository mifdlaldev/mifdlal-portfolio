---
import LogoLoop from './LogoLoop'
import { stack } from '../data/site'

const logos = stack.map((s) => ({ src: s.logo, alt: s.name, title: s.name }))
---

<section id="stack" class="section section--band">
  <div class="loop-band">
    <LogoLoop
      client:visible
      logos={logos}
      speed={55}
      logoHeight={34}
      gap={0}
      fadeOut={false}
      pauseOnHover={true}
      scaleOnHover={false}
      labels="hover"
      intro={false}
      ariaLabel="Teknologi yang dipakai"
    />
  </div>
</section>

<style>
  /* Pita logo tidak punya identitas warna sendiri; node di rail memakai
     aksen utama situs supaya tidak tertinggal abu. */

  /* Strip logo: selebar rail section, bukan selebar viewport. */
  .loop-band {
    position: relative;
    overflow: hidden;
    /* Transparan: garis rail vertikal section tetap terlihat menembus pita. */
    background: transparent;
    /* Tepi pita jatuh tepat di kolom rail: rail kiri digambar pada
       var(--rail-offset) dan rail kanan pada calc(100% - var(--rail-offset)),
       yang untuk garis 1px berakhir satu kolom sebelum tepi itu. Dengan
       margin rail-offset di kedua sisi, kolom 1px di tepi pita menempati
       kolom yang sama dengan rail section di atas dan di bawahnya. */
    margin-inline: var(--rail-offset);
  }

  /* Tinggi band dikunci: garis pemisah sel membentang penuh
     dari garis section atas sampai garis section berikutnya. */
  .loop-band {
    height: 5.75rem;
  }

  /* LogoLoop dirender di dalam <astro-island>, jadi root React bukan
     anak langsung .loop-band. Tinggi dipatok eksplisit (bukan 100%)
     supaya tidak ada dependensi sirkular tinggi yang bikin layout
     bergetar tiap frame. */
  .loop-band {
    --logoloop-pad: 0px;
  }

  .loop-band :global(astro-island),
  .loop-band :global(astro-island > div),
  .loop-band :global(astro-island > div > div),
  .loop-band :global(ul) {
    height: var(--band-h);
  }

  /* Engine menulis --logoloop-pad inline (>=22px) untuk ruang tooltip.
     Kalau dibiarkan, konten terdorong keluar band dan logo terpotong.
     Tooltip kita tempatkan sendiri lewat CSS, jadi padding-nya nol. */
  .loop-band :global(astro-island > div) {
    --logoloop-pad: 0px !important;
  }

  .loop-band :global(li) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--band-h);
    padding-block: 0;
    padding-inline: clamp(1.25rem, 2.6vw, 2.1rem);
    border-right: 1px solid var(--color-line);
  }

  /* Ujung strip: garis putus-putus digambar oleh .section--band memakai
     posisi rail yang sama dengan section lain, jadi tidak perlu pseudo
     di sini. */

  /* Tooltip nama tools: chip mono kecil di bawah logo. Nama tool ditulis apa
     adanya ("Next.js", "Tailwind CSS"); jangan dipaksa lowercase. */
  .loop-band :global(li > span) {
    z-index: var(--z-tooltip);
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-bold);
    text-transform: none;
    color: var(--color-paper);
    background: var(--electric);
    border: 1px solid var(--electric);
    padding: 0.15rem 0.4rem;
    /* Anchor ke tepi atas sel, bukan tinggi li: engine mengukur ulang
       tinggi li tiap frame dan itu membuat tooltip ikut bergetar. */
    top: 0.3rem;
    bottom: auto;
    margin: 0;
    /* Tailwind komponen menambah translate Y +4px; itu yang mendorong
       chip keluar tepi band. Kunci ke 0, sisakan centering X. */
    translate: -50% 0;
  }

  /* Selang-seling: sel ganjil tooltip di atas, sel genap di bawah. */
  .loop-band :global(li[data-tip='down'] > span) {
    top: auto;
    bottom: 0.3rem;
  }

  /* Logo selalu monokrom: sidik asli dimatikan, hanya tinta yang tersisa.
     Hover menaikkan opasitas, bukan mengembalikan warna merek — palet
     dikunci empat warna. */
  .loop-band :global(img) {
    filter: brightness(0) saturate(100%);
    opacity: 0.62;
    transition: opacity var(--dur-base) var(--ease);
  }

  .loop-band :global(li:hover img) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-band :global(img) {
      transition: none;
    }
  }
</style>
