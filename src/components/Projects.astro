---
import { projects } from '../data/site'
import CodeComment from './CodeComment.astro'

/* Gambar masih placeholder. Tiap proyek memakai berkas dummy di
   public/projects/proj-0N.svg sampai tangkapan layar asli dikirim. */
const thumb = (no: string) => `/projects/proj-${no}.svg`
---

<section id="proyek" class="section">
  <CodeComment text="// proyek" />
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 03 · proyek</span>
      <h2 class="section-headline">Hasil kerja yang dapat Anda periksa sendiri.</h2>
    </div>

    <ul class="project-list">
      {projects.map((p) => (
        <li class="project-card">
          <a
            href={p.live}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
            aria-label={`Buka ${p.name} di tab baru`}
          >
            <span class="project-shot">
              <img
                src={thumb(p.no)}
                width="1600"
                height="1000"
                alt=""
                draggable="false"
                loading="lazy"
                decoding="async"
              />
              <span class="project-no" aria-hidden="true">{p.no}</span>
            </span>

            <span class="project-body">
              <span class="project-role">{p.role}</span>
              <span class="project-name">{p.name}</span>
              <span class="project-desc">{p.description}</span>

              <span class="project-foot">
                <span class="project-stack">{p.stack.join(' · ')}</span>
                <span class="project-live">
                  live<span class="project-arrow" aria-hidden="true">↗</span>
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 2.5rem;
    max-width: 56ch;
  }

  /* Bentuk kartu mengikuti kartu sertifikasi: gambar di atas, keterangan di
     bawah, garis tipis sebagai satu-satunya pembatas. Bedanya, seluruh kartu
     adalah satu tautan hidup ke hasil kerja, jadi tidak ada dialog. */
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    transition:
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .project-card:hover {
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }

  .project-link {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .project-link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  /* --- gambar --------------------------------------------- */

  .project-shot {
    position: relative;
    display: block;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-line-soft);
    transition: border-color var(--dur-fast) var(--ease);
  }

  /* Garis bawah gambar menjadi aksen saat kartu disorot: penanda halus bahwa
     gambar itu milik tautan, tanpa menambah elemen baru. */
  .project-card:hover .project-shot {
    border-bottom-color: var(--accent);
  }

  .project-shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    transition: transform 600ms var(--ease);
  }

  /* Nomor menempel di atas gambar seperti pelat nomor pada gambar teknik:
     bidang aksen penuh, satu-satunya bidang berwarna di kartu. */
  .project-no {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    padding: 0.15rem 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    color: var(--color-paper);
    background: var(--accent);
    border: 1px solid var(--accent);
  }

  @media (hover: hover) {
    .project-link:hover .project-shot img {
      transform: scale(1.025);
    }
  }

  /* --- keterangan ----------------------------------------- */

  .project-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.2rem 1.25rem;
  }

  .project-role {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
  }

  .project-name {
    font-family: var(--font-display);
    font-size: var(--text-title-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-title);
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .project-desc {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* Kaki kartu didorong ke dasar supaya kartu sebaris rata bawah meski
     panjang keterangannya berbeda. */
  .project-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-line-soft);
  }

  .project-stack {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    color: var(--color-muted);
  }

  .project-live {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .project-arrow {
    display: inline-block;
    margin-left: 0.2rem;
    transition: transform var(--dur-fast) var(--ease);
  }

  .project-link:hover .project-arrow,
  .project-link:focus-visible .project-arrow {
    transform: translate(0.12rem, -0.12rem);
  }

  @media (min-width: 720px) {
    .project-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .project-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-shot img,
    .project-arrow {
      transition: none;
    }

    .project-card:hover {
      transform: none;
    }

    .project-link:hover .project-shot img {
      transform: none;
    }
  }
</style>
