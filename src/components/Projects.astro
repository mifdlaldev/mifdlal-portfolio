---
import { projects } from '../data/site'
import CodeComment from './CodeComment.astro'
---

<section id="proyek" class="section">
  <CodeComment text="// proyek" />
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 03 · proyek</span>
      <h2 class="section-headline">Hasil kerja yang bisa Anda periksa sendiri.</h2>
    </div>

    <ol class="project-list">
      {projects.map((p) => (
        <li class="project-row-li">
          <a
            href={p.live}
            target="_blank"
            rel="noopener noreferrer"
            class="project-row"
          >
            <span class="proof-no">{p.no}</span>

            <div class="project-main">
              <div class="project-head">
                <h3 class="project-name">{p.name}</h3>
                <span class="project-role">{p.role}</span>
              </div>
              <p class="project-desc">{p.description}</p>
            </div>

            <div class="project-side">
              <span class="project-stack">{p.stack.join(' · ')}</span>
              <span class="project-link">
                live<span class="arrow" aria-hidden="true">↗</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 2.5rem;
    max-width: 56ch;
  }

  /* Baris lebar bernomor: bukan grid kartu identik */
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .project-row-li {
    border-bottom: 1px solid var(--color-line);
  }

  .project-row {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem 1.25rem;
    padding: 1.375rem 0.5rem;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: background-color 0.15s ease;
  }

  .project-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-electric);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.18s ease;
  }

  .project-row:hover,
  .project-row:focus-visible {
    background: color-mix(in srgb, var(--color-electric) 4%, var(--color-paper));
    outline: none;
  }

  .project-row:hover::before,
  .project-row:focus-visible::before {
    transform: scaleY(1);
  }

  .proof-no {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
    padding-top: 0.25rem;
  }

  .project-main {
    min-width: 0;
  }

  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .project-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .project-role {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: lowercase;
    color: var(--color-muted);
    text-align: right;
    max-width: 12rem;
  }

  .project-desc {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 62ch;
  }

  .project-side {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    padding-top: 0.15rem;
  }

  .project-stack {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .project-link {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--color-electric);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .arrow {
    margin-left: 0.15rem;
  }

  /* Tablet ke atas: kolom stack/live di kanan */
  @media (min-width: 720px) {
    .project-row {
      grid-template-columns: 2.5rem 1fr auto;
      align-items: center;
    }
    .project-side {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
    }
  }

  @media (min-width: 980px) {
    .project-row {
      grid-template-columns: 2.5rem 1fr 14rem auto;
    }
    .project-side {
      flex-direction: column;
      align-items: flex-end;
      gap: 0.4rem;
    }
  }
</style>
