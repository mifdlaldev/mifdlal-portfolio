---
import { projects } from '../data/site'
---

<section id="proyek" class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">01 / Proyek</span>
      <h2 class="section-title">Hasil kerja yang bisa kamu klik sendiri.</h2>
    </div>

    <ol class="project-list">
      {projects.map((p) => (
        <li>
          <a
            href={p.live}
            target="_blank"
            rel="noopener noreferrer"
            class="project-row glass-hover"
            aria-label={`${p.name}: ${p.description} (buka di tab baru)`}
          >
            <span class="project-no">{p.no}</span>

            <div class="project-main">
              <div class="project-head">
                <h3 class="project-name">{p.name}</h3>
                <span class="project-role">{p.role}</span>
              </div>
              <p class="project-desc">{p.description}</p>
              <div class="project-meta">
                <span class="project-stack">
                  {p.stack.map((s) => <span class="tag">{s}</span>)}
                </span>
                <span class="project-link">
                  Lihat live
                  <span aria-hidden="true">↗</span>
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 2.5rem;
    max-width: 52ch;
  }


  /* Baris lebar bernomor — bukan grid kartu identik (RHYTHM 3). */
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  /* Kaca hanya saat hover/focus, bukan default. */
  .project-row:hover,
  .project-row:focus-visible {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    -webkit-backdrop-filter: blur(10px) saturate(150%);
    backdrop-filter: blur(10px) saturate(150%);
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 0.55),
      inset 0 -1px 0 rgba(255, 255, 255, 0.08),
      0 10px 30px rgba(0, 0, 0, 0.32);
    outline: none;
  }

  .project-no {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-amber);
    padding-top: 0.25rem;
    letter-spacing: 0.05em;
  }

  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .project-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .project-role {
    font-size: 0.88rem; /* 0.82rem = 13px, di bawah batas baca meta */
    color: var(--color-muted);
  }

  .project-desc {
    margin: 0.6rem 0 1rem;
    color: var(--color-muted);
    line-height: 1.55;
    font-size: 0.95rem;
    max-width: 62ch;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-link {
    font-size: 0.88rem;
    color: var(--color-amber);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .project-no {
      padding-top: 0;
    }

    /* Judul dan kategori tidak berdampingan di layar sempit */
    .project-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }

    /* Footer kartu: tag di atas, link live di bawah */
    .project-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    /* Seluruh kartu sudah berupa <a>, jadi ini cuma affordance;
       padding dibuat cukup agar target sentuh ≥44px di tepi kartu */
    .project-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0.5rem 0;
    }
  }
</style>
