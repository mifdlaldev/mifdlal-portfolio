---
import { projects } from '../data/site'
import CodeComment from './CodeComment.astro'
---

<section id="proyek" class="section">
  <CodeComment text="// proyek" />
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 03 · proyek</span>
      <h2 class="section-headline">Hasil kerja yang dapat Anda periksa sendiri.</h2>
    </div>

    <ul class="project-list">
      {projects.map((p) => (
        <li class="project-card">
          <a
            href={p.live}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
          >
            <div class="project-body">
              <div class="project-top">
                <span class="project-no">{p.no}</span>
                <span class="project-role">{p.role}</span>
              </div>

              <h3 class="project-name">{p.name}</h3>
              <p class="project-desc">{p.description}</p>

              <div class="project-foot">
                <span class="project-stack">{p.stack.join(' · ')}</span>
                <span class="project-cta">
                  live<span class="arrow" aria-hidden="true">↗</span>
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 2.5rem;
    max-width: 56ch;
  }

  /* Bentuk kartu mengikuti section layanan: kotak bergaris, pita aksen di tepi
     atas, dan blok warna yang mengisi seluruh badan kartu. Bedanya, kartu
     proyek tidak punya area gambar karena setiap entri di sini adalah tautan
     hidup, bukan ilustrasi. */
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    border: 1px solid var(--color-line);
    border-top: 2px solid var(--accent, var(--color-line));
    background: var(--color-paper);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--color-ink) 34%, transparent);
    border-top-color: var(--accent, var(--color-line));
  }

  /* Tautan mengisi kartu, jadi seluruh bidang warna dapat diklik. */
  .project-link {
    display: flex;
    flex: 1 1 auto;
    text-decoration: none;
    color: inherit;
  }

  /* Nomor, peran, nama, keterangan, lalu kaki kartu yang menempel di dasar
     supaya kartu sebaris tetap rata bawah meski panjang teksnya berbeda. */
  .project-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.25rem 1.5rem;
    background: var(--accent, transparent);
  }

  .project-link:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: calc(-1 * 0.5rem);
  }

  .project-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  /* Nomor memakai lemon yang dicampur putih: pada hijau tua lemon murni hanya
     mencapai kontras 4,48, campuran 82 persen menaikkannya ke 4,63. */
  .project-no {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps-loose);
    color: color-mix(in srgb, var(--color-lemon) 82%, var(--color-white));
  }

  .project-role {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: lowercase;
    text-align: right;
    color: color-mix(in srgb, var(--color-paper) 90%, transparent);
  }

  .project-name {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-title);
    color: var(--color-paper);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .project-desc {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: color-mix(in srgb, var(--color-paper) 90%, transparent);
  }

  /* Kaki kartu didorong ke dasar; kartu dengan teks pendek tetap rata. */
  .project-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .project-stack {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: color-mix(in srgb, var(--color-paper) 90%, transparent);
  }

  .project-cta {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps-tight);
    text-transform: lowercase;
    color: var(--color-paper);
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    white-space: nowrap;
  }

  .arrow {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease);
  }

  .project-link:hover .arrow,
  .project-link:focus-visible .arrow {
    transform: translate(0.1rem, -0.1rem);
  }

  @media (min-width: 720px) {
    .project-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .project-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .arrow {
      transition: none;
    }
  }
</style>
