---
import { projects } from '../data/site'
import CodeComment from './CodeComment.astro'

/* Gambar asli: proyek dengan field `image` memakai tangkapan layar asli
   di public/projects/. Proyek lain tetap memakai placeholder SVG bernomor. */
const thumb = (no: string) => `/projects/proj-${no}.svg`
---

<section id="proyek" class="section">
  <CodeComment text="// proyek" />
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 03 · proyek</span>
      <h2 class="section-headline">Hasil kerja yang dapat anda lihat.</h2>
    </div>

    <ul class="project-list">
      {projects.map((p) => (
        <li class="project-card">
          <a
            href={p.live}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
            aria-label={`Buka ${p.name} di tab baru`}
          >
            <span class="project-shot">
              {p.image ? (
                <>
                  {/* Latar parallax: versi buram dari mockup browser yang
                      sama, bergerak mengikuti scroll — pola .service-photo-clip
                      di canvas layanan. */}
                  <span class="project-photo-clip" aria-hidden="true">
                    <span
                      class="project-photo"
                      style={`background-image: url('${p.image}')`}
                    ></span>
                  </span>

                  {/* Foto utama: TETAP di tengah, tidak bergerak, tidak
                      di-crop. object-fit contain + margin auto. */}
                  <img
                    class="project-shot-img"
                    src={p.image}
                    width="1000"
                    height="563"
                    alt=""
                    draggable="false"
                    loading="lazy"
                    decoding="async"
                  />

                  {/* Penanda sudut gambar teknik — empat L-bracket tipis,
                      sama dengan sudut frame canvas layanan. */}
                  <span class="project-corner project-corner--tl" aria-hidden="true"></span>
                  <span class="project-corner project-corner--tr" aria-hidden="true"></span>
                  <span class="project-corner project-corner--bl" aria-hidden="true"></span>
                  <span class="project-corner project-corner--br" aria-hidden="true"></span>
                </>
              ) : (
                <img
                  src={thumb(p.no)}
                  width="1600"
                  height="1000"
                  alt=""
                  draggable="false"
                  loading="lazy"
                  decoding="async"
                />
              )}

              <span class="project-no" aria-hidden="true">{p.no}</span>
            </span>

            <span class="project-body">
              <span class="project-role">{p.role}</span>
              <span class="project-name">{p.name}</span>
              <span class="project-desc">{p.description}</span>

              <span class="project-foot">
                <span class="project-stack">{p.stack.join(' · ')}</span>
                <span class="project-live">
                  live<span class="project-arrow" aria-hidden="true">↗</span>
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 2.5rem;
    max-width: 56ch;
  }

  /* Bentuk kartu mengikuti kartu sertifikasi: gambar di atas, keterangan di
     bawah, garis tipis sebagai satu-satunya pembatas. Bedanya, seluruh kartu
     adalah satu tautan hidup ke hasil kerja, jadi tidak ada dialog. */
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    transition:
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .project-card:hover {
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }

  .project-link {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .project-link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  /* --- gambar --------------------------------------------- */

  .project-shot {
    position: relative;
    display: block;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-line-soft);
    aspect-ratio: 16 / 10;
    transition: border-color var(--dur-fast) var(--ease);
  }

  /* Placeholder (SVG) memenuhi seluruh shot. Foto asli (.project-shot-img)
     punya aturan sendiri di bawah — dikecualikan di sini karena contain. */
  .project-shot > img:not(.project-shot-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 600ms var(--ease);
  }

  /* Garis bawah gambar menjadi aksen saat kartu disorot: penanda halus bahwa
     gambar itu milik tautan, tanpa menambah elemen baru. */
  .project-card:hover .project-shot {
    border-bottom-color: var(--accent);
  }

  /* --- foto parallax (kartu dengan field `image`) --------- */

  .project-photo-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
    /* Panggung warna: mockup sumbernya transparan, jadi latar butuh
       dasar sendiri. Gradien biru elektrik -> ink, senada canvas. */
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--electric) 60%, var(--ink-900)) 0%,
      var(--ink-900) 72%
    );
  }

  /* Foto latar parallax: versi buram dari mockup browser yang sama.
     Blur 16px + scale 1.12 (menutupi tepi blur), saturasi/contrast
     diturunkan — sekarang ini cuma cahaya lembut di belakang jendela.
     Tinggi 140%, tepi atas -20%: cadangan pergeseran ±20% tinggi frame. */
  .project-photo {
    position: absolute;
    top: -20%;
    left: 0;
    right: 0;
    height: 140%;
    background-color: var(--ink-900);
    background-size: cover;
    background-position: top center;
    filter: blur(16px) saturate(0.7) contrast(1.05) brightness(0.85);
    transform: translate3d(0, var(--parallax, 0px), 0) scale(1.12);
    will-change: transform;
  }

  /* Overlay biru elektrik — 0.55 karena latar buram boleh lebih pekat
     tanpa menghilangkan identitas situs (foto asli ada di depannya). */
  .project-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--electric);
    opacity: 0.55;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* Gradien bawah: judul + badge tetap terbaca di atas foto ramai. */
  .project-photo-clip::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 45%,
      color-mix(in srgb, var(--ink-900) 45%, transparent)
    );
    pointer-events: none;
    z-index: var(--z-content);
  }

  /* Penanda sudut gambar teknik — empat L-bracket tipis, sama dengan
     sudut frame canvas layanan. */
  .project-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid color-mix(in srgb, var(--paper) 70%, transparent);
    pointer-events: none;
    z-index: var(--z-corner);
  }

  .project-corner--tl {
    top: 8px;
    left: 8px;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
  }

  .project-corner--tr {
    top: 8px;
    right: 8px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
  }

  .project-corner--bl {
    bottom: 8px;
    left: 8px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
  }

  .project-corner--br {
    bottom: 8px;
    right: 8px;
    border-bottom-width: 1.5px;
    border-right-width: 1.5px;
  }

  /* Foto utama: TETAP di tengah, fixed, tidak di-crop. Contain penuh
     dengan padding 1.25rem, bingkai tipis + bayangan lembut — terbaca
     sebagai jendela situs mengambang di atas latar parallax. */
  .project-shot-img {
    position: absolute;
    inset: 0;
    margin: auto;
    width: auto;
    height: auto;
    max-width: calc(100% - 2.5rem);
    max-height: calc(100% - 2.5rem);
    object-fit: contain;
    z-index: var(--z-raise);
    /* Tanpa isian latar: mockup transparan, area kosong di sekitar
       jendela browser menunjukkan latar parallax buram di belakang. */
    border: 1px solid color-mix(in srgb, var(--paper) 60%, transparent);
    box-shadow:
      0 2px 8px color-mix(in srgb, var(--ink-900) 35%, transparent),
      0 12px 32px color-mix(in srgb, var(--ink-900) 25%, transparent);
    transition: box-shadow var(--dur-fast) var(--ease);
  }

  /* Kartu disorot: bayangan foto mengambang menipis. */
  .project-card:hover .project-shot-img {
    box-shadow:
      0 4px 12px color-mix(in srgb, var(--ink-900) 40%, transparent),
      0 18px 44px color-mix(in srgb, var(--ink-900) 30%, transparent);
  }

  /* Nomor menempel di atas gambar seperti pelat nomor pada gambar teknik:
     bidang aksen penuh, satu-satunya bidang berwarna di kartu. */
  .project-no {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    padding: 0.15rem 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    color: var(--color-paper);
    background: var(--accent);
    border: 1px solid var(--accent);
    z-index: var(--z-tooltip);
  }

  @media (hover: hover) {
    .project-link:hover .project-shot > img:not(.project-shot-img) {
      transform: scale(1.025);
    }
  }

  /* --- keterangan ----------------------------------------- */

  .project-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.2rem 1.25rem;
  }

  .project-role {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
  }

  .project-name {
    font-family: var(--font-display);
    font-size: var(--text-title-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-title);
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .project-desc {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* Kaki kartu didorong ke dasar supaya kartu sebaris rata bawah meski
     panjang keterangannya berbeda. */
  .project-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-line-soft);
  }

  .project-stack {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    color: var(--color-muted);
  }

  .project-live {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .project-arrow {
    display: inline-block;
    margin-left: 0.2rem;
    transition: transform var(--dur-fast) var(--ease);
  }

  .project-link:hover .project-arrow,
  .project-link:focus-visible .project-arrow {
    transform: translate(0.12rem, -0.12rem);
  }

  @media (min-width: 720px) {
    .project-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .project-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-shot > img,
    .project-photo,
    .project-arrow {
      transition: none;
    }

    .project-card:hover {
      transform: none;
    }

    .project-link:hover .project-shot > img:not(.project-shot-img) {
      transform: none;
    }
  }
</style>

<script>
  /* Parallax foto kartu proyek — persis pola canvas layanan (Services.astro):
     foto 140% tinggi frame, tepi atas -20%, pergeseran ±20% tinggi frame saat
     scroll. Hanya berlaku untuk kartu dengan field `image` (memiliki
     .project-photo-clip). Dimatikan saat prefers-reduced-motion: reduce. */
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!reduceMotion.matches) {
    const clips = Array.from(document.querySelectorAll<HTMLElement>('.project-photo-clip'));
    const SHIFT_MAX = 0.2; // ±20% tinggi frame (pas dengan headroom foto 140%)
    const LERP = 1; // Lenis sudah me-smoothing scroll, tidak perlu lerp kedua
    const current = new Map<HTMLElement, number>();
    let running = false;

    const tick = () => {
      const vh = window.innerHeight;
      let animating = false;

      for (const clip of clips) {
        const rect = clip.getBoundingClientRect();
        const inView = rect.bottom > -vh * 0.2 && rect.top < vh * 1.2;
        if (!inView) continue;

        // p: 0 = frame baru masuk dari bawah, 1 = frame hampir keluar di atas
        const p = (vh - rect.top) / (vh + rect.height);
        // target: +20% (foto turun, masuk dari bawah) -> -20% (foto naik penuh)
        const target = (SHIFT_MAX - p * 2 * SHIFT_MAX) * rect.height;
        const prev = current.get(clip) ?? target;
        const next = prev + (target - prev) * LERP;

        current.set(clip, next);
        clip.style.setProperty('--parallax', `${next.toFixed(1)}px`);

        if (Math.abs(target - next) > 0.5) animating = true;
      }

      if (animating) {
        window.requestAnimationFrame(tick);
      } else {
        running = false;
      }
    };

    const kick = () => {
      if (running) return;
      running = true;
      window.requestAnimationFrame(tick);
    };

    kick();

    // Kartu berganti jumlah kolom saat resize (1 -> 2 -> 3 kolom) —
    // rect berubah, jadi hitung ulang posisi.
    let rt: number;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(kick, 150);
    });
  }
</script>
