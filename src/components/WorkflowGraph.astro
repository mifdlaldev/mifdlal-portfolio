---
/**
 * WorkflowGraph — animasi alur kerja di atas foto layanan 03.
 *
 * Lapisan SVG transparan menumpuk di atas kanvas foto (tanpa veil, tanpa
 * background: foto tetap utuh). Tata letak memakai viewBox 100 x 62.5 dengan
 * kolom berjarak tetap sehingga tile, label, dan konektor tidak bertumpuk.
 *
 * Ikon memakai aset Simple Icons yang sama dengan logo loop (/logos/*.svg),
 * ukurannya ±28% sisi tile supaya kecil dan tidak mendominasi.
 *
 * Animasi CSS murni, loop 13 detik:
 *   0.0–1.3s  node muncul
 *   0.4–1.6s  konektor menggambar diri
 *   3.2–7.8s  pulsa menyusur jalur utama
 *   5.5–9.5s  cabang ke tool + pulsa turun
 *  11.2–13.0s  fade keluar, lalu ulang
 * Pause otomatis saat keluar viewport; prefers-reduced-motion → frame statis.
 */
---

<svg
  class="workflow-graph"
  data-workflow-graph
  viewBox="0 0 100 62.5"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
>
  <!-- Jalur pulsa (tidak terlihat). -->
  <path
    id="wf-spine"
    class="wf-spine-path"
    d="M16 24.5 L21 24.5 L34 24.5 L39 23.5 L58 23.5 L63 24.5 L76 24.5 L81 24.5"
    fill="none"
  />
  <path id="wf-b1" class="wf-spine-path" d="M44 31 C44 38 36 39 36 46" fill="none" />
  <path id="wf-b2" class="wf-spine-path" d="M48.5 31 C48.5 38 53 39 53 46" fill="none" />
  <path id="wf-b3" class="wf-spine-path" d="M53 31 C53 38 70 39 70 46" fill="none" />

  <!-- Konektor jalur utama. -->
  <g class="wf-conn">
    <path class="wf-conn-line" pathLength="1" d="M16 24.5 L21 24.5" />
    <path class="wf-conn-line" pathLength="1" d="M34 24.5 L39 23.5" />
    <path class="wf-conn-line" pathLength="1" d="M58 23.5 L63 24.5" />
    <path class="wf-conn-line" pathLength="1" d="M76 24.5 L81 24.5" />
  </g>

  <!-- Cabang ke tool. -->
  <g class="wf-branch">
    <path class="wf-branch-line" pathLength="1" d="M44 31 C44 38 36 39 36 46" />
    <path class="wf-branch-line" pathLength="1" d="M48.5 31 C48.5 38 53 39 53 46" />
    <path class="wf-branch-line" pathLength="1" d="M53 31 C53 38 70 39 70 46" />
  </g>

  <!-- Port penghubung. -->
  <g class="wf-ports">
    <circle cx="16" cy="24.5" r="0.45" />
    <circle cx="21" cy="24.5" r="0.45" />
    <circle cx="34" cy="24.5" r="0.45" />
    <circle cx="39" cy="23.5" r="0.45" />
    <circle cx="58" cy="23.5" r="0.45" />
    <circle cx="63" cy="24.5" r="0.45" />
    <circle cx="76" cy="24.5" r="0.45" />
    <circle cx="81" cy="24.5" r="0.45" />
    <circle cx="44" cy="31" r="0.45" />
    <circle cx="48.5" cy="31" r="0.45" />
    <circle cx="53" cy="31" r="0.45" />
  </g>

  <!-- Node jalur utama. -->
  <g class="wf-node wf-n1">
    <rect class="wf-tile" x="3" y="18" width="13" height="13" rx="2.4" />
    <image href="/logos/telegram.svg" x="7.7" y="21.2" width="3.6" height="3.6" />
    <text class="wf-label" x="9.5" y="34.6" font-size="1.72" font-weight="600" letter-spacing="0.06">TRIGGER</text>
  </g>

  <g class="wf-node wf-n2">
    <rect class="wf-tile" x="21" y="18" width="13" height="13" rx="2.4" />
    <image href="/logos/postgresql.svg" x="25.7" y="21.2" width="3.6" height="3.6" />
    <text class="wf-label" x="27.5" y="34.6" font-size="1.72" font-weight="600" letter-spacing="0.06">KOLEKSI</text>
  </g>

  <!-- Hub: satu-satunya kartu ber-border aksen, fokus diagram. -->
  <g class="wf-node wf-hub">
    <rect class="wf-hub-tile" x="39" y="16" width="19" height="15" rx="2.6" />
    <image href="/logos/hermes.svg" x="41.6" y="21.1" width="4.6" height="4.6" />
    <text class="wf-hub-title" x="47.6" y="23.3" font-size="1.9" font-weight="700" letter-spacing="0.04" text-anchor="start">AI AGENT</text>
    <text class="wf-hub-sub" x="47.6" y="26.2" font-size="1.42" font-weight="500" letter-spacing="0.03" text-anchor="start">orkestrasi tool</text>
  </g>

  <g class="wf-node wf-n4">
    <rect class="wf-tile" x="63" y="18" width="13" height="13" rx="2.4" />
    <image href="/logos/redis.svg" x="67.7" y="21.2" width="3.6" height="3.6" />
    <text class="wf-label" x="69.5" y="34.6" font-size="1.72" font-weight="600" letter-spacing="0.06">VALIDASI</text>
  </g>

  <g class="wf-node wf-n5">
    <rect class="wf-tile" x="81" y="18" width="13" height="13" rx="2.4" />
    <image href="/logos/telegram.svg" x="85.7" y="21.2" width="3.6" height="3.6" />
    <text class="wf-label" x="87.5" y="34.6" font-size="1.72" font-weight="600" letter-spacing="0.06">KIRIM</text>
  </g>

  <!-- Tool di bawah hub. -->
  <g class="wf-tool wf-t1">
    <rect class="wf-tool-tile" x="29" y="46" width="14" height="10" rx="2" />
    <image href="/logos/openai.svg" x="34.4" y="48.9" width="3" height="3" />
    <text class="wf-tool-label" x="36" y="57.6" font-size="1.4" font-weight="600" letter-spacing="0.05">MODEL LLM</text>
  </g>

  <g class="wf-tool wf-t2">
    <rect class="wf-tool-tile" x="46" y="46" width="14" height="10" rx="2" />
    <image href="/logos/supabase.svg" x="51.4" y="48.9" width="3" height="3" />
    <text class="wf-tool-label" x="53" y="57.6" font-size="1.4" font-weight="600" letter-spacing="0.05">DOKUMEN</text>
  </g>

  <g class="wf-tool wf-t3">
    <rect class="wf-tool-tile" x="63" y="46" width="14" height="10" rx="2" />
    <image href="/logos/hono.svg" x="68.4" y="48.9" width="3" height="3" />
    <text class="wf-tool-label" x="70" y="57.6">API</text>
  </g>

  <!-- Pulsa: titik aksen yang berjalan. -->
  <g class="wf-pulses">
    <circle class="wf-pulse wf-pulse-spine" r="0.75" />
    <circle class="wf-pulse wf-pulse-b1" r="0.55" />
    <circle class="wf-pulse wf-pulse-b2" r="0.55" />
    <circle class="wf-pulse wf-pulse-b3" r="0.55" />
  </g>
</svg>

<style>
  /* Lapisan transparan di atas foto. Tidak ada fill latar: foto tetap utuh. */
  .workflow-graph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    animation: wf-scene 13s linear infinite;
    --wf-ink: var(--ink-900);
  }

  .wf-spine-path {
    stroke: none;
    fill: none;
  }

  /* Tile: solid kertas, garis rambut. Ikon kecil di tengah. */
  .wf-tile,
  .wf-tool-tile {
    fill: var(--paper);
    stroke: var(--wf-ink);
    stroke-opacity: 0.18;
    stroke-width: 0.12;
  }

  .wf-hub-tile {
    fill: var(--paper);
    stroke: var(--electric);
    stroke-width: 0.26;
  }

  .wf-label,
  .wf-tool-label,
  .wf-hub-title,
  .wf-hub-sub {
    font-family: var(--font-mono);
    fill: var(--wf-ink);
    text-anchor: middle;
  }

  .wf-label {
    fill-opacity: 0.72;
  }

  .wf-tool-label {
    fill-opacity: 0.62;
  }

  .wf-hub-sub {
    fill-opacity: 0.5;
  }

  .wf-conn-line,
  .wf-branch-line {
    fill: none;
    stroke: var(--wf-ink);
    stroke-linecap: round;
  }

  .wf-conn-line {
    stroke-width: 0.14;
    stroke-opacity: 0.45;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: wf-draw-conn 13s linear infinite;
  }

  .wf-branch-line {
    stroke-width: 0.12;
    stroke-opacity: 0.34;
    stroke-dasharray: 0.035 0.045;
    animation: wf-draw-branch 13s linear infinite;
  }

  .wf-ports circle {
    fill: var(--wf-ink);
    fill-opacity: 0.3;
  }

  /* Node: fade + naik halus, bertahap menurut kolom. */
  .wf-node,
  .wf-tool {
    animation: 13s linear infinite;
  }

  .wf-n1 { animation-name: wf-in-a; }
  .wf-n2 { animation-name: wf-in-b; }
  .wf-hub { animation-name: wf-in-c; }
  .wf-n4 { animation-name: wf-in-d; }
  .wf-n5 { animation-name: wf-in-e; }

  .wf-tool { animation-name: wf-in-tool; }
  .wf-t1 { animation-delay: 0s; }
  .wf-t2 { animation-delay: 0.12s; }
  .wf-t3 { animation-delay: 0.24s; }

  /* Pulsa menyusur jalur. */
  .wf-pulse {
    fill: var(--electric);
    opacity: 0;
  }

  .wf-pulse-spine {
    offset-path: path("M16 24.5 L21 24.5 L34 24.5 L39 23.5 L58 23.5 L63 24.5 L76 24.5 L81 24.5");
    offset-rotate: 0deg;
    animation: wf-pulse-main 13s linear infinite;
  }

  .wf-pulse-b1 {
    offset-path: path("M44 31 C44 38 36 39 36 46");
    animation: wf-pulse-branch 13s linear infinite;
  }

  .wf-pulse-b2 {
    offset-path: path("M48.5 31 C48.5 38 53 39 53 46");
    animation: wf-pulse-branch 13s linear infinite;
  }

  .wf-pulse-b3 {
    offset-path: path("M53 31 C53 38 70 39 70 46");
    animation: wf-pulse-branch 13s linear infinite;
  }

  /* ---- Keyframes: satu timeline 13s, loop mulus ---- */

  @keyframes wf-scene {
    0%, 86% { opacity: 1; }
    100% { opacity: 0.1; }
  }

  @keyframes wf-in-a {
    0% { opacity: 0; transform: translateY(0.8px); }
    4% { opacity: 1; transform: translateY(0); }
    86%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes wf-in-b {
    0%, 2% { opacity: 0; transform: translateY(0.8px); }
    6% { opacity: 1; transform: translateY(0); }
    86%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes wf-in-c {
    0%, 4% { opacity: 0; transform: translateY(0.8px); }
    8% { opacity: 1; transform: translateY(0); }
    86%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes wf-in-d {
    0%, 6% { opacity: 0; transform: translateY(0.8px); }
    10% { opacity: 1; transform: translateY(0); }
    86%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes wf-in-e {
    0%, 8% { opacity: 0; transform: translateY(0.8px); }
    12% { opacity: 1; transform: translateY(0); }
    86%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes wf-in-tool {
    0%, 40% { opacity: 0; transform: translateY(0.6px); }
    45% { opacity: 1; transform: translateY(0); }
    86%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes wf-draw-conn {
    0%, 3% { stroke-dashoffset: 1; }
    12%, 86% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 0; }
  }

  @keyframes wf-draw-branch {
    0%, 40% { stroke-dashoffset: 0.5; }
    50%, 86% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 0; }
  }

  @keyframes wf-pulse-main {
    0%, 22% { offset-distance: 0%; opacity: 0; }
    25% { opacity: 1; }
    58% { offset-distance: 100%; opacity: 1; }
    60%, 100% { offset-distance: 100%; opacity: 0; }
  }

  @keyframes wf-pulse-branch {
    0%, 50% { offset-distance: 0%; opacity: 0; }
    54% { opacity: 0.95; }
    66% { offset-distance: 100%; opacity: 0.95; }
    68%, 100% { offset-distance: 100%; opacity: 0; }
  }

  /* Pause saat keluar viewport (class dipasang skrip kecil di bawah). */
  :global(.workflow-graph.is-paused *),
  :global(.workflow-graph.is-paused) {
    animation-play-state: paused;
  }

  /* Reduced motion: frame statis penuh, tanpa denyut. */
  @media (prefers-reduced-motion: reduce) {
    .workflow-graph,
    .wf-node,
    .wf-tool,
    .wf-conn-line,
    .wf-branch-line,
    .wf-pulse {
      animation: none;
    }

    .wf-conn-line,
    .wf-branch-line {
      stroke-dashoffset: 0;
    }

    .wf-pulse {
      display: none;
    }
  }
</style>

<script>
  /* Pause animasi saat graf keluar viewport: hemat CPU, dan supaya siklus
     tidak berjalan di balik layar. */
  const graphs = document.querySelectorAll('[data-workflow-graph]');
  if (graphs.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => e.target.classList.toggle('is-paused', !e.isIntersecting));
    }, { threshold: 0.05 });
    graphs.forEach((g) => io.observe(g));
  }
</script>
