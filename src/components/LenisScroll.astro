---
// Lenis smooth scroll — satu instance untuk seluruh halaman.
// Dipasang di Layout.astro sebelum </body>.
//
// PERFORMA (riset 2026, lenis.dev + techpotions + aidxn):
// - Lenis itself ringan: ~2KB, cuma lerp math + scrollTo per frame.
//   Loop rAF yang terus berjalan BUKAN biang kerok — itu cara kerja
//   inertia-nya. Menghentikan loop = glide hilang = scroll biasa.
// - autoRaf: true -> Lenis mengelola loop sendiri, no race condition,
//   no manual start/stop yang bisa memotong inertia di tengah jalan.
// - syncTouch: false -> touch pakai geser native (default Lenis 1.x;
//   opsi lama `smoothTouch` sudah dihapus dari API sejak 1.1).
// - pointer: coarse -> smoothWheel off, karena touch sudah punya
//   momentum native; menambahkan smoothing di touch justru membuat
//   scroll terasa berat di perangkat low-end.
// - prefers-reduced-motion -> lerp 1 (native scroll, no smoothing).
// - Biang kerok frame drop sebenarnya: kerja main thread SAAT scroll
//   (WebGL wordmark, reveal.js transform writes, content-visibility
//   layout burst). Lenis bukan tersangka — dia cuma ~1-2% CPU.
---
<script>
  import Lenis from 'lenis';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarsePointer = window.matchMedia('(pointer: coarse)').matches;

  const lenis = new Lenis({
    anchors: true, // anchor link tetap berfungsi; default Lenis mematikannya
    lerp: reduceMotion ? 1 : 0.1, // 0.1 = responsif tapi tetap halus
    smoothWheel: !reduceMotion && !coarsePointer,
    syncTouch: false,
    infinite: false,
    autoRaf: true, // Lenis manages its own rAF loop — inertia intact
  });

  // Dipakai to-top.js dan komponen lain yang perlu scroll programatik.
  (window as unknown as { __lenis?: Lenis }).__lenis = lenis;

  /* Hentikan Lenis saat tab tidak terlihat — hemat battery + CPU.
     Lenos.stop()/start() menghentikan loop internal dengan benar,
     tanpa memotong inertia yang sedang berjalan. */
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) lenis.stop();
    else lenis.start();
  });
</script>

<style is:global>
  /* Matikan CSS smooth bawaan global.css saat Lenis aktif: dua lapis
     smoothing (CSS + JS) membuat scroll terasa patah. */
  html.lenis,
  html.lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }

  /* Lenis menandai halaman tidak scrollable (mis. dialog terbuka). */
  html.lenis.lenis-stopped {
    overflow: hidden;
  }

  /* Container scroll internal yang dikecualikan dari intercept Lenis. */
  [data-lenis-prevent] {
    overscroll-behavior: contain;
  }
</style>
