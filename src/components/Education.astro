---
import { education } from '../data/site'
import CodeComment from './CodeComment.astro'
---

<section id="pendidikan" class="section">
  <CodeComment text="// pendidikan" />
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 06 · pendidikan</span>
      <h2 class="section-headline">Pendidikan formal.</h2>
    </div>

    <ul class="edu-list" aria-hidden={education.length === 0 ? 'true' : undefined}>
      {education.length === 0 ? (
        <li class="edu-row">
          <span class="edu-no">01</span>
          <div class="edu-main">
            <span class="edu-title ph ph--title"></span>
            <p class="edu-program"><span class="ph ph--sub"></span></p>
          </div>
          <p class="edu-meta"><span class="ph ph--meta"></span></p>
        </li>
      ) : (
        education.map((e) => (
          <li class="edu-row">
            <span class="edu-no">{e.no}</span>
            <div class="edu-main">
              <h3 class="edu-title">{e.institution}</h3>
              <p class="edu-program">
                {e.program}
                <span class="edu-status badge">{e.status}</span>
              </p>
              {e.note && <p class="edu-note">{e.note}</p>}
            </div>
            <p class="edu-meta">
              <span>{e.period}</span>
              <span>{e.location}</span>
            </p>
          </li>
        ))
      )}
    </ul>

    {education.length === 0 && (
      <>
        <p class="empty-note">Belum diisi</p>
        <p class="sr-only">Bagian pendidikan belum diisi.</p>
      </>
    )}
  </div>
</section>

<style>

  .section-head {
    margin-bottom: 2.5rem;
    max-width: 56ch;
  }

  .edu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .edu-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.35rem 1.25rem;
    padding: 1.75rem 0.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .edu-no {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--accent, var(--color-electric));
    padding-top: 0.3rem;
  }

  .edu-title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    margin: 0 0 0.3rem;
  }

  .edu-program {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-body);
  }

  /* Warna dan bentuk dari .badge di global.css; di sini hanya jarak. */
  .edu-status {
    margin-left: 0.4rem;
  }

  .edu-note {
    margin: 0.6rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    /* Sama seperti poin di section pengalaman: tanpa batas lebar, tepi kanan
       berhenti di kolom periode/lokasi, bukan menyisakan ruang kosong. */
    max-width: none;
  }

  .edu-meta {
    margin: 0.5rem 0 0;
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-muted);
    text-transform: none;
  }

  @media (min-width: 860px) {
    .edu-row {
      grid-template-columns: 3rem 1fr auto;
      align-items: baseline;
    }
    .edu-meta {
      margin: 0;
      flex-direction: column;
      text-align: right;
      gap: 0.25rem;
    }
  }
</style>
