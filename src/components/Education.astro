---
import { education } from '../data/site'
import CodeComment from './CodeComment.astro'
---

<section id="pendidikan" class="section">
  <CodeComment text="// pendidikan" textEn="// education" />
  <div class="wrap">
    <div class="section-head rise">
      <span class="fig-label" data-i18n-id="fig. 06 · pendidikan">
        fig. 06 · education
      </span>
      <h2 class="section-headline" data-i18n-id="Pendidikan formal.">
        Formal education.
      </h2>
    </div>

    <ul class="edu-list" aria-hidden={education.length === 0 ? 'true' : undefined}>
      {education.length === 0 ? (
        <li class="edu-row">
          <div class="edu-main">
            <span class="edu-title ph ph--title"></span>
            <p class="edu-program">
              <span class="ph ph--sub"></span>
            </p>
          </div>
          <p class="edu-meta">
            <span class="ph ph--meta"></span>
          </p>
        </li>
      ) : (
        education.map((e) => (
          <li class="edu-row rise" data-rise="left">
            <div class="edu-main">
              <h3 class="edu-title" data-i18n-id={e.institution}>
                {e.institutionEn}
              </h3>
              <p class="edu-program">
                <span data-i18n-id={e.program}>{e.programEn}</span>
                <span class="edu-status badge" data-i18n-id={e.status}>
                  {e.statusEn}
                </span>
              </p>
              {e.note && (
                <p class="edu-note" data-i18n-id={e.note}>
                  {e.noteEn}
                </p>
              )}
            </div>
            <p class="edu-meta">
              <span>{e.period}</span>
              <span>{e.location}</span>
            </p>
          </li>
        ))
      )}
    </ul>

    {education.length === 0 && (
      <>
        <p class="empty-note" data-i18n-id="Belum diisi">
          Not filled in yet.
        </p>
        <p class="sr-only" data-i18n-id="Bagian pendidikan belum diisi.">
          The education section has not been filled in yet.
        </p>
      </>
    )}
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 2.5rem;
    max-width: 56ch;
  }

  .edu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .edu-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    padding: 1.75rem 0.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .edu-title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    margin: 0 0 0.3rem;
  }

  .edu-program {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-body);
  }

  /* Warna dan bentuk dari .badge di global.css; di sini hanya jarak. */
  .edu-status {
    margin-left: 0.4rem;
  }

  .edu-note {
    margin: 0.6rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    /* Sama seperti poin di section pengalaman: tanpa batas lebar, tepi kanan
       berhenti di kolom periode/lokasi, bukan menyisakan ruang kosong. */
    max-width: none;
  }

  .edu-meta {
    margin: 0.5rem 0 0;
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-muted);
    text-transform: none;
  }

  @media (min-width: 860px) {
    .edu-row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
    }
    .edu-meta {
      margin: 0;
      flex-direction: column;
      text-align: right;
      gap: 0.25rem;
    }
  }
</style>
