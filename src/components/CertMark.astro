---
/* Tanda kepemilikan di atas gambar sertifikat.
 *
 * Satu lapis teks berulang dengan sudut miring, sangat rendah kontras, supaya
 * hasil tangkapan layar tetap terbaca asalnya tanpa menutupi isi sertifikat.
 * Sudut pelat dipakai lebih dulu, tetapi pada tiga penerbit yang berbeda
 * pelat itu selalu menimpa sesuatu: nomor kredensial di kiri bawah, pita
 * kompetensi di kanan atas, dan kode QR di kanan bawah. Karena itu tanda
 * disebar, bukan ditempel di satu sudut.
 *
 * SVG sebaris, bukan berkas: tidak ada permintaan jaringan, tidak ada data URI
 * yang perlu dilonggarkan di CSP.
 */
interface Props {
  id: string
}

const { id } = Astro.props
---

<svg
  class="cert-mark"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
  viewBox="0 0 400 300"
>
  <defs>
    <pattern
      id={`cert-mark-${id}`}
      width="196"
      height="132"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(-26)"
    >
      <text x="4" y="56" class="cert-mark-text">mifdlal.com</text>
      <text x="102" y="122" class="cert-mark-text">mifdlal.com</text>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#cert-mark-${id})`} />
</svg>

<style>
  .cert-mark {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }

  .cert-mark-text {
    font-family: var(--font-mono);
    font-size: calc(var(--text-cap) * 1.1);
    letter-spacing: var(--tracking-caps);
    fill: var(--ink-900);
    fill-opacity: 0.085;
  }
</style>
