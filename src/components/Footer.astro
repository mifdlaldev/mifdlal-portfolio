---
const sections = [
  { href: '#tentang', label: 'Tentang', en: 'About' },
  { href: '#proyek', label: 'Proyek', en: 'Work' },
  { href: '#layanan', label: 'Layanan', en: 'Services' },
  { href: '#pengalaman', label: 'Pengalaman', en: 'Experience' },
  { href: '#pendidikan', label: 'Pendidikan', en: 'Education' },
  { href: '#sertifikasi', label: 'Sertifikasi', en: 'Certifications' },
  { href: '#kontak', label: 'Kontak', en: 'Contact' },
]

/* Path-aware: di beranda tautan section = anchor murni ("#proyek").
   Di rute dalam (mis. /proyek/) anchor di-prefix "/" supaya benar-benar
   membawa kembali ke beranda. Ditambah dua tautan rute indeks supaya
   setiap halaman punya jalur internal ke struktur multi-rute. */
const isHome = Astro.url.pathname === '/'
const base = isHome ? '' : '/'
const pageLinks = [
  { href: '/proyek/', label: 'Semua proyek', en: 'All projects' },
  { href: '/layanan/', label: 'Semua layanan', en: 'All services' },
]
---

<footer class="footer">
  <div class="wrap footer-inner rise">
    <nav class="footer-nav" aria-label="Navigasi halaman" data-i18n-aria="Page navigation">
      {sections.map((s) => (
        <a href={`${base}${s.href}`} data-i18n-en={s.en}>
          {s.label}
        </a>
      ))}
      {pageLinks.map((s) => (
        <a href={s.href} data-i18n-en={s.en}>
          {s.label}
        </a>
      ))}
    </nav>

    <div class="footer-controls">
      {/* Tema: segmented 3 slot — Sistem / Terang / Gelap */}
      <div class="theme-seg" data-theme-seg role="group" aria-label="Tema" data-i18n-aria="Theme">
        <button
          type="button"
          data-theme-value="system"
          aria-pressed="false"
          aria-label="Tema sistem"
          data-i18n-aria="System theme"
        >
          <svg
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="12" rx="1.5" />
            <path d="M8 20h8M12 16v4" />
          </svg>
        </button>
        <button
          type="button"
          data-theme-value="light"
          aria-pressed="false"
          aria-label="Tema terang"
          data-i18n-aria="Light theme"
        >
          <svg
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
          </svg>
        </button>
        <button
          type="button"
          data-theme-value="dark"
          aria-pressed="false"
          aria-label="Tema gelap"
          data-i18n-aria="Dark theme"
        >
          <svg
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
        </button>
      </div>

      {/* Bahasa: dropdown globe + label + chevron */}
      <div class="lang-select">
        <button
          type="button"
          class="lang-trigger"
          data-lang-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label="Pilih bahasa"
          data-i18n-aria="Choose language"
        >
          <svg
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.6 3.8 5.8 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.8-3.8-9S9.5 5.6 12 3z" />
          </svg>
          <span data-lang-label>Bahasa</span>
          <svg
            class="lang-chev"
            viewBox="0 0 24 24"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6" />
          </svg>
        </button>
        <ul class="lang-menu" role="listbox" hidden>
          <li role="option">
            <button type="button" data-lang-value="id" aria-pressed="true">
              <span>Bahasa Indonesia</span>
              <svg
                class="lang-check"
                viewBox="0 0 24 24"
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12l5 5L20 7" />
              </svg>
            </button>
          </li>
          <li role="option">
            <button type="button" data-lang-value="en" aria-pressed="false">
              <span>English</span>
              <svg
                class="lang-check"
                viewBox="0 0 24 24"
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12l5 5L20 7" />
              </svg>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-block: 1.5rem;
    background-color: var(--color-white);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: center;
  }

  /* Link footer: font style/size sama seperti .nav-link navbar (mono
     kecil, weight 500, tracking caps-tight, warna muted, garis bawah
     animasi) tetapi teks tetap Title Case (Tentang, Proyek), bukan
     dipaksa uppercase seperti navbar. */
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    order: 1;
    justify-self: start;
  }

  .footer-nav a {
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    font-weight: 500;
    letter-spacing: var(--tracking-caps-tight);
    text-transform: none;
    color: var(--color-muted);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    position: relative;
    transition: color var(--dur-fast) var(--ease);
  }

  /* Garis bawah animasi: tumbuh dari tengah, sama seperti .nav-link. */
  .footer-nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(50% + 0.7em);
    width: 0;
    height: 2px;
    background: currentColor;
    transform: translateX(-50%);
    transition: width var(--dur-base) var(--ease);
    pointer-events: none;
  }

  .footer-nav a:hover {
    color: var(--color-ink);
  }

  .footer-nav a:hover::after,
  .footer-nav a:focus-visible::after {
    width: 100%;
  }

  /* ---- kontrol tema + bahasa ---- */
  .footer-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    order: 2;
  }

  /* Segmented control tema: 3 slot icon, slot aktif diberi latar garis. */
  .theme-seg {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-paper);
  }

  .theme-seg button {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  .theme-seg button:hover {
    color: var(--color-ink);
  }

  .theme-seg button.is-active {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* Dropdown bahasa */
  .lang-select {
    position: relative;
    display: inline-block;
  }

  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 36px;
    padding: 0 0.6rem 0 0.55rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps-tight);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .lang-trigger:hover {
    border-color: var(--color-line);
    color: var(--color-ink);
  }

  .lang-trigger .lang-chev {
    transition: transform var(--dur-fast) var(--ease);
    color: var(--color-muted);
  }

  .lang-select[data-open] .lang-chev {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    bottom: calc(100% + 6px);
    right: 0;
    min-width: 11rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-white);
    box-shadow: 0 8px 24px var(--ink-07);
    z-index: var(--z-nav);
  }

  .lang-menu[hidden] {
    display: none;
  }

  .lang-menu button {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.65rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-align: left;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease);
  }

  .lang-menu button:hover {
    background: var(--color-paper);
  }

  .lang-menu button[aria-pressed='true'] {
    color: var(--color-electric);
  }

  .lang-check {
    opacity: 0;
    color: var(--color-electric);
  }

  .lang-menu button[aria-pressed='true'] .lang-check {
    opacity: 1;
  }

  @media (min-width: 900px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2rem;
    }

    .footer-nav {
      order: 1;
    }

    .footer-controls {
      order: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-chev,
    .theme-seg button,
    .lang-trigger,
    .lang-menu button {
      transition: none;
    }
  }
</style>

<script is:inline>
  ;(function () {
    var seg = document.querySelector('[data-theme-seg]')
    var langWrap = document.querySelector('.lang-select')
    var langTrigger = document.querySelector('[data-lang-trigger]')
    var langMenu = document.querySelector('.lang-menu')
    var langLabel = document.querySelector('[data-lang-label]')

    /* --- tema --- */
    if (seg) {
      seg.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-theme-value]')
        if (!btn) return
        var val = btn.getAttribute('data-theme-value')
        document.documentElement.setAttribute('data-theme', val)
        seg.querySelectorAll('button').forEach(function (b) {
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false')
          b.classList.toggle('is-active', b === btn)
        })
        try {
          localStorage.setItem(
            'mifdlal-prefs',
            JSON.stringify({
              theme: val,
              lang: (JSON.parse(localStorage.getItem('mifdlal-prefs') || '{}') || {}).lang || 'id',
            })
          )
        } catch (err) {}
      })
    }

    /* --- dropdown bahasa --- */
    if (langTrigger && langMenu) {
      function close() {
        langMenu.hidden = true
        langTrigger.setAttribute('aria-expanded', 'false')
        langWrap.removeAttribute('data-open')
      }
      langTrigger.addEventListener('click', function (e) {
        e.stopPropagation()
        var open = langMenu.hidden
        langMenu.hidden = !open
        langTrigger.setAttribute('aria-expanded', open ? 'true' : 'false')
        langWrap.toggleAttribute('data-open', open)
      })
      document.addEventListener('click', function (e) {
        if (!langWrap.contains(e.target)) close()
      })
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !langMenu.hidden) {
          close()
          langTrigger.focus()
        }
      })
      langMenu.querySelectorAll('button').forEach(function (opt) {
        opt.addEventListener('click', function () {
          var val = opt.getAttribute('data-lang-value')
          langMenu.querySelectorAll('button').forEach(function (b) {
            b.setAttribute('aria-pressed', b === opt ? 'true' : 'false')
          })
          langLabel.textContent = val === 'en' ? 'English' : 'Bahasa'
          close()
          /* Samakan state di dua listener: document (i18n.js) + window (CopyEmail island) */
          document.dispatchEvent(new CustomEvent('mifdlal:lang', { detail: val }))
          window.dispatchEvent(new CustomEvent('mifdlal:lang', { detail: val }))
        })
      })
    }
  })()
</script>
