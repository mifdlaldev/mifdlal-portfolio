---
const year = new Date().getFullYear()

/* Urut mengikuti urutan section di halaman, supaya klik tidak pernah melompat
   ke belakang. "stack" tidak dimasukkan: itu pita logo, tanpa judul. */
const sections = [
  { href: '#tentang', label: 'tentang' },
  { href: '#proyek', label: 'proyek' },
  { href: '#layanan', label: 'layanan' },
  { href: '#pengalaman', label: 'pengalaman' },
  { href: '#pendidikan', label: 'pendidikan' },
  { href: '#sertifikasi', label: 'sertifikasi' },
  { href: '#kontak', label: 'kontak' },
]
---

<footer class="footer">
  <div class="wrap footer-inner">
    <nav class="footer-nav" aria-label="Navigasi halaman">
      {sections.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>

    <p class="footer-copy">© {year} Mifdlal Tsaqib Alfarras</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-block: 1.75rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  /* Samakan dengan .nav-link di navbar: mono 0.75rem, tracking 0.04em, uppercase. */
  .footer-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-nav a:hover {
    color: var(--color-ink);
  }

  .footer-copy {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
    }

    .footer-copy {
      justify-self: end;
      text-align: right;
    }
  }
</style>
