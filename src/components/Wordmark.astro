---
/* Wordmark MIFDLAL — teks gradasi statis (tanpa WebGL).
   Versi sebelumnya pakai Aurora WebGL2 (shader + canvas) yang berat.
   Sekarang: teks biasa dengan background-clip gradient, animasi masuk
   (translateY + fade) tetap dipertahankan, tanpa rAF loop sama sekali. */
---

<section class="wordmark" aria-hidden="true">
  <span class="wordmark-text">MIFDLAL</span>
</section>

<style>
  .wordmark {
    --wm-pad-y: clamp(0.75rem, 2.4vw, 1.75rem);
    --wm-pad-x: clamp(1rem, 4vw, 3.5rem);

    position: relative;
    overflow: hidden;
    height: clamp(6rem, 24.5vw, 34rem);
    padding: var(--wm-pad-y) var(--wm-pad-x);
    border-top: 1px solid var(--color-line);
    background-color: var(--color-paper);
  }

  /* Dot grid pita: pola titik 26px, sama dengan section lain. */
  .wordmark::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle at 1px 1px,
      var(--color-line-soft) 1.2px,
      transparent 0
    );
    background-size: 26px 26px;
  }

  /* Teks wordmark: gradasi horizontal electric → cyan → green → lemon,
     sesuai palet situs. Pakai color langsung (bukan background-clip:text)
     karena kombinasi background-clip + scoped CSS Astro + inline style
     memberikan hasil computed opacity yang tidak akurat di beberapa browser. */
  .wordmark-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 21vw, 30rem);
    font-weight: 700;
    line-height: var(--leading-wordmark);
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
    /* Gradasi: electric (kiri) → cyan → green → lemon (kanan) */
    background: linear-gradient(
      90deg,
      var(--color-electric) 0%,
      color-mix(in srgb, var(--color-electric) 40%, #00d4d4) 30%,
      #00d4d4 45%,
      #2dd466 65%,
      var(--color-lemon) 100%
    );
    /* Simpel: gradasi di background section, teks transparan di atasnya.
       Elemen ::after memotong background menjadi bentuk tulisan. */
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    /* Animasi masuk: naik dari bawah + fade, identik dengan mode lama. */
    transform: translateY(18%);
    opacity: 0;
    transition:
      transform 1100ms cubic-bezier(0.16, 0.84, 0.24, 1),
      opacity 700ms var(--ease);
    will-change: transform, opacity;
  }

  .wordmark.is-in .wordmark-text,
  .wordmark.is-in {
    transform: none;
    opacity: 1;
  }

  /* Reduced motion: langsung tampil tanpa animasi. */
  @media (prefers-reduced-motion: reduce) {
    .wordmark-text {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }

  /* Mode reveal (dipasang /js/reveal.js): pita keluar dari alur dan menempel
     di dasar viewport. z-index TETAP di bawah page-layer (--z-below = -1):
     lapis atas yang opak menutup pita selama scroll biasa, lalu terangkat
     saat reveal. Wordmark menimpa semua section kalau z-index dinaikkan. */
  .wordmark.is-fixed {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-below);
    will-change: transform, opacity;
  }
</style>

<script>
  /* Tambah .is-in saat wordmark masuk viewport — menggantikan
     IntersectionObserver yang tadinya ada di wordmark.js (WebGL).
     rootMargin negatif bawah: wordmark kadim .is-fixed (position:fixed,
     z-index:-1) di dasar viewport, jadi observer dijalankan sebelum
     elemen benar-benar masuk viewport. Fallback 800ms: kalau observer
     lambat, .is-in tetap ditambahkan. */
  (() => {
    const band = document.querySelector('.wordmark');
    if (!band) return;
    if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) {
      band.classList.add('is-in');
      return;
    }
    const addIn = () => band.classList.add('is-in');
    const obs = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          addIn();
          obs.disconnect();
        }
      },
      { threshold: 0.05 }
    );
    obs.observe(band);
    setTimeout(addIn, 1200);
  })();
</script>
