---
import { experience } from '../data/site'
import CodeComment from './CodeComment.astro'
---

<section id="pengalaman" class="section">
  <CodeComment text="// pengalaman" />
  <div class="wrap">
    <div class="section-head">
      <span class="fig-label">fig. 05 · pengalaman</span>
      <h2 class="section-headline">Pengalaman.</h2>
    </div>

    <ul class="entry-list" aria-hidden={experience.length === 0 ? 'true' : undefined}>
      {experience.length === 0 ? (
        <>
          <li class="entry-row">
            <span class="entry-no">01</span>
            <div class="entry-main">
              <span class="entry-title ph ph--title"></span>
              <p class="entry-org"><span class="ph ph--sub"></span></p>
            </div>
            <p class="entry-meta"><span class="ph ph--meta"></span></p>
            <ul class="entry-points">
              <li><span class="ph ph--line"></span></li>
              <li><span class="ph ph--line ph--short"></span></li>
            </ul>
          </li>
          <li class="entry-row">
            <span class="entry-no">02</span>
            <div class="entry-main">
              <span class="entry-title ph ph--title"></span>
              <p class="entry-org"><span class="ph ph--sub"></span></p>
            </div>
            <p class="entry-meta"><span class="ph ph--meta"></span></p>
            <ul class="entry-points">
              <li><span class="ph ph--line"></span></li>
              <li><span class="ph ph--line ph--short"></span></li>
            </ul>
          </li>
        </>
      ) : (
        experience.map((e) => (
          <li class="entry-row">
            <span class="entry-no">{e.no}</span>
            <div class="entry-main">
              <h3 class="entry-title">{e.role}</h3>
              <p class="entry-org">
                {e.org} <span class="entry-kind">{e.kind}</span>
              </p>
            </div>
            <p class="entry-meta">
              <span>{e.period}</span>
              <span>{e.location}</span>
            </p>
            <ul class="entry-points">
              {e.points.map((pt) => <li>{pt}</li>)}
            </ul>
            {e.link && (
              <a class="entry-link" href={e.link} target="_blank" rel="noopener noreferrer">bukti ↗</a>
            )}
          </li>
        ))
      )}
    </ul>

    {experience.length === 0 && (
      <>
        <p class="empty-note">belum diisi</p>
        <p class="sr-only">Bagian pengalaman belum diisi.</p>
      </>
    )}
  </div>
</section>

<style>

  .section-head {
    margin-bottom: 2.5rem;
    max-width: 56ch;
  }

  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .entry-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.35rem 1.25rem;
    padding: 1.75rem 0.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .entry-no {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--accent, var(--color-electric));
    padding-top: 0.3rem;
    grid-row: 1 / span 3;
  }

  .entry-title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    margin: 0 0 0.3rem;
  }

  .entry-org {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-body);
  }

  .entry-kind {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    border: 1px solid var(--color-line);
    padding: 0.1rem 0.4rem;
    margin-left: 0.4rem;
    white-space: nowrap;
  }

  .entry-meta {
    margin: 0.5rem 0 0;
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-muted);
    text-transform: lowercase;
  }

  .entry-points {
    margin: 0.75rem 0 0;
    /* Tanpa padding: baris pertama tiap poin mulai tepat di garis kiri judul
       entri. Penanda kotak digantung ke kiri (-0.75rem) supaya tidak menggeser
       teks. Preflight Tailwind menghapus marker list, jadi penanda dibuat
       sendiri. */
    padding-left: 0;
    list-style: none;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    /* Tanpa batas lebar: poin memakai lebar kolom yang sama dengan judul,
       sehingga tepi kanannya berhenti tepat sebelum kolom periode di kanan
       (sebelum "jun - okt 2025"), bukan menyisakan ruang kosong. */
    max-width: none;
  }

  .entry-points li {
    position: relative;
  }

  .entry-points li::before {
    content: "";
    position: absolute;
    left: -0.75rem;
    top: 0.62em;
    width: 5px;
    height: 5px;
    background: var(--accent);
  }

  .entry-points li + li {
    margin-top: 0.25rem;
  }

  .entry-link {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--accent, var(--color-electric));
  }

  @media (min-width: 860px) {
    /* Satu kolom baca: judul, instansi, dan poin mulai di garis kiri yang
       sama; periode dan lokasi menempel di kanan baris pertama. Sebelumnya
       poin ditaruh di kolom ketiga sehingga mulai ~400px di kanan judul dan
       entri terbaca sebagai dua blok terpisah. */
    .entry-row {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      align-items: baseline;
    }
    .entry-no {
      grid-row: 1 / span 2;
    }
    .entry-main {
      grid-row: 1 / span 2;
    }
    .entry-meta {
      margin: 0 0 0 auto;
      text-align: right;
      flex-direction: column;
      gap: 0.25rem;
      grid-column: 3;
      grid-row: 1;
    }
    .entry-points {
      /* Kolom 2 saja, bukan 2 / -1: tepi kanan teks jadi sejajar dengan kolom
         periode dan lokasi di kanan atas. */
      grid-column: 2;
      grid-row: 3;
      margin: 0.9rem 0 0;
    }
    .entry-link {
      grid-column: 2 / -1;
      grid-row: 4;
    }
  }
</style>
