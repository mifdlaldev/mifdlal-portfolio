---
// Urutan nav mengikuti urutan section di halaman, supaya arah scroll
// klik selalu konsisten (tidak pernah melompat ke belakang).
// Pendidikan dan sertifikasi tetap ada di halaman, tapi tidak di nav.
const links = [
  { href: '#tentang', label: 'Tentang' },
  { href: '#proyek', label: 'Proyek' },
  { href: '#layanan', label: 'Layanan' },
  { href: '#pengalaman', label: 'Pengalaman' },
]
---

<header class="nav">
  <div class="wrap nav-inner">
    <!-- Wordmark: kotak ink + glyph, lowercase, grammar Warp -->
    <a href="#main" class="brand">
      <span class="brand-mark" aria-hidden="true">M</span>
      <span class="brand-word">mifdlal</span>
    </a>

    <nav aria-label="Navigasi utama" class="nav-links">
      {links.map((l) => (
        <a href={l.href} class="nav-link">{l.label.toUpperCase()}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href="#kontak" class="btn btn-nav">Mulai proyek</a>
    </div>
  </div>
</header>

<script is:inline src="/js/nav-scroll.js" defer></script>



<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
    /* Posisi atas: tanpa blur, latar transparan: ASCII tampil apa adanya. */
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    /* Garis pemisah hanya muncul setelah bergeser dari paling atas. */
    border-bottom: 1px solid transparent;
    isolation: isolate;
  }

  /* Scroll-driven glass: berubah progresif saat melewati hero, tanpa JS. */
  /* Glass state setelah hero dilewati; base navbar transparan penuh. */
  .nav.is-scrolled {
    border-bottom-color: var(--color-line);
    background: color-mix(in srgb, var(--color-paper) 76%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--color-ink) 6%, transparent);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .nav.is-scrolled {
      background: var(--color-paper);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav {
      transition: background-color var(--dur-slow) var(--ease), box-shadow var(--dur-slow) var(--ease),
        border-color var(--dur-slow) var(--ease), color var(--dur-slow) var(--ease);
    }
  }
  /* Posisi fixed/top: teks putih + tombol putih dengan teks ink. */
  .nav:not(.is-scrolled) .nav-link,
  .nav:not(.is-scrolled) .brand-word {
    color: var(--color-paper);
  }

  .nav:not(.is-scrolled) .nav-link:hover {
    color: var(--color-lemon);
  }

  .nav:not(.is-scrolled) .brand-mark {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .nav:not(.is-scrolled) .btn-nav {
    background: var(--color-paper);
    color: var(--color-ink);
    border-color: var(--color-paper);
  }

  .nav:not(.is-scrolled) .btn-nav:hover {
    background: var(--color-lemon);
    color: var(--color-ink);
    border-color: var(--color-lemon);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-link,
    .brand-word,
    .brand-mark,
    .btn-nav {
      transition: color var(--dur-slow) var(--ease), background-color var(--dur-slow) var(--ease),
        border-color var(--dur-slow) var(--ease);
    }
  }

  .nav-inner {
    display: grid;
    /* 1fr auto 1fr: link tengah benar-benar di tengah viewport,
       bukan di tengah ruang sisa setelah brand. */
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: 64px; /* Warp nav height */
  }

  /* Wordmark */
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-ink);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    background: var(--color-ink);
    color: var(--color-lemon);
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 600;
    flex-shrink: 0;
  }

  .brand-word {
    font-family: var(--font-display);
    font-size: var(--text-brand);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    text-transform: lowercase;
  }

  /* Link tengah: mono uppercase kecil (13px Warp) */
  .nav-links {
    display: none;
    gap: 1.25rem;
    justify-self: center;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    font-weight: 500;
    letter-spacing: var(--tracking-caps-tight);
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color var(--dur-fast) var(--ease);
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  /* Section yang sedang dilihat: underline tipis + warna penuh. */
  .nav-link.is-active {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .nav:not(.is-scrolled) .nav-link.is-active {
    color: var(--color-paper);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-self: end;
  }

  .btn-nav {
    padding: 0.5rem 1rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
    min-height: 40px;
  }

  .btn-nav:hover {
    background: var(--color-electric);
    border-color: var(--color-electric);
  }

  @media (min-width: 860px) {
    .nav-links { display: flex; }
  }

  /* Mobile: brand + tombol CTA. Link section disembunyikan supaya
     tidak berdesakan, tapi aksi utama tetap bisa dijangkau. */
  @media (max-width: 859px) {
    .nav-inner {
      grid-template-columns: auto 1fr;
      gap: 0.75rem;
    }
  }
</style>
