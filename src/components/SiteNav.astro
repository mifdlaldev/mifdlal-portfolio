---
import { Image } from 'astro:assets'
import logoMark from '../assets/logo-mark.png'

// Urutan nav mengikuti urutan section di halaman, supaya arah scroll
// klik selalu konsisten (tidak pernah melompat ke belakang).
// Pendidikan dan sertifikasi tetap ada di halaman, tapi tidak di nav.
//
// Path-aware: di beranda tautan = anchor murni ("#tentang"). Di rute dalam
// (mis. /proyek/loka-logistics) anchor di-prefix "/" supaya klik benar-benar
// membawa kembali ke beranda dan menggulir ke section itu, bukan diam.
const isHome = Astro.url.pathname === '/'
const base = isHome ? '' : '/'
const links = [
  { href: `${base}#tentang`, label: 'Tentang', en: 'About' },
  { href: `${base}#proyek`, label: 'Proyek', en: 'Work' },
  { href: `${base}#layanan`, label: 'Layanan', en: 'Services' },
  { href: `${base}#pengalaman`, label: 'Pengalaman', en: 'Experience' },
]
---

<header class="nav" data-nav-solid={isHome ? undefined : ''}>
  <div class="wrap nav-inner">
    <!-- Brand: logo monogram (tanpa kotak latar) + wordmark lowercase -->
    <a href={isHome ? '#main' : '/'} class="brand">
      <Image
        class="brand-logo"
        src={logoMark}
        alt=""
        draggable="false"
        widths={[64, 96, 128]}
        sizes="46px"
        format="webp"
        quality={92}
        loading="eager"
        decoding="async"
      />
      <span class="brand-word">mifdlal</span>
    </a>

    <nav aria-label="Main navigation" data-i18n-aria-id="Navigasi utama" class="nav-links">
      {links.map((l) => (
        <a href={l.href} class="nav-link" data-i18n-id={l.label}>
          {l.en}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href={`${base}#kontak`} class="btn btn-nav" data-i18n-id="Mulai Proyek">
        Start a project
      </a>

      {/* Pemicu menu ringkas: hanya tampil di bawah 860px. Label "Menu"
          dibiarkan tanpa terjemahan karena sama di dua bahasa. */}
      <button
        type="button"
        class="nav-burger"
        data-nav-burger
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav-burger-bar" aria-hidden="true"></span>
        <span class="nav-burger-bar" aria-hidden="true"></span>
        <span class="nav-burger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {/* Panel menu ringkas: satu kolom, tautan section lalu aksi utama. */}
  <div class="nav-menu" id="nav-menu" data-nav-menu hidden>
    <nav
      class="wrap nav-menu-inner"
      aria-label="Main navigation"
      data-i18n-aria-id="Navigasi utama"
    >
      {links.map((l) => (
        <a href={l.href} class="nav-menu-link" data-i18n-id={l.label}>
          {l.en}
        </a>
      ))}
      <a href={`${base}#kontak`} class="btn btn-nav nav-menu-cta" data-i18n-id="Mulai Proyek">
        Start a project
      </a>
    </nav>
  </div>
</header>

<script is:inline src="/js/nav-scroll.js" defer></script>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
    /* Posisi atas: tanpa blur, latar transparan: ASCII tampil apa adanya. */
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    /* Garis pemisah hanya muncul setelah bergeser dari paling atas. */
    border-bottom: 1px solid transparent;
    isolation: isolate;
  }

  /* Scroll-driven glass: berubah progresif saat melewati hero, tanpa JS. */
  /* Glass state setelah hero dilewati; base navbar transparan penuh. */
  .nav.is-scrolled {
    border-bottom-color: var(--color-line);
    background: var(--color-paper);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--color-ink) 6%, transparent);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .nav.is-scrolled {
      background: var(--color-paper);
    }
  }

  /* Rute dalam tidak punya hero gelap: navbar langsung tampil solid
     (state sama dengan .is-scrolled) supaya teks tidak putih-di-atas-kertas. */
  .nav[data-nav-solid] {
    border-bottom-color: var(--color-line);
    background: var(--color-paper);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--color-ink) 6%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav {
      transition:
        background-color var(--dur-slow) var(--ease),
        box-shadow var(--dur-slow) var(--ease),
        border-color var(--dur-slow) var(--ease),
        color var(--dur-slow) var(--ease);
    }
  }
  /* Posisi fixed/top: teks putih + tombol putih dengan teks ink. */
  /* Teks di atas hero: platnya gelap di kedua tema, jadi warnanya tetap. */
  .nav:not(.is-scrolled):not([data-nav-solid]) .nav-link,
  .nav:not(.is-scrolled):not([data-nav-solid]) .brand-word,
  .nav:not(.is-scrolled):not([data-nav-solid]) .nav-burger {
    color: var(--paper-plate);
  }

  .nav:not(.is-scrolled):not([data-nav-solid]) .nav-link:hover {
    color: var(--color-lemon);
  }

  /* Logo monokrom: sumbernya hitam, jadi state terang tidak perlu filter.
     State gelap memaksa putih lewat brightness(0) lalu invert, supaya hasilnya
     putih bersih berapa pun nilai hitam aslinya. Alpha tidak tersentuh. */
  .nav:not(.is-scrolled):not([data-nav-solid]) .brand-logo {
    filter: brightness(0) invert(1);
  }

  .nav:not(.is-scrolled):not([data-nav-solid]) .btn-nav {
    background: var(--paper-plate);
    color: var(--ink-plate);
    border-color: var(--paper-plate);
  }

  .nav:not(.is-scrolled):not([data-nav-solid]) .btn-nav:hover {
    background: var(--color-lemon);
    color: var(--on-lemon);
    border-color: var(--color-lemon);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-link,
    .brand-word,
    .brand-logo,
    .btn-nav {
      transition:
        color var(--dur-slow) var(--ease),
        background-color var(--dur-slow) var(--ease),
        border-color var(--dur-slow) var(--ease);
      /* filter tidak ikut shorthand di atas; beri transisinya sendiri. */
    }
  }

  .nav-inner {
    display: grid;
    /* 1fr auto 1fr: link tengah benar-benar di tengah viewport,
       bukan di tengah ruang sisa setelah brand. */
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: 64px; /* Warp nav height */
  }

  /* Wordmark */
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-ink);
  }

  /* Logo tanpa kotak latar: hanya bentuknya sendiri di atas kertas.
     Tinggi 30px dipilih dari uji keterbacaan: dua celah diagonal sempit di
     monogram mulai menutup di bawah 24px, dan 30px masih muat di nav 64px. */
  .brand-logo {
    display: block;
    height: 30px;
    width: auto;
    flex-shrink: 0;
    /* Sumbernya hitam; di tema gelap dibalik lewat token. */
    filter: var(--mark-filter);
  }

  .brand-word {
    font-family: var(--font-display);
    font-size: var(--text-brand);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    text-transform: lowercase;
  }

  /* Link tengah: mono uppercase kecil (13px Warp) */
  .nav-links {
    display: none;
    gap: 1.25rem;
    justify-self: center;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    font-weight: 500;
    letter-spacing: var(--tracking-caps-tight);
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    position: relative;
    transition: color var(--dur-fast) var(--ease);
  }

  /* Garis bawah animasi: mulai dari titik tengah teks, lalu melebar
     simetris ke kiri dan ke kanan sampai selebar teks.
     Anchor left:50% + translateX(-50%) membuat titik tumbuh tepat di
     tengah; width 0 -> 100% melebar dua arah sekaligus.
     currentColor supaya warna garis ikut state teks (muted/ink/paper). */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(50% + 0.7em);
    width: 0;
    height: 2px;
    background: currentColor;
    transform: translateX(-50%);
    transition: width var(--dur-base) var(--ease);
    pointer-events: none;
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  /* Section yang sedang dilihat: warna penuh + garis bawah penuh. */
  .nav-link.is-active {
    color: var(--color-ink);
  }

  .nav:not(.is-scrolled):not([data-nav-solid]) .nav-link.is-active {
    color: var(--paper-plate);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-self: end;
  }

  .btn-nav {
    /* .btn memaksa lowercase; tombol navigasi ditulis kapital dan dibiarkan apa adanya. */
    text-transform: none;
    padding: 0.5rem 1rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
    min-height: 40px;
  }

  .btn-nav:hover {
    background: var(--color-electric);
    border-color: var(--color-electric);
  }

  /* --- pemicu menu ringkas (di bawah 860px) --- */
  .nav-burger {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid color-mix(in srgb, currentColor 34%, transparent);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .nav-burger-bar {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
  }

  /* Terbuka: dua baris luar jadi silang, baris tengah hilang. */
  .nav-burger[aria-expanded='true'] .nav-burger-bar:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-burger[aria-expanded='true'] .nav-burger-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-burger[aria-expanded='true'] .nav-burger-bar:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* --- panel menu ringkas --- */
  .nav-menu {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    box-shadow: 0 18px 32px color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .nav-menu[hidden] {
    display: none;
  }

  .nav-menu-inner {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.75rem 1.5rem;
  }

  .nav-menu-link {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    font-weight: 500;
    letter-spacing: var(--tracking-caps-tight);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    transition: color var(--dur-fast) var(--ease);
  }

  .nav-menu-link:hover,
  .nav-menu-link.is-active {
    color: var(--color-electric);
  }

  .nav-menu-cta {
    justify-self: start;
    margin-block-start: 1rem;
  }

  /* Panel terbuka = navbar dipaksa solid di kedua tema, supaya teks kertas
     tidak jatuh di atas kertas. Rantai :not() disamakan dengan aturan state
     hero supaya menang tanpa !important. */
  .nav.is-menu-open {
    border-bottom-color: var(--color-line);
    background: var(--color-paper);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--color-ink) 6%, transparent);
  }

  .nav.is-menu-open:not(.is-scrolled):not([data-nav-solid]) .nav-link,
  .nav.is-menu-open:not(.is-scrolled):not([data-nav-solid]) .brand-word,
  .nav.is-menu-open:not(.is-scrolled):not([data-nav-solid]) .nav-burger {
    color: var(--color-ink);
  }

  .nav.is-menu-open:not(.is-scrolled):not([data-nav-solid]) .brand-logo {
    filter: var(--mark-filter);
  }

  @media (min-width: 860px) {
    .nav-links {
      display: flex;
    }

    /* Dari 860px ke atas nav lengkap tampil, jadi pemicu dan panel mati. */
    .nav-burger,
    .nav-menu {
      display: none;
    }
  }

  /* Di bawah 860px: brand + pemicu menu. Tautan section dan aksi utama
     pindah ke panel supaya baris nav tidak berdesakan. */
  @media (max-width: 859px) {
    .nav-inner {
      grid-template-columns: auto 1fr;
      gap: 0.75rem;
    }

    .nav-actions .btn-nav {
      display: none;
    }
  }
</style>

<script is:inline>
  ;(function () {
    var nav = document.querySelector('.nav')
    var burger = document.querySelector('[data-nav-burger]')
    var menu = document.querySelector('[data-nav-menu]')
    if (!nav || !burger || !menu) return

    function setOpen(open) {
      menu.hidden = !open
      burger.setAttribute('aria-expanded', open ? 'true' : 'false')
      nav.classList.toggle('is-menu-open', open)
    }

    burger.addEventListener('click', function () {
      setOpen(menu.hidden)
    })

    /* Klik di luar navbar menutup panel. */
    document.addEventListener('click', function (e) {
      if (!menu.hidden && !nav.contains(e.target)) setOpen(false)
    })

    /* Escape menutup dan mengembalikan fokus ke pemicu. */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false)
        burger.focus()
      }
    })

    /* Menuju satu section: panel tutup supaya section-nya terlihat. */
    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false)
    })

    /* Melebar ke nav lengkap: panel tidak boleh tertinggal terbuka. */
    window.addEventListener('resize', function () {
      if (!menu.hidden && window.matchMedia('(min-width: 860px)').matches) setOpen(false)
    })
  })()
</script>
