---
const links = [
  { href: '#proyek', label: 'Proyek' },
  { href: '#tentang', label: 'Tentang' },
  { href: '#layanan', label: 'Layanan' },
]
---

<header class="nav glass">
  <div class="wrap nav-inner">
    <a href="#main" class="brand" aria-label="Ke atas halaman">
      <span class="brand-initial">M</span>
      <span class="brand-name">Mifdlal Tsaqib Alfarras</span>
    </a>

    <nav aria-label="Navigasi utama" class="nav-links">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <a href="#kontak" class="nav-cta">Kontak</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    border-radius: 0;
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 60px;
  }

  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-paper);
    min-width: 0;
  }

  .brand-initial {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-field);
    background: var(--color-amber);
    color: #0a1628;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .brand-name {
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Di 480px ke bawah nama penuh tidak muat neben CTA, dan inisial
     sudah membawa label lengkap lewat aria-label pada .brand. */
  @media (max-width: 480px) {
    .brand-name {
      display: none;
    }
  }

  .nav-links {
    display: none;
    gap: 1.5rem;
    justify-self: center;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.92rem;
    padding: 0 0.1rem;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav-links a:hover {
    color: var(--color-paper);
    border-bottom-color: var(--color-amber);
  }

  .nav-cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-paper);
    text-decoration: none;
    padding: 0 0.95rem;
    border-radius: 999px; /* satu-satunya pill di halaman */
    border: 1px solid var(--color-concrete);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .nav-cta:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }

  @media (min-width: 720px) {
    .nav-links { display: flex; }
    .brand-name { font-size: 0.95rem; }
  }
</style>
