---
import { Image } from 'astro:assets'
import logoMark from '../assets/logo-mark.png'

// Urutan nav mengikuti urutan section di halaman, supaya arah scroll
// klik selalu konsisten (tidak pernah melompat ke belakang).
// Pendidikan dan sertifikasi tetap ada di halaman, tapi tidak di nav.
const links = [
  { href: '#tentang', label: 'Tentang' },
  { href: '#proyek', label: 'Proyek' },
  { href: '#layanan', label: 'Layanan' },
  { href: '#pengalaman', label: 'Pengalaman' },
]
---

<header class="nav">
  <div class="wrap nav-inner">
    <!-- Brand: logo monogram (tanpa kotak latar) + wordmark lowercase -->
    <a href="#main" class="brand">
      <Image
        class="brand-logo"
        src={logoMark}
        alt=""
        draggable="false"
        widths={[64, 96, 128]}
        sizes="46px"
        format="webp"
        quality={92}
        loading="eager"
        decoding="async"
      />
      <span class="brand-word">mifdlal</span>
    </a>

    <nav aria-label="Navigasi utama" class="nav-links">
      {links.map((l) => (
        <a href={l.href} class="nav-link">{l.label.toUpperCase()}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href="#kontak" class="btn btn-nav">Mulai Proyek</a>
    </div>
  </div>
</header>

<script is:inline src="/js/nav-scroll.js" defer></script>



<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
    /* Posisi atas: tanpa blur, latar transparan: ASCII tampil apa adanya. */
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    /* Garis pemisah hanya muncul setelah bergeser dari paling atas. */
    border-bottom: 1px solid transparent;
    isolation: isolate;
  }

  /* Scroll-driven glass: berubah progresif saat melewati hero, tanpa JS. */
  /* Glass state setelah hero dilewati; base navbar transparan penuh. */
  .nav.is-scrolled {
    border-bottom-color: var(--color-line);
    background: var(--color-paper);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--color-ink) 6%, transparent);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .nav.is-scrolled {
      background: var(--color-paper);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav {
      transition: background-color var(--dur-slow) var(--ease), box-shadow var(--dur-slow) var(--ease),
        border-color var(--dur-slow) var(--ease), color var(--dur-slow) var(--ease);
    }
  }
  /* Posisi fixed/top: teks putih + tombol putih dengan teks ink. */
  .nav:not(.is-scrolled) .nav-link,
  .nav:not(.is-scrolled) .brand-word {
    color: var(--color-paper);
  }

  .nav:not(.is-scrolled) .nav-link:hover {
    color: var(--color-lemon);
  }

  /* Logo monokrom: sumbernya hitam, jadi state terang tidak perlu filter.
     State gelap memaksa putih lewat brightness(0) lalu invert, supaya hasilnya
     putih bersih berapa pun nilai hitam aslinya. Alpha tidak tersentuh. */
  .nav:not(.is-scrolled) .brand-logo {
    filter: brightness(0) invert(1);
  }

  .nav:not(.is-scrolled) .btn-nav {
    background: var(--color-paper);
    color: var(--color-ink);
    border-color: var(--color-paper);
  }

  .nav:not(.is-scrolled) .btn-nav:hover {
    background: var(--color-lemon);
    color: var(--color-ink);
    border-color: var(--color-lemon);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-link,
    .brand-word,
    .brand-logo,
    .btn-nav {
      transition: color var(--dur-slow) var(--ease), background-color var(--dur-slow) var(--ease),
        border-color var(--dur-slow) var(--ease);
      /* filter tidak ikut shorthand di atas; beri transisinya sendiri. */
    }
  }

  .nav-inner {
    display: grid;
    /* 1fr auto 1fr: link tengah benar-benar di tengah viewport,
       bukan di tengah ruang sisa setelah brand. */
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: 64px; /* Warp nav height */
  }

  /* Wordmark */
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-ink);
  }

  /* Logo tanpa kotak latar: hanya bentuknya sendiri di atas kertas.
     Tinggi 30px dipilih dari uji keterbacaan: dua celah diagonal sempit di
     monogram mulai menutup di bawah 24px, dan 30px masih muat di nav 64px. */
  .brand-logo {
    display: block;
    height: 30px;
    width: auto;
    flex-shrink: 0;
  }

  .brand-word {
    font-family: var(--font-display);
    font-size: var(--text-brand);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    text-transform: lowercase;
  }

  /* Link tengah: mono uppercase kecil (13px Warp) */
  .nav-links {
    display: none;
    gap: 1.25rem;
    justify-self: center;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    font-weight: 500;
    letter-spacing: var(--tracking-caps-tight);
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    position: relative;
    transition: color var(--dur-fast) var(--ease);
  }

  /* Garis bawah animasi: mulai dari titik tengah teks, lalu melebar
     simetris ke kiri dan ke kanan sampai selebar teks.
     Anchor left:50% + translateX(-50%) membuat titik tumbuh tepat di
     tengah; width 0 -> 100% melebar dua arah sekaligus.
     currentColor supaya warna garis ikut state teks (muted/ink/paper). */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 50%;
    top: calc(50% + 0.7em);
    width: 0;
    height: 2px;
    background: currentColor;
    transform: translateX(-50%);
    transition: width var(--dur-base) var(--ease);
    pointer-events: none;
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  /* Section yang sedang dilihat: warna penuh + garis bawah penuh. */
  .nav-link.is-active {
    color: var(--color-ink);
  }

  .nav:not(.is-scrolled) .nav-link.is-active {
    color: var(--color-paper);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-self: end;
  }

  .btn-nav {
    /* .btn memaksa lowercase; tombol navigasi ditulis kapital dan dibiarkan apa adanya. */
    text-transform: none;
    padding: 0.5rem 1rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
    min-height: 40px;
  }

  .btn-nav:hover {
    background: var(--color-electric);
    border-color: var(--color-electric);
  }

  @media (min-width: 860px) {
    .nav-links { display: flex; }
  }

  /* Mobile: brand + tombol CTA. Link section disembunyikan supaya
     tidak berdesakan, tapi aksi utama tetap bisa dijangkau. */
  @media (max-width: 859px) {
    .nav-inner {
      grid-template-columns: auto 1fr;
      gap: 0.75rem;
    }
  }
</style>
