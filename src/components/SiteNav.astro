---
const links = [
  { href: '#proyek', label: 'Proyek' },
  { href: '#tentang', label: 'Tentang' },
  { href: '#layanan', label: 'Layanan' },
]
---

<header class="nav">
  <div class="wrap nav-inner">
    <!-- Wordmark: kotak ink + glyph, lowercase, grammar Warp -->
    <a href="#main" class="brand">
      <span class="brand-mark" aria-hidden="true">M</span>
      <span class="brand-word">mifdlal</span>
    </a>

    <nav aria-label="Navigasi utama" class="nav-links">
      {links.map((l) => (
        <a href={l.href} class="nav-link">{l.label.toUpperCase()}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href="mailto:hello@mifdlal.com" class="nav-link nav-signin">EMAIL</a>
      <a href="#kontak" class="btn btn-nav">Mulai proyek</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    height: 64px; /* Warp nav height */
  }

  /* Wordmark */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-ink);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    background: var(--color-ink);
    color: var(--color-lemon);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .brand-word {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: lowercase;
  }

  /* Link tengah — mono uppercase kecil (13px Warp) */
  .nav-links {
    display: none;
    gap: 2rem;
    justify-self: center;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .nav-actions {
    display: none;
    align-items: center;
    gap: 1.25rem;
    justify-self: end;
  }

  .nav-signin {
    padding: 0;
    min-height: 44px;
  }

  .btn-nav {
    padding: 0.5rem 1rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
    min-height: 40px;
  }

  .btn-nav:hover {
    background: var(--color-electric);
    border-color: var(--color-electric);
  }

  @media (min-width: 860px) {
    .nav-links { display: flex; }
    .nav-actions { display: flex; }
  }

  /* Mobile: brand tetap, actions tetap, links jadi menu sederhana */
  @media (max-width: 859px) {
    .nav-inner {
      grid-template-columns: auto 1fr;
      gap: 0.75rem;
    }
    .nav-actions {
      justify-self: end;
    }
    .nav-signin {
      display: none; /* di mobile cukup tombol CTA */
    }
  }
</style>
