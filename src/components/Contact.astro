---
import { contact } from '../data/site'
const subject = encodeURIComponent('Diskusi proyek web atau otomasi AI')
import CodeComment from './CodeComment.astro'
import SocialIcons from './SocialIcons.astro'
import CopyEmail from './CopyEmail'
---

<section id="kontak" class="section">
  <CodeComment text="// kontak" />
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-left">
        <span class="fig-label">fig. 08 · kontak</span>
        <h2 class="section-headline">Ceritakan yang ingin Anda bangun.</h2>
        <p class="contact-note">
          Jika belum yakin harus mulai dari mana, tuliskan masalahnya.
        </p>

        <ul class="spec-list">
          <li>
            <span class="spec-k">Balasan</span>
            <span class="spec-v">1 hari kerja</span>
          </li>
          <li>
            <span class="spec-k">Zona waktu</span>
            <span class="spec-v">gmt+7 (wib)</span>
          </li>
          <li>
            <span class="spec-k">Lokasi</span>
            <span class="spec-v">bandung, id</span>
          </li>
        </ul>
      </div>

      <div class="contact-panel">
        <div class="panel-block">
          <p class="panel-label">Email</p>
          <div class="email-row">
            <a
              href={`mailto:${contact.email}?subject=${subject}`}
              class="contact-email"
            >
              {contact.email}
            </a>
            <CopyEmail email={contact.email} client:visible />
          </div>
        </div>

        <div class="panel-block">
          <p class="panel-label">Yang mempercepat balasan</p>
          <ol class="brief-list">
            <li><span class="brief-no" aria-hidden="true">01</span><span>Jenis usaha anda</span></li>
            <li><span class="brief-no" aria-hidden="true">02</span><span>Yang ingin dibangun atau diperbaiki</span></li>
            <li><span class="brief-no" aria-hidden="true">03</span><span>Target waktu atau tenggat</span></li>
            <li><span class="brief-no" aria-hidden="true">04</span><span>Perkiraan anggaran, kalau sudah ada</span></li>
          </ol>
        </div>
      </div>
    </div>

    <div class="contact-social">
      <p class="panel-label">Media sosial</p>
      <SocialIcons />
    </div>
  </div>
</section>

<style>

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  .contact-left {
    min-width: 0;
  }

  .contact-note {
    color: var(--color-muted);
    margin: 1rem 0 0;
    line-height: var(--leading-relaxed);
    max-width: 38ch;
    font-size: var(--text-body);
  }

  /* Datasheet mono */
  .spec-list {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .spec-list li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .spec-k {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    text-transform: none;
    color: var(--color-muted);
  }

  .spec-v {
    font-family: var(--font-mono);
    font-size: var(--text-data);
    color: var(--color-ink);
  }

  .spec-v a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .spec-v a:hover {
    color: var(--color-electric);
    border-bottom-color: var(--color-electric);
  }

  /* Panel kontak */
  .contact-panel {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    /* Kartu email: permukaan biru website. Border disamakan dengan latar
       supaya ukuran kotak tidak berubah, bukan dihapus. */
    border: 1px solid var(--color-electric);
    background: var(--color-electric);
  }

  .panel-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .panel-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    text-transform: none;
    color: var(--color-muted);
  }

  /* Di dalam kartu biru, label dan isi pakai kertas, bukan tinta.
     Label di kartu dinaikkan satu tingkat dari label mono biasa: di atas
     biru, 11px/400 terlalu tipis untuk terbaca. */
  .contact-panel .panel-label {
    font-size: var(--text-data);
    font-weight: var(--weight-semibold);
    color: color-mix(in srgb, var(--color-paper) 95%, transparent);
  }

  .contact-email {
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: var(--text-email);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    text-decoration: none;
    border-bottom: 2px solid color-mix(in srgb, var(--color-paper) 45%, transparent);
    padding-bottom: 0.25rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    overflow-wrap: anywhere;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .contact-email:hover {
    color: var(--color-lemon);
    border-bottom-color: var(--color-lemon);
  }

  /* Baris email: tautan mailto + tombol salin. Tombol dirender oleh island
     React, jadi selektornya memakai :global — atribut scope Astro tidak
     menempel ke elemen yang dibuat komponen anak. */
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .email-row :global(.copy-email) {
    position: relative;
    display: inline-flex;
  }

  .email-row :global(.copy-email__btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    /* Padding 12 + border 1 menyisakan kotak isi 18px, sama dengan ukuran
       ikon. Player animasi menggambar SVG selebar kotak isi, jadi ikon
       tidak ikut membesar mengikuti kotak sentuh 44px. */
    padding: 12px;
    border: 1px solid color-mix(in srgb, var(--color-paper) 35%, transparent);
    background: transparent;
    color: color-mix(in srgb, var(--color-paper) 92%, transparent);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .email-row :global(.copy-email__btn svg) {
    display: block;
  }

  .email-row :global(.copy-email__btn:hover) {
    color: var(--color-lemon);
    border-color: var(--color-lemon);
  }

  .email-row :global(.copy-email__btn:focus-visible) {
    outline: 2px solid var(--color-lemon);
    outline-offset: 2px;
  }

  /* Status melayang di atas tombol: tidak menggeser baris saat muncul.
     Ditengahkan terhadap kotak tombol (bukan rata kiri), karena teksnya
     lebih lebar daripada tombol 44px. */
  .email-row :global(.copy-email__status) {
    position: absolute;
    bottom: calc(100% + 0.35rem);
    left: 50%;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    text-transform: none;
    white-space: nowrap;
    color: var(--color-lemon);
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 2px);
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .email-row :global(.copy-email__status:not(:empty)) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .brief-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 30%, transparent);
  }

  .brief-list li {
    --brief-bleed: 0.6rem; /* lokal: lebar sorot kiri-kanan tiap butir */

    position: relative;
    /* Stacking context sendiri: pseudo berlatar lemon pakai z-index negatif,
       dan tanpa ini ia jatuh ke belakang latar biru panel. */
    isolation: isolate;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 30%, transparent);
    font-size: var(--text-sm);
    line-height: var(--leading-base);
    color: color-mix(in srgb, var(--color-paper) 90%, transparent);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  /* Sorot per butir: latar lemon di belakang nomor dan teksnya. Digambar
     sebagai pseudo-element supaya teks tidak bergeser satu piksel pun —
     padding baris tidak berubah saat hover. */
  .brief-list li::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--brief-bleed) * -1);
    z-index: var(--z-below);
    background: var(--color-lemon);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .brief-no {
    font-family: var(--font-mono);
    font-size: var(--text-data);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps-tight);
    color: var(--color-lemon);
    transition: color var(--dur-fast) var(--ease);
  }

  /* Hanya di perangkat berpointer: di layar sentuh hover menempel. */
  @media (hover: hover) {
    .brief-list li:hover {
      color: var(--color-ink);
      border-bottom-color: transparent;
    }

    .brief-list li:hover::before {
      opacity: 1;
    }

    .brief-list li:hover .brief-no {
      color: var(--color-ink);
    }
  }

  .contact-social {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 560px) {
    .contact-social {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: stretch;
    }

    /* tabel spec duduk rata dengan dasar panel kanan */
    .contact-left {
      display: flex;
      flex-direction: column;
    }

    .spec-list {
      margin-top: auto;
    }
  }
</style>
