---
import { contact } from '../data/site'
const subject = encodeURIComponent('Diskusi proyek web atau otomasi AI')
const subjectEn = encodeURIComponent('Web project or AI automation discussion')
import CodeComment from './CodeComment.astro'
import SocialIcons from './SocialIcons.astro'
import CopyEmail from './CopyEmail'
---

<section id="kontak" class="section">
  <CodeComment text="// kontak" textEn="// contact" />
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-left rise" data-rise="right">
        <span class="fig-label" data-i18n-id="fig. 08 · kontak">
          fig. 08 · contact
        </span>
        <h2 class="section-headline" data-i18n-id="Ceritakan yang ingin Anda bangun.">
          Tell me what you want to build.
        </h2>
        <p
          class="contact-note"
          data-i18n-id="Jika belum yakin harus mulai dari mana, tuliskan masalahnya."
        >
          If you're not sure where to start, just describe the problem.
        </p>

        <ul class="spec-list">
          <li>
            <span class="spec-k" data-i18n-id="Balasan">
              Reply
            </span>
            <span class="spec-v" data-i18n-id="1 hari kerja">
              1 working day
            </span>
          </li>
          <li>
            <span class="spec-k" data-i18n-id="Zona waktu">
              Timezone
            </span>
            <span class="spec-v" data-i18n-id="GMT+7 (WIB)">
              GMT+7 (WIB)
            </span>
          </li>
          <li>
            <span class="spec-k" data-i18n-id="Lokasi">
              Location
            </span>
            <span class="spec-v" data-i18n-id="Bandung, ID">
              Bandung, ID
            </span>
          </li>
        </ul>
      </div>

      <div class="contact-panel rise" data-rise="left">
        <div class="panel-block">
          <p class="panel-label" data-i18n-id="Email">
            Email
          </p>
          <div class="email-row">
            <a
              href={`mailto:${contact.email}?subject=${subjectEn}`}
              class="contact-email"
              data-mailto={contact.email}
              data-subject-id={subject}
              data-subject-en={subjectEn}
            >
              {contact.email}
            </a>
            <CopyEmail email={contact.email} client:visible />
          </div>
        </div>

        {/* WhatsApp: kanal alternatif utama untuk yang enggan membuka email.
            Nomor dan pesan awal disimpan sekali di data situs; teks pesan
            punya pasangan Inggris dan ditukar oleh runtime i18n lewat
            atribut data-wa-number / data-wa-text-id / data-wa-text-en. */}
        <div class="panel-block">
          <p class="panel-label" data-i18n-id="WhatsApp">
            WhatsApp
          </p>
          <a
            class="whatsapp-cta"
            href={`https://wa.me/${contact.whatsapp.number}?text=${encodeURIComponent(contact.whatsapp.messageEn)}`}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-number={contact.whatsapp.number}
            data-wa-text-id={contact.whatsapp.message}
            data-wa-text-en={contact.whatsapp.messageEn}
            aria-label="Chat on WhatsApp"
            data-i18n-aria-id="Chat WhatsApp"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
            </svg>
            <span data-i18n-id="Chat lewat WhatsApp">Chat on WhatsApp</span>
          </a>
          <p
            class="whatsapp-note"
            data-i18n-id="Kanal tercepat kalau Anda lebih suka tidak menulis email."
          >
            The fastest channel if you would rather not write an email.
          </p>
        </div>

        <div class="panel-block">
          <p class="panel-label" data-i18n-id="Yang mempercepat balasan">
            What speeds up my reply:
          </p>
          <ol class="brief-list">
            <li>
              <span class="brief-no" aria-hidden="true">
                01
              </span>
              <span data-i18n-id="Jenis usaha Anda">Type of your business</span>
            </li>
            <li>
              <span class="brief-no" aria-hidden="true">
                02
              </span>
              <span data-i18n-id="Yang ingin dibangun atau diperbaiki">
                What you want to build or fix
              </span>
            </li>
            <li>
              <span class="brief-no" aria-hidden="true">
                03
              </span>
              <span data-i18n-id="Target waktu atau tenggat">Target time or deadline</span>
            </li>
            <li>
              <span class="brief-no" aria-hidden="true">
                04
              </span>
              <span data-i18n-id="Perkiraan anggaran, kalau sudah ada">
                Approximate budget, if any
              </span>
            </li>
          </ol>
        </div>
      </div>
    </div>

    <div class="contact-social rise">
      <p class="panel-label" data-i18n-id="Media sosial">
        Social media
      </p>
      <SocialIcons />
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  .contact-left {
    min-width: 0;
  }

  .contact-note {
    color: var(--color-muted);
    margin: 1rem 0 0;
    line-height: var(--leading-relaxed);
    max-width: 38ch;
    font-size: var(--text-body);
  }

  /* Datasheet mono */
  .spec-list {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .spec-list li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .spec-k {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    text-transform: none;
    color: var(--color-muted);
  }

  .spec-v {
    font-family: var(--font-mono);
    font-size: var(--text-data);
    color: var(--color-ink);
  }

  .spec-v a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .spec-v a:hover {
    color: var(--color-electric);
    border-bottom-color: var(--color-electric);
  }

  /* Panel kontak */
  .contact-panel {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    /* Kartu email: permukaan biru website. Border disamakan dengan latar
       supaya ukuran kotak tidak berubah, bukan dihapus. */
    border: 1px solid var(--color-electric);
    background: var(--color-electric);
  }

  .panel-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .panel-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    text-transform: none;
    color: var(--color-muted);
  }

  /* Di dalam kartu biru, label dan isi pakai kertas, bukan tinta.
     Label di kartu dinaikkan satu tingkat dari label mono biasa: di atas
     biru, 11px/400 terlalu tipis untuk terbaca. */
  .contact-panel .panel-label {
    font-size: var(--text-data);
    font-weight: var(--weight-semibold);
    color: color-mix(in srgb, var(--color-paper) 95%, transparent);
  }

  .contact-email {
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: var(--text-email);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    text-decoration: none;
    border-bottom: 2px solid color-mix(in srgb, var(--color-paper) 45%, transparent);
    padding-bottom: 0.25rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    overflow-wrap: anywhere;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .contact-email:hover {
    color: var(--color-lemon);
    border-bottom-color: var(--color-lemon);
  }

  /* Tombol WhatsApp: aksi alternatif utama di dalam kartu biru. Solid
     kertas supaya langsung terbaca sebagai tombol, bukan sebagai teks. */
  .whatsapp-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    min-height: 44px;
    padding: 0.6rem 1.1rem;
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps-tight);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .whatsapp-cta svg {
    display: block;
    flex: none;
    fill: currentColor;
  }

  .whatsapp-cta:hover {
    background: var(--color-lemon);
    border-color: var(--color-lemon);
    color: var(--color-ink);
  }

  .whatsapp-note {
    margin: 0;
    max-width: 34ch;
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: color-mix(in srgb, var(--color-paper) 82%, transparent);
  }

  /* Baris email: tautan mailto + tombol salin. Tombol dirender oleh island
     React, jadi selektornya memakai :global — atribut scope Astro tidak
     menempel ke elemen yang dibuat komponen anak. */
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .email-row :global(.copy-email) {
    position: relative;
    display: inline-flex;
  }

  .email-row :global(.copy-email__btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    /* Padding 12 + border 1 menyisakan kotak isi 18px, sama dengan ukuran
       ikon. Player animasi menggambar SVG selebar kotak isi, jadi ikon
       tidak ikut membesar mengikuti kotak sentuh 44px. */
    padding: 12px;
    border: 1px solid color-mix(in srgb, var(--color-paper) 35%, transparent);
    background: transparent;
    color: color-mix(in srgb, var(--color-paper) 92%, transparent);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .email-row :global(.copy-email__btn svg) {
    display: block;
  }

  .email-row :global(.copy-email__btn:hover) {
    color: var(--color-lemon);
    border-color: var(--color-lemon);
  }

  .email-row :global(.copy-email__btn:focus-visible) {
    outline: 2px solid var(--color-lemon);
    outline-offset: 2px;
  }

  /* Status melayang di atas tombol: tidak menggeser baris saat muncul.
     Ditengahkan terhadap kotak tombol (bukan rata kiri), karena teksnya
     lebih lebar daripada tombol 44px. */
  .email-row :global(.copy-email__status) {
    position: absolute;
    bottom: calc(100% + 0.35rem);
    left: 50%;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-bold);
    text-transform: none;
    white-space: nowrap;
    color: var(--color-lemon);
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 2px);
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .email-row :global(.copy-email__status:not(:empty)) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .brief-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 30%, transparent);
  }

  .brief-list li {
    --brief-bleed: 0.6rem; /* lokal: lebar sorot kiri-kanan tiap butir */

    position: relative;
    /* Stacking context sendiri: pseudo berlatar lemon pakai z-index negatif,
       dan tanpa ini ia jatuh ke belakang latar biru panel. */
    isolation: isolate;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 30%, transparent);
    font-size: var(--text-sm);
    line-height: var(--leading-base);
    color: color-mix(in srgb, var(--color-paper) 90%, transparent);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  /* Sorot per butir: latar lemon di belakang nomor dan teksnya. Digambar
     sebagai pseudo-element supaya teks tidak bergeser satu piksel pun —
     padding baris tidak berubah saat hover. */
  .brief-list li::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--brief-bleed) * -1);
    z-index: var(--z-below);
    background: var(--color-lemon);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .brief-no {
    font-family: var(--font-mono);
    font-size: var(--text-data);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps-tight);
    color: var(--color-lemon);
    transition: color var(--dur-fast) var(--ease);
  }

  /* Hanya di perangkat berpointer: di layar sentuh hover menempel. */
  @media (hover: hover) {
    .brief-list li:hover {
      color: var(--color-ink);
      border-bottom-color: transparent;
    }

    .brief-list li:hover::before {
      opacity: 1;
    }

    .brief-list li:hover .brief-no {
      color: var(--color-ink);
    }
  }

  .contact-social {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 560px) {
    .contact-social {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: stretch;
    }

    /* tabel spec duduk rata dengan dasar panel kanan */
    .contact-left {
      display: flex;
      flex-direction: column;
    }

    .spec-list {
      margin-top: auto;
    }
  }
</style>
