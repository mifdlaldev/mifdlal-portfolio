---
// Widget chat mengambang bergaya mtadevworks.web.id — dark theme.
// Pojok kanan bawah, DI ATAS tombol .to-top. Tampil sejak awal di semua section.
// Vanilla JS same-origin di public/js/site-chat.js (CSP aman).
//
// Struktur (sama persis dengan referensi mtadevworks.web.id):
// 1. Header  — label "AI ASSISTANT" + judul + subtitle + tombol close
// 2. Quick questions — section collapsible dengan chip chip
// 3. Log pesan — bubble bot (kiri) / user (kanan), fully rounded
// 4. Privasi — teks privasi + toggle
// 5. Input — textarea + counter 0/1000 + tombol send biru
---

<div class="site-chat" data-site-chat data-open="false">
  <!-- Panel dialog (di atas launcher) -->
  <section
    id="chat-panel-aria"
    class="chat-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Chat dengan asisten AI Mifdlal"
    aria-hidden="true"
  >
    <!-- ── 1. Header ─────────────────────────────────────── -->
    <header class="chat-head">
      <div class="chat-head-info">
        <span class="chat-head-label">AI ASSISTANT</span>
        <h2 class="chat-head-title">Mifdlal Asisten</h2>
        <p class="chat-head-sub">Tanya soal layanan, proyek, stack, atau estimasi timeline.</p>
      </div>
      <button class="chat-close" type="button" aria-label="Tutup chat">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
      </button>
    </header>

    <!-- ── 2. Quick questions ────────────────────────────── -->
    <div class="chat-quick" data-chat-quick data-collapsed="false">
      <div class="chat-quick-head">
        <span class="chat-section-label">Quick Questions</span>
        <button class="chat-quick-toggle" type="button" aria-expanded="true" aria-controls="chat-quick-list" aria-label="Sembunyikan pertanyaan cepat">
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
            <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <div class="chat-quick-list" id="chat-quick-list" data-quick-list>
        <button class="chat-chip" type="button" data-prompt="Layanan apa saja yang ditawarkan?">Layanan apa saja yang ditawarkan?</button>
        <button class="chat-chip" type="button" data-prompt="Ceritakan proyek yang pernah dikerjakan">Proyek yang pernah dikerjakan</button>
        <button class="chat-chip" type="button" data-prompt="Berapa biaya bikin website?">Estimasi biaya website</button>
        <button class="chat-chip" type="button" data-prompt="Berapa lama pengerjaan website?">Estimasi timeline pengerjaan</button>
        <button class="chat-chip" type="button" data-prompt="Stack teknologi apa yang digunakan?">Stack teknologi</button>
        <button class="chat-chip" type="button" data-prompt="Bagaimana cara mulai proyek?">Cara mulai proyek</button>
      </div>
    </div>

    <!-- ── 3. Log pesan ──────────────────────────────────── -->
    <div class="chat-log" role="log" aria-label="Percakapan" aria-live="polite"></div>

    <!-- ── 4. Privasi ────────────────────────────────────── -->
    <div class="chat-privacy" data-chat-privacy data-collapsed="false">
      <span class="chat-privacy-text" id="chat-privacy-text">Privasi: chat ini hanya disimpan di sesi browser Anda. Jangan kirim password, API key, atau data sensitif.</span>
      <button class="chat-privacy-toggle" type="button" aria-expanded="true" aria-controls="chat-privacy-text" aria-label="Sembunyikan teks privasi">
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
          <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <!-- ── 5. Input ──────────────────────────────────────── -->
    <form class="chat-form" autocomplete="off">
      <label class="sr-only" for="chat-field">Tulis pesan</label>
      <textarea
        id="chat-field"
        class="chat-input"
        name="message"
        placeholder="Tulis pertanyaan Anda..."
        maxlength="1000"
        rows="2"
        enterkeyhint="send"
      ></textarea>
      <button class="chat-send" type="submit" aria-label="Kirim pesan" disabled>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M2.5 8h10M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
      </button>
    </form>
    <div class="chat-counter">
      <span class="chat-counter-text" data-counter>0 / 1000 Karakter</span>
    </div>

    <span class="chat-status-sr sr-only" role="status" aria-live="polite"></span>
  </section>

  <!-- Launcher: tombol lingkaran dark dengan aksen electric -->
  <button class="chat-launcher" type="button" draggable="false" aria-expanded="false" aria-controls="chat-panel-aria" aria-label="Buka chat asisten AI">
    <svg class="chat-launcher-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path
        d="M4 5.5h16v10.5H9.5L5.5 19.5v-3.5H4z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <circle cx="9" cy="11" r="1" fill="currentColor" />
      <circle cx="13" cy="11" r="1" fill="currentColor" />
      <circle cx="17" cy="11" r="1" fill="currentColor" />
    </svg>
    <span class="chat-badge-dot" aria-hidden="true"></span>
  </button>
</div>

<script is:inline src="/js/site-chat.js" defer></script>

<style>
  /* ============================================================
     POSISI: kolom tunggal rata dengan .to-top.
     - right sama persis dengan .to-top (var(--grid-gutter))
     - Launcher 44px = diameter .to-top -> pusat satu garis vertikal
     - bottom: 1.5rem (to-top) + 44px (to-top) + 12px gap = 5rem
     - --to-top-lift diisi :root oleh to-top.js -> keduanya naik
       bersama saat footer muncul, jarak 12px tetap konstan.
     ============================================================ */
  .site-chat {
    position: fixed;
    right: var(--grid-gutter);
    bottom: calc(5rem + env(safe-area-inset-bottom, 0px) + var(--to-top-lift, 0px));
    z-index: var(--z-raise);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    pointer-events: none;
    /* Animasi perpindahan posisi saat ganti section */
    transition: bottom 0.4s var(--ease-out);
  }

  /* Posisi merged: launcher tepat menutupi tombol .to-top.
     Berlaku dari section hero sampai sebelum section kontak. */
  .site-chat--merged {
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px) + var(--to-top-lift, 0px));
  }

  .site-chat > * {
    pointer-events: auto;
  }

  /* sr-only: screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Launcher ─────────────────────────────────────────── */
  .chat-launcher {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--ink-900);
    color: var(--paper);
    border: 1px solid var(--ink-900);
    cursor: pointer;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--ink-900) 40%, transparent);
    /* Anti-drag: icon tidak bisa di-seret user */
    user-select: none;
    -webkit-user-drag: none;
    touch-action: manipulation;
    transition:
      background-color var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }

  .chat-launcher:hover {
    background: var(--electric);
    border-color: var(--electric);
    transform: translateY(-1px);
  }

  .chat-launcher:focus-visible {
    outline: 2px solid var(--electric);
    outline-offset: 2px;
  }

  /* Dot status kanan-atas: lemon = online */
  .chat-badge-dot {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--lemon);
    border: 1px solid var(--ink-900);
    box-sizing: border-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chat-badge-dot {
      animation: chat-pulse 2.4s var(--ease) infinite;
    }
    @keyframes chat-pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(0.82); opacity: 0.75; }
    }
  }

  /* ── Panel — dark theme ──────────────────────────────── */
  .chat-panel {
    width: min(380px, calc(100vw - 2 * var(--grid-gutter)));
    max-height: min(600px, calc(100dvh - 7rem - env(safe-area-inset-bottom, 0px)));
    display: flex;
    flex-direction: column;
    background: var(--ink-900);
    border: 1px solid var(--ink-16);
    box-shadow: 0 16px 48px color-mix(in srgb, var(--ink-900) 50%, transparent);
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      visibility 0s linear var(--dur-base);
  }

  .site-chat[data-open='true'] .chat-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition:
      opacity var(--dur-enter) var(--ease-out),
      transform var(--dur-enter) var(--ease-out),
      visibility 0s linear 0s;
  }

  /* Corner bracket blueprint — aksen electric di 2 sudut */
  .chat-panel::before,
  .chat-panel::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
    z-index: var(--z-content);
  }
  .chat-panel::before {
    top: -1px;
    left: -1px;
    border-top: 1.5px solid var(--electric);
    border-left: 1.5px solid var(--electric);
  }
  .chat-panel::after {
    bottom: -1px;
    right: -1px;
    border-bottom: 1.5px solid var(--electric);
    border-right: 1.5px solid var(--electric);
  }

  /* ── 1. Header ───────────────────────────────────────── */
  .chat-head {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.75rem 0.75rem 0.625rem;
    background: var(--ink-900);
    border-bottom: 1px solid var(--ink-16);
    flex-shrink: 0;
  }

  .chat-head-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .chat-head-label {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-loose);
    color: var(--electric);
    line-height: var(--leading-ui);
  }

  .chat-head-title {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--leading-ui);
    color: var(--paper);
    margin: 0;
  }

  .chat-head-sub {
    font-size: var(--text-data);
    line-height: var(--leading-ui);
    color: color-mix(in srgb, var(--paper) 60%, transparent);
    margin: 0;
  }

  .chat-close {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    background: transparent;
    color: color-mix(in srgb, var(--paper) 60%, transparent);
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .chat-close:hover {
    background: color-mix(in srgb, var(--paper) 10%, transparent);
    color: var(--paper);
  }

  .chat-close:focus-visible {
    outline: 2px solid var(--electric);
    outline-offset: 1px;
  }

  /* ── 2. Quick questions ──────────────────────────────── */
  .chat-quick {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--ink-16);
    flex-shrink: 0;
  }

  .chat-quick-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.375rem;
  }

  .chat-section-label {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-loose);
    color: color-mix(in srgb, var(--paper) 50%, transparent);
    line-height: var(--leading-ui);
  }

  .chat-quick-toggle {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background: transparent;
    color: color-mix(in srgb, var(--paper) 50%, transparent);
    border: none;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }

  .chat-quick-toggle:hover {
    color: var(--paper);
    background: color-mix(in srgb, var(--paper) 10%, transparent);
  }

  .chat-quick-toggle:focus-visible {
    outline: 2px solid var(--electric);
    outline-offset: 1px;
  }

  .chat-quick-toggle svg {
    transition: transform var(--dur-fast) var(--ease);
  }

  .chat-quick[data-collapsed='true'] .chat-quick-toggle svg {
    transform: rotate(-90deg);
  }

  .chat-quick-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    overflow: hidden;
    transition: max-height var(--dur-base) var(--ease), opacity var(--dur-fast) var(--ease);
    max-height: 200px;
    opacity: 1;
  }

  .chat-quick[data-collapsed='true'] .chat-quick-list {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .chat-chip {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: var(--text-cap);
    line-height: var(--leading-ui);
    color: color-mix(in srgb, var(--paper) 75%, transparent);
    background: transparent;
    border: 1px solid var(--ink-16);
    border-radius: 999px;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    white-space: nowrap;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .chat-chip:hover {
    border-color: var(--electric);
    color: var(--electric);
    background: color-mix(in srgb, var(--electric) 10%, transparent);
  }

  .chat-chip:focus-visible {
    outline: 2px solid var(--electric);
    outline-offset: 1px;
  }

  /* ── 3. Log pesan ────────────────────────────────────── */
  .chat-log {
    flex: 1 1 auto;
    min-height: 160px;
    max-height: 280px;
    overflow-y: auto;
    padding: 0.875rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    /* Latar gelap dengan dot-grid samar (gaya blueprint) */
    background-color: color-mix(in srgb, var(--ink-900) 60%, var(--ink-70));
    background-image: radial-gradient(
      circle at 1px 1px,
      color-mix(in srgb, var(--paper) 6%, transparent) 1.2px,
      transparent 0
    );
    background-size: 22px 22px;
    overscroll-behavior: contain;
  }

  /* Row pesan */
  .site-chat :global(.chat-row) {
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
    max-width: 100%;
  }

  .site-chat :global(.chat-row--in) {
    justify-content: flex-start;
  }

  .site-chat :global(.chat-row--out) {
    justify-content: flex-end;
  }

  /* Animasi masuk */
  @media (prefers-reduced-motion: no-preference) {
    .site-chat :global(.chat-row) {
      animation: chat-row-in 0.28s var(--ease-out) both;
    }
  }

  /* Keyframes global — dipakai elemen dinamis */
  :global {
    @keyframes chat-row-in {
      0% { opacity: 0; transform: translateY(6px); }
      100% { opacity: 1; transform: none; }
    }
  }

  /* Bubble — fully rounded, tanpa tail */
  .site-chat :global(.chat-bubble) {
    position: relative;
    max-width: min(240px, 78%);
    padding: 0.4375rem 0.625rem 0.375rem;
    font-size: var(--text-sm);
    line-height: var(--leading-base);
    word-break: break-word;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  /* Bubble IN (bot): kotak abu-abu gelap dengan border samar */
  .site-chat :global(.chat-bubble--in) {
    align-self: flex-start;
    background: color-mix(in srgb, var(--paper) 8%, transparent);
    border: 1px solid var(--ink-16);
    border-radius: 0.5rem;
    color: color-mix(in srgb, var(--paper) 90%, transparent);
  }

  /* Bubble OUT (user): electric biru */
  .site-chat :global(.chat-bubble--out) {
    align-self: flex-end;
    background: var(--electric);
    color: var(--paper);
    border-radius: 0.5rem;
  }

  /* Timestamp inline di ujung teks */
  .site-chat :global(.chat-time) {
    display: inline-block;
    margin-left: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    vertical-align: bottom;
    line-height: var(--leading-none);
    user-select: none;
  }

  .site-chat :global(.chat-bubble--in .chat-time) {
    color: color-mix(in srgb, var(--paper) 40%, transparent);
  }

  .site-chat :global(.chat-bubble--out .chat-time) {
    color: color-mix(in srgb, var(--paper) 70%, transparent);
  }

  /* Typing indicator — kotak abu tanpa tail */
  .site-chat :global(.chat-typing) {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0.5rem 0.625rem 0.375rem;
    background: color-mix(in srgb, var(--paper) 8%, transparent);
    border: 1px solid var(--ink-16);
    border-radius: 0.5rem;
  }

  .site-chat :global(.chat-typing span) {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 50%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-chat :global(.chat-typing span) {
      animation: chat-typing-bounce 1.2s infinite var(--ease);
    }
    .site-chat :global(.chat-typing span:nth-child(2)) { animation-delay: 0.15s; }
    .site-chat :global(.chat-typing span:nth-child(3)) { animation-delay: 0.3s; }
  }

  /* Keyframes global — dipakai elemen dinamis */
  :global {
    @keyframes chat-typing-bounce {
      0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
      30% { transform: translateY(-3px); opacity: 1; }
    }
  }

  /* ── 4. Privasi ──────────────────────────────────────── */
  .chat-privacy {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    padding: 0.4375rem 0.75rem;
    border-top: 1px solid var(--ink-16);
    flex-shrink: 0;
  }

  .chat-privacy-text {
    flex: 1 1 auto;
    font-size: var(--text-cap);
    line-height: var(--leading-ui);
    color: color-mix(in srgb, var(--paper) 45%, transparent);
    overflow: hidden;
    transition: max-height var(--dur-base) var(--ease), opacity var(--dur-fast) var(--ease);
    max-height: 60px;
    opacity: 1;
  }

  .chat-privacy[data-collapsed='true'] .chat-privacy-text {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .chat-privacy-toggle {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background: transparent;
    color: color-mix(in srgb, var(--paper) 45%, transparent);
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }

  .chat-privacy-toggle:hover {
    color: var(--paper);
    background: color-mix(in srgb, var(--paper) 10%, transparent);
  }

  .chat-privacy-toggle:focus-visible {
    outline: 2px solid var(--electric);
    outline-offset: 1px;
  }

  .chat-privacy-toggle svg {
    transition: transform var(--dur-fast) var(--ease);
  }

  .chat-privacy[data-collapsed='true'] .chat-privacy-toggle svg {
    transform: rotate(-90deg);
  }

  /* ── 5. Input ────────────────────────────────────────── */
  .chat-form {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-top: 1px solid var(--ink-16);
    background: var(--ink-900);
    flex-shrink: 0;
  }

  .chat-input {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    flex: 1 1 auto;
    min-width: 0;
    height: 60px;
    max-height: 60px;
    padding: 0.5rem 0.75rem;
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    color: var(--paper);
    background: color-mix(in srgb, var(--paper) 6%, transparent);
    border: 1px solid var(--ink-16);
    border-radius: 0.375rem;
    resize: none;
    overflow-y: auto;
    font-family: inherit;
  }

  .chat-input::placeholder {
    color: color-mix(in srgb, var(--paper) 35%, transparent);
  }

  .chat-input:focus-visible {
    outline: 2px solid var(--electric);
    outline-offset: 1px;
    border-color: var(--electric);
  }

  .chat-input:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .chat-send {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    height: 38px;
    border-radius: 0.375rem;
    background: var(--electric);
