---
// Widget chat mengambang — pojok kanan bawah, DI ATAS tombol .to-top.
// Tampil sejak awal di semua section. Vanilla JS same-origin di
// public/js/site-chat.js (CSP script-src 'self' tetap terpenuhi).
---

<div class="site-chat" data-site-chat data-open="false">
  <!-- Panel dialog (di atas launcher) -->
  <section
    id="chat-panel-aria"
    class="chat-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Chat dengan asisten AI Mifdlal"
    aria-hidden="true"
  >
    <header class="chat-head">
      <span class="chat-fig">fig. chat · asisten AI</span>
      <span class="chat-model">openrouter · online</span>
      <button class="chat-close" type="button" aria-label="Tutup chat">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
      </button>
    </header>

    <div class="chat-log" role="log" aria-live="polite" aria-label="Percakapan"></div>

    <form class="chat-form" autocomplete="off">
      <label class="sr-only" for="chat-field">Tulis pesan</label>
      <input
        id="chat-field"
        class="chat-input"
        type="text"
        name="message"
        placeholder="Tanya apa saja... (Enter kirim)"
        maxlength="2000"
        enterkeyhint="send"
      />
      <button class="chat-send" type="submit" aria-label="Kirim pesan">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M2.5 8h10M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
      </button>
    </form>

    <span class="chat-status sr-only" role="status" aria-live="polite"></span>
  </section>

  <!-- Launcher: tombol lingkaran blueprint di atas .to-top -->
  <button class="chat-launcher" type="button" aria-expanded="false" aria-controls="chat-panel-aria" aria-label="Buka chat asisten AI">
    <svg class="chat-launcher-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
      <path
        d="M4 5.5h16v10.5H9.5L5.5 19.5v-3.5H4z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <circle cx="9" cy="11" r="1" fill="currentColor" />
      <circle cx="13" cy="11" r="1" fill="currentColor" />
      <circle cx="17" cy="11" r="1" fill="currentColor" />
    </svg>
    <span class="chat-badge-dot" aria-hidden="true"></span>
  </button>
</div>

<script is:inline src="/js/site-chat.js" defer></script>

<style>
  /* ============================================================
     POSISI: pojok kanan bawah, di atas .to-top yang duduk di
     bottom: calc(1.5rem + safe-area + lift). Widget chat 20px
     lebih tinggi agar tidak pernah menimpa tombol ke atas.
     ============================================================ */
  .site-chat {
    position: fixed;
    right: var(--grid-gutter);
    bottom: calc(5rem + env(safe-area-inset-bottom, 0px) + var(--to-top-lift, 0px));
    z-index: var(--z-raise);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    pointer-events: none;
  }

  .site-chat > * {
    pointer-events: auto;
  }

  /* ── Launcher ─────────────────────────────────────────── */
  .chat-launcher {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1px solid var(--color-ink);
    cursor: pointer;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-ink) 24%, transparent);
    transition:
      background-color var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }

  .chat-launcher:hover {
    background: var(--color-electric);
    border-color: var(--color-electric);
    transform: translateY(-1px);
  }

  .chat-launcher:focus-visible {
    outline: 2px solid var(--color-electric);
    outline-offset: 2px;
  }

  /* Dot status kiri-atas: electric = online */
  .chat-badge-dot {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--color-lemon);
    border: 1px solid var(--color-ink);
    box-sizing: border-box;
  }
  @media (prefers-reduced-motion: no-preference) {
    .chat-badge-dot {
      animation: chat-pulse 2.4s var(--ease) infinite;
    }
    @keyframes chat-pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(0.82); opacity: 0.75; }
    }
  }

  /* ── Panel ────────────────────────────────────────────── */
  .chat-panel {
    width: min(360px, calc(100vw - 2 * var(--grid-gutter)));
    max-height: min(520px, calc(100dvh - 7rem - env(safe-area-inset-bottom, 0px)));
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    /* Corner bracket 4 sudut, bahasa visual yang sama dengan diagram hero */
    box-shadow: 0 12px 40px color-mix(in srgb, var(--color-ink) 18%, transparent);
    overflow: hidden;
    /* Sembunyi default; data-open=true membuka */
    visibility: hidden;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }

  .site-chat[data-open='true'] .chat-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* Corner bracket blueprint 2 sudut panel (kiri atas, kanan bawah) */
  .chat-panel::before,
  .chat-panel::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
  }
  .chat-panel::before {
    top: -1px;
    left: -1px;
    border-top: 1.5px solid var(--color-electric);
    border-left: 1.5px solid var(--color-electric);
  }
  .chat-panel::after {
    bottom: -1px;
    right: -1px;
    border-bottom: 1.5px solid var(--color-electric);
    border-right: 1.5px solid var(--color-electric);
  }

  /* ── Header panel ────────────────────────────────────── */
  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    background: color-mix(in srgb, var(--color-electric) 7%, var(--color-paper));
    border-bottom: 1px solid var(--color-line);
  }

  .chat-fig {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    color: var(--color-electric);
  }

  .chat-model {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    color: var(--color-muted);
  }

  /* ── Log pesan ───────────────────────────────────────── */
  .chat-log {
    flex: 1 1 auto;
    min-height: 160px;
    max-height: 320px;
    overflow-y: auto;
    padding: 0.875rem 0.875rem 0.625rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    background-image: radial-gradient(
      circle at 1px 1px,
      var(--color-line-soft) 1.2px,
      transparent 0
    );
    background-size: 26px 26px;
  }

  /* ── Bubble ──────────────────────────────────────────── */
  .chat-bubble {
    max-width: 86%;
    padding: 0.5rem 0.75rem;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    word-break: break-word;
    white-space: pre-wrap;
    position: relative;
  }

  .chat-bubble--bot {
    align-self: flex-start;
    background: var(--color-white);
    border: 1px solid var(--color-line);
  }

  .chat-bubble--user {
    align-self: flex-end;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1px solid var(--color-ink);
  }

  /* ── Indikator typing (3 titik) ──────────────────────── */
  .chat-typing {
    align-self: flex-start;
    display: inline-flex;
    gap: 4px;
    padding: 0.625rem 0.75rem;
    background: var(--color-white);
    border: 1px solid var(--color-line);
  }

  .chat-typing span {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chat-typing span {
      animation: chat-typing-bounce 1.2s infinite var(--ease);
    }
    .chat-typing span:nth-child(2) { animation-delay: 0.15s; }
    .chat-typing span:nth-child(3) { animation-delay: 0.3s; }
    @keyframes chat-typing-bounce {
      0%, 60%, 100% { transform: translateY(0); opacity: 0.55; }
      30% { transform: translateY(-3px); opacity: 1; }
    }
  }

  /* ── Form + input ────────────────────────────────────── */
  .chat-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .chat-input {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    flex: 1 1 auto;
    min-width: 0;
    height: 38px;
    padding: 0 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-ink);
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: 999px;
  }

  .chat-input::placeholder {
    color: var(--color-muted);
  }

  .chat-input:focus-visible {
    outline: 2px solid var(--color-electric);
    outline-offset: 1px;
  }

  .chat-send {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    height: 38px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1px solid var(--color-ink);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .chat-send:hover {
    background: var(--color-electric);
    border-color: var(--color-electric);
  }

  .chat-send:focus-visible {
    outline: 2px solid var(--color-electric);
    outline-offset: 2px;
  }

  .chat-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* aria-hidden panel dikelola penuh oleh CSS visibility. Namun struktur
     aria-hidden="true" statis di markup membuat panel tak terbaca saat
     terbuka. JS men-toggle aria-hidden bersamaan dengan data-open. */
  @media (max-width: 560px) {
    .site-chat {
      right: 1rem;
      bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px) + var(--to-top-lift, 0px));
    }
    .chat-panel {
      width: calc(100vw - 2rem);
    }
  }
</style>
