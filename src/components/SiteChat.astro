---
// Widget chat mengambang bergaya WhatsApp — pojok kanan bawah, DI ATAS
// tombol .to-top. Tampil sejak awal di semua section.
// Vanilla JS same-origin di public/js/site-chat.js (CSP aman).
//
// Adaptasi WhatsApp Web ke blueprint editorial:
// - Header: avatar bulat "M" + nama kontak + status (online/mengetik)
// - Bubble IN (bot): putih, tail kiri bawah, avatar kecil opsional
// - Bubble OUT (pengguna): electric biru, tail kanan bawah
// - Timestamp mono kecil di pojok bubble
// - Typing indicator: 3 titik melompat dengan tail
// - Animasi bubble masuk: slide-up + fade
---

<div class="site-chat" data-site-chat data-open="false">
  <!-- Panel dialog (di atas launcher) -->
  <section
    id="chat-panel-aria"
    class="chat-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Chat dengan asisten AI Mifdlal"
    aria-hidden="true"
  >
    <!-- Header: avatar + nama + status (gaya WhatsApp) -->
    <header class="chat-head">
      <div class="chat-avatar" aria-hidden="true">M</div>
      <div class="chat-contact">
        <span class="chat-name">Mifdlal Asisten</span>
        <span class="chat-status" data-chat-status>online</span>
      </div>
      <button class="chat-close" type="button" aria-label="Tutup chat">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
      </button>
    </header>

    <!-- Daftar pesan: role=log agar screen reader mengumumkan pesan baru -->
    <div class="chat-log" role="log" aria-label="Percakapan" aria-live="polite"></div>

    <!-- Input bar -->
    <form class="chat-form" autocomplete="off">
      <label class="sr-only" for="chat-field">Tulis pesan</label>
      <input
        id="chat-field"
        class="chat-input"
        type="text"
        name="message"
        placeholder="Ketik pesan..."
        maxlength="2000"
        enterkeyhint="send"
      />
      <button class="chat-send" type="submit" aria-label="Kirim pesan">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M2.5 8h10M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
      </button>
    </form>

    <span class="chat-status-sr sr-only" role="status" aria-live="polite"></span>
  </section>

  <!-- Launcher: tombol lingkaran blueprint di atas .to-top -->
  <button class="chat-launcher" type="button" aria-expanded="false" aria-controls="chat-panel-aria" aria-label="Buka chat asisten AI">
    <svg class="chat-launcher-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path
        d="M4 5.5h16v10.5H9.5L5.5 19.5v-3.5H4z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <circle cx="9" cy="11" r="1" fill="currentColor" />
      <circle cx="13" cy="11" r="1" fill="currentColor" />
      <circle cx="17" cy="11" r="1" fill="currentColor" />
    </svg>
    <span class="chat-badge-dot" aria-hidden="true"></span>
  </button>
</div>

<script is:inline src="/js/site-chat.js" defer></script>

<style>
  /* ============================================================
     POSISI: kolom tunggal rata dengan .to-top.
     - right sama persis dengan .to-top (var(--grid-gutter))
     - Launcher 44px = diameter .to-top -> pusat satu garis vertikal
     - bottom: 1.5rem (to-top) + 44px (to-top) + 12px gap = 5rem
     - --to-top-lift diisi :root oleh to-top.js -> keduanya naik
       bersama saat footer muncul, jarak 12px tetap konstan.
     ============================================================ */
  .site-chat {
    position: fixed;
    right: var(--grid-gutter);
    bottom: calc(5rem + env(safe-area-inset-bottom, 0px) + var(--to-top-lift, 0px));
    z-index: var(--z-raise);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    pointer-events: none;
  }

  .site-chat > * {
    pointer-events: auto;
  }

  /* sr-only: screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Launcher ─────────────────────────────────────────── */
  .chat-launcher {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    position: relative;
    display: grid;
    place-items: center;
    /* 44px = diameter .to-top: right sama -> pusat X identik,
       satu kolom vertikal sempurna. */
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--ink-900);
    color: var(--paper);
    border: 1px solid var(--ink-900);
    cursor: pointer;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--ink-900) 24%, transparent);
    transition:
      background-color var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }

  .chat-launcher:hover {
    background: var(--electric);
    border-color: var(--electric);
    transform: translateY(-1px);
  }

  .chat-launcher:focus-visible {
    outline: 2px solid var(--electric);
    outline-offset: 2px;
  }

  /* Dot status kanan-atas: lemon = online */
  .chat-badge-dot {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--lemon);
    border: 1px solid var(--ink-900);
    box-sizing: border-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chat-badge-dot {
      animation: chat-pulse 2.4s var(--ease) infinite;
    }
    @keyframes chat-pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(0.82); opacity: 0.75; }
    }
  }

  /* ── Panel ────────────────────────────────────────────── */
  .chat-panel {
    width: min(360px, calc(100vw - 2 * var(--grid-gutter)));
    max-height: min(540px, calc(100dvh - 7rem - env(safe-area-inset-bottom, 0px)));
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--ink-16);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--ink-900) 18%, transparent);
    overflow: hidden;
    /* Sembunyi default; data-open=true membuka */
    visibility: hidden;
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      visibility 0s linear var(--dur-base);
  }

  .site-chat[data-open='true'] .chat-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition:
      opacity var(--dur-enter) var(--ease-out),
      transform var(--dur-enter) var(--ease-out),
      visibility 0s linear 0s;
  }

  /* Corner bracket blueprint 2 sudut panel (kiri atas, kanan bawah) */
  .chat-panel::before,
  .chat-panel::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
    z-index: var(--z-content);
  }
  .chat-panel::before {
    top: -1px;
    left: -1px;
    border-top: 1.5px solid var(--electric);
    border-left: 1.5px solid var(--electric);
  }
  .chat-panel::after {
    bottom: -1px;
    right: -1px;
    border-bottom: 1.5px solid var(--electric);
    border-right: 1.5px solid var(--electric);
  }

  /* ── Header panel (gaya WhatsApp: avatar + nama + status) ── */
  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
    background: var(--ink-900);
    color: var(--paper);
    border-bottom: 1px solid var(--ink-16);
    flex-shrink: 0;
  }

  .chat-avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--electric);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 600;
    flex-shrink: 0;
    border: 1.5px solid color-mix(in srgb, var(--electric) 60%, var(--paper));
  }

  .chat-contact {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .chat-name {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--leading-ui);
    color: var(--paper);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chat-status {
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    color: color-mix(in srgb, var(--lemon) 85%, var(--paper));
    display: flex;
    align-items: center;
    gap: 0.3rem;
    line-height: var(--leading-ui);
  }

  /* Titik hijau di depan status "online" */
  .chat-status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--lemon);
    flex-shrink: 0;
  }

  /* Saat bot mengetik: dot berdenyut */
  .chat-status[data-typing='true']::before {
    animation: chat-status-pulse 1s var(--ease) infinite;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes chat-status-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.85); }
    }
  }

  .chat-close {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-left: auto;
    border-radius: 999px;
    background: transparent;
    color: var(--paper);
    border: none;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
    flex-shrink: 0;
  }

  .chat-close:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--paper) 15%, transparent);
  }

  .chat-close:focus-visible {
    outline: 2px solid var(--lemon);
    outline-offset: 1px;
  }

  /* ── Log pesan: wallpaper dot-grid + bubble ───────────── */
  .chat-log {
    flex: 1 1 auto;
    min-height: 180px;
    max-height: 340px;
    overflow-y: auto;
    padding: 0.875rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    background-color: var(--paper);
    background-image: radial-gradient(
      circle at 1px 1px,
      var(--ink-07) 1.2px,
      transparent 0
    );
    background-size: 22px 22px;
    overscroll-behavior: contain;
  }

  /* ── Row pesan: posisi + animasi masuk ────────────────── */
  /* :global() WAJIB: elemen dibuat dinamis via JS, tidak punya
     data-astro-cid -> scoped CSS biasa tidak akan cocok. */
  .site-chat :global(.chat-row) {
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
    max-width: 100%;
  }

  .site-chat :global(.chat-row--in) {
    justify-content: flex-start;
  }

  .site-chat :global(.chat-row--out) {
    justify-content: flex-end;
  }

  /* Animasi masuk: slide-up + fade (dinonaktifkan reduced-motion) */
  @media (prefers-reduced-motion: no-preference) {
    .site-chat :global(.chat-row) {
      animation: chat-row-in 0.28s var(--ease-out) both;
    }
  }

  /* Keyframes global — dipakai elemen dinamis, tidak boleh di-scope */
  :global {
    @keyframes chat-row-in {
      0% { opacity: 0; transform: translateY(6px); }
      100% { opacity: 1; transform: none; }
    }
  }

  /* ── Bubble ──────────────────────────────────────────── */
  .site-chat :global(.chat-bubble) {
    position: relative;
    max-width: min(240px, 78%);
    padding: 0.4375rem 0.625rem 0.375rem;
    font-size: var(--text-sm);
    line-height: var(--leading-base);
    word-break: break-word;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  /* Tanpa tail: semua sudut sama-sama rounded */
  .site-chat :global(.chat-bubble--in) {
    align-self: flex-start;
    background: var(--white);
    border: 1px solid var(--ink-16);
    border-radius: 0.75rem;
    color: var(--ink-900);
  }

  .site-chat :global(.chat-bubble--out) {
    align-self: flex-end;
    background: var(--electric);
    color: var(--paper);
    border-radius: 0.75rem;
  }

  /* Timestamp di dalam bubble, pojok bawah kanan, font mono */
  .site-chat :global(.chat-time) {
    display: inline-block;
    margin-left: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-cap);
    letter-spacing: var(--tracking-caps-tight);
    vertical-align: bottom;
    line-height: var(--leading-none);
    user-select: none;
    opacity: 0.7;
  }

  .site-chat :global(.chat-bubble--out .chat-time) {
    color: color-mix(in srgb, var(--paper) 85%, transparent);
  }

  /* ── Typing indicator (3 titik melompat, tanpa tail) ──── */
  .site-chat :global(.chat-typing) {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0.5rem 0.625rem 0.375rem;
    background: var(--white);
    border: 1px solid var(--ink-16);
    border-radius: 0.75rem;
    position: relative;
  }

  .site-chat :global(.chat-typing span) {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--ink-70);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-chat :global(.chat-typing span) {
      animation: chat-typing-bounce 1.2s infinite var(--ease);
    }
    .site-chat :global(.chat-typing span:nth-child(2)) { animation-delay: 0.15s; }
    .site-chat :global(.chat-typing span:nth-child(3)) { animation-delay: 0.3s; }
  }

  /* Keyframes global — dipakai elemen dinamis */
  :global {
    @keyframes chat-typing-bounce {
      0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
      30% { transform: translateY(-3px); opacity: 1; }
    }
  }

  /* ── Form + input ────────────────────────────────────── */
  .chat-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border-top: 1px solid var(--ink-16);
    background: var(--paper);
    flex-shrink: 0;
  }

  .chat-input {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    flex: 1 1 auto;
    min-width: 0;
    height: 38px;
    padding: 0 0.875rem;
    font-size: var(--text-sm);
    color: var(--ink-900);
    background: var(--white);
    border: 1px solid var(--ink-16);
    border-radius: 999px;
  }

  .chat-input::placeholder {
    color: var(--ink-70);
  }

  .chat-input:focus-visible {
    outline: 2px solid var(--electric);
    outline-offset: 1px;
  }

  .chat-input:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .chat-send {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    height: 38px;
    border-radius: 999px;
    background: var(--electric);
    color: var(--paper);
    border: 1px solid var(--electric);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease);
  }

  .chat-send:hover:not(:disabled) {
    background: color-mix(in srgb, var(--electric) 85%, var(--ink-900));
    border-color: color-mix(in srgb, var(--electric) 85%, var(--ink-900));
  }

  .chat-send:focus-visible {
    outline: 2px solid var(--ink-900);
    outline-offset: 2px;
  }

  .chat-send:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* ── Mobile ≤ 560px ──────────────────────────────────── */
  @media (max-width: 560px) {
    /* Tetap rata dengan .to-top: right sama, bottom 5rem sama. */
    .site-chat {
      right: var(--grid-gutter);
      bottom: calc(5rem + env(safe-area-inset-bottom, 0px) + var(--to-top-lift, 0px));
    }
    .chat-panel {
      width: min(calc(100vw - 2rem), 360px);
      max-height: min(480px, calc(100dvh - 7rem - env(safe-area-inset-bottom, 0px)));
    }
    .chat-bubble {
      max-width: 82%;
    }
  }
</style>
