---
import '../styles/global.css'
import SiteNav from '../components/SiteNav.astro'
import Wordmark from '../components/Wordmark.astro'
import Footer from '../components/Footer.astro'
import ToTop from '../components/ToTop.astro'
import SiteChat from '../components/SiteChat.astro'
import LenisScroll from '../components/LenisScroll.astro'

interface Props {
  title: string
  titleEn?: string
  description: string
  descriptionEn?: string
  /* Halaman non-indeks (mis. 404): keluar dari indeks mesin pencari dan
     jangan pasang canonical ke URL permintaan yang salah. */
  noindex?: boolean
}

const { title, titleEn, description, descriptionEn, noindex = false } = Astro.props
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Font: self-hosted via @fontsource (nol CDN eksternal, nol CSP hole) -->

    <!-- SEO dasar -->
    <title data-i18n-en={titleEn}>{title}</title>
    <meta name="description" content={description} data-i18n-meta={descriptionEn} />
    {!noindex && <link rel="canonical" href={Astro.url} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} data-i18n-meta={titleEn} />
    <meta property="og:description" content={description} data-i18n-meta={descriptionEn} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="Mifdlal Tsaqib Alfarras" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-i18n-meta={titleEn} />
    <meta name="twitter:description" content={description} data-i18n-meta={descriptionEn} />

    <!-- Favicon: monogram, dua versi warna mengikuti tema sistem.
         Latar transparan supaya menyatu dengan tab bar terang maupun gelap.
         Urutan: versi gelap dulu, versi terang terakhir, supaya peramban yang
         mengabaikan atribut media tetap memakai glyph hitam (default aman di
         tab bar terang). -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-light.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64-light.png" media="(prefers-color-scheme: light)" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Anti-FOUC tema: set data-theme sebelum paint pertama.
         light = tanpa atribut, dark = data-theme="dark",
         system = data-theme="system" (CSS media query yang memetakan). -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('mifdlal-prefs')
          var mode = 'system'
          if (s) {
            var p = JSON.parse(s)
            if (p.theme === 'light' || p.theme === 'dark' || p.theme === 'system') mode = p.theme
            if (p.lang === 'id' || p.lang === 'en') window.__mifdlalLang = p.lang
          }
          if (mode !== 'light') document.documentElement.setAttribute('data-theme', mode)
          document.documentElement.classList.add('js')
          /* Failsafe: kalau script reveal (motion) tidak sempat menandai
             elemen dalam 4 detik, cabut kelas js supaya konten tetap tampil. */
          setTimeout(function () {
            if (document.documentElement.dataset.riseReady !== '1') {
              document.documentElement.classList.remove('js')
            }
          }, 4000)
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link" data-i18n-en="Skip to content">Lewati ke konten</a>
    <SiteNav />
    <div class="page-track" data-track>
    <div class="page-layer" data-page>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="page-shadow" data-sheet-shadow aria-hidden="true"></div>
    </div>
    </div>
    <Wordmark />
    <ToTop />
    <SiteChat />
    <LenisScroll />
    <script is:inline src="/js/image-guard.js" defer></script>
    <script is:inline src="/js/reveal.js" defer></script>
    <script src="/js/i18n.js" defer></script>

    {/* Reveal saat scroll — Framer Motion. Astro membundel ini jadi modul
        eksternal ('self'), jadi aman terhadap CSP ketat. Tiap elemen .rise
        dianimasikan HANYA saat ±separuh masuk viewport, sekali saja, lalu
        inline style dibersihkan supaya hover CSS elemen tetap hidup. */}
    <script>
      import { animate, inView } from 'motion'

      const root = document.documentElement

      /* Tandai siap lebih dulu: failsafe di <head> hanya mencabut kelas js
         kalau script ini benar-benar gagal dimuat/di-setup. */
      const done = (el: HTMLElement) => {
        el.style.removeProperty('opacity')
        el.style.removeProperty('transform')
        el.style.removeProperty('translate')
        el.style.removeProperty('scale')
        el.style.removeProperty('left')
        el.style.removeProperty('top')
        el.style.removeProperty('clipPath')
        el.classList.add('is-in')
      }

      try {
        const els = Array.from(document.querySelectorAll<HTMLElement>('.rise'))
        root.dataset.riseReady = '1'

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        if (reduce) {
          els.forEach(done)
        } else {
          const FROM: Record<string, Record<string, number | string>> = {
            up: { y: 34 },
            left: { x: -30 },
            right: { x: 30 },
            scale: { scale: 0.93 },
            wipe: { clipPath: 'inset(0 100% 0 0)' },
          }

          els.forEach((el) => {
            const variant = el.dataset.rise || 'up'
            const from = FROM[variant] ?? FROM.up
            const raw = getComputedStyle(el).getPropertyValue('--rise-delay')
            const delay = (parseFloat(raw) || 0) / 1000

            /* Ambang trigger adaptif: elemen kecil menunggu ±separuh tampil,
               elemen tinggi (lebih tinggi dari viewport) menunggu ±75% tinggi
               viewport supaya tetap "kelihatan penuh dulu" sebelum beranimasi
               dan tidak pernah gagal trigger. */
            const vh = window.innerHeight
            const h = el.getBoundingClientRect().height || 1
            const amount = Math.max(0.2, Math.min(0.5, (vh * 0.75) / h))

            /* Keyframes: nilai awal -> nilai akhir. */
            const to: Record<string, unknown> = { opacity: [0, 1] }
            for (const [key, value] of Object.entries(from)) {
              if (typeof value === 'number') to[key] = [value, key === 'scale' ? 1 : 0]
              else to[key] = [value, variant === 'wipe' ? 'inset(0 0 0 0)' : value]
            }

            let played = false
            let stop: () => void = () => {}
            stop = inView(
              el,
              () => {
                if (played) return
                played = true
                animate(el, to as never, {
                  duration: 0.75,
                  delay,
                  ease: [0.22, 0.61, 0.36, 1],
                  onComplete: () => {
                    /* Motion menulis gaya akhir ke inline style SETELAH
                       onComplete; bersihkan di frame berikut supaya hover CSS
                       elemen tidak tertutup inline transform:motion. */
                    window.requestAnimationFrame(() => window.requestAnimationFrame(() => done(el)))
                    stop()
                  },
                })
              },
              { amount, margin: '0px 0px -8% 0px' },
            )
          })
        }
      } catch {
        /* Gagal setup: cabut kelas js supaya semua konten tampil. */
        root.classList.remove('js')
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: var(--z-skip);
    padding: 0.75rem 1rem;
    background: var(--color-ink);
    color: var(--color-lemon);
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    font-weight: 600;
    text-transform: none;
  }
  .skip-link:focus {
    left: 0;
  }
</style>
