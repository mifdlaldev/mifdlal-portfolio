---
import '../styles/global.css'
import SiteNav from '../components/SiteNav.astro'
import Wordmark from '../components/Wordmark.astro'
import Footer from '../components/Footer.astro'
import ToTop from '../components/ToTop.astro'
import SiteChat from '../components/SiteChat.astro'
import LenisScroll from '../components/LenisScroll.astro'
import { contact, services, stack } from '../data/site'

interface Props {
  title: string
  titleEn?: string
  description: string
  descriptionEn?: string
  /* Halaman non-indeks (mis. 404): keluar dari indeks mesin pencari dan
     jangan pasang canonical ke URL permintaan yang salah. */
  noindex?: boolean
  /* Halaman rute dalam (detail proyek/layanan): simpul JSON-LD tambahan
     disuntikkan ke @graph supaya mesin pencari membaca entitas halaman. */
  jsonLdExtra?: readonly Record<string, unknown>[]
  /* Halaman minimal (mis. 404): hanya navbar dan isi halaman. Footer,
     wordmark, tombol ke atas, dan widget chat tidak dirender; skrip gerak
     dan Lenis juga tidak dimuat. Latar jadi bidang rata tanpa dot grid
     dan tanpa bingkai blueprint. */
  minimal?: boolean
}

const {
  title,
  titleEn,
  description,
  descriptionEn,
  noindex = false,
  jsonLdExtra = [],
  minimal = false,
} = Astro.props

/* Satu sumber kebenaran untuk schema: semua nilai diambil dari data situs,
   tidak ada yang diketik ulang dari ingatan.
   - name/url/email/sameAs/address: src/data/site.ts (contact) dan teks halaman
     yang sudah live (Bandung, ID).
   - sameAs: Fiverr sengaja tidak dimasukkan; tautannya ada di situs tetapi
     keberadaan profil itu belum bisa diverifikasi, jadi jangan diklaim.
   - knowsAbout: nama layanan + nama teknologi dari data situs. */
const SITE = 'https://mifdlal.com/'
const OG_IMAGE = `${SITE}og-image.png`
const PERSON_ID = `${SITE}#person`

/* URL kanonik halaman ini. Beranda = SITE; rute dalam (mis. /proyek/) =
   URL halaman itu sendiri, tanpa query. Dipakai schema + og:url. */
const isHome = Astro.url.pathname === '/'
const PAGE_HREF = new URL(Astro.url.pathname, SITE).href

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Mifdlal Tsaqib Alfarras',
      url: SITE,
      email: `mailto:${contact.email}`,
      jobTitle: 'Freelance web developer dan spesialis otomasi AI',
      sameAs: contact.socials.filter((s) => s.id !== 'fiverr').map((s) => s.href),
      knowsAbout: [...services.map((s) => s.title), ...stack.map((s) => s.name)],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Bandung',
        addressCountry: 'ID',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}#website`,
      url: SITE,
      name: 'Mifdlal Tsaqib Alfarras',
      inLanguage: ['id', 'en'],
      publisher: { '@id': PERSON_ID },
    },
    ...(isHome
      ? [
          {
            '@type': 'ProfilePage',
            '@id': `${SITE}#webpage`,
            url: SITE,
            name: title,
            description,
            inLanguage: 'id',
            isPartOf: { '@id': `${SITE}#website` },
            mainEntity: { '@id': PERSON_ID },
            primaryImageOfPage: {
              '@type': 'ImageObject',
              url: OG_IMAGE,
              width: 1200,
              height: 630,
            },
          },
        ]
      : [
          {
            '@type': 'WebPage',
            '@id': `${PAGE_HREF}#webpage`,
            url: PAGE_HREF,
            name: title,
            description,
            inLanguage: 'id',
            isPartOf: { '@id': `${SITE}#website` },
            about: { '@id': PERSON_ID },
            primaryImageOfPage: {
              '@type': 'ImageObject',
              url: OG_IMAGE,
              width: 1200,
              height: 630,
            },
          },
        ]),
    ...services.map((s) => ({
      '@type': 'Service',
      name: s.title,
      description: s.body,
      serviceType: s.title,
      url: `${SITE}layanan/${s.slug}/`,
      areaServed: { '@type': 'Country', name: 'Indonesia' },
      provider: { '@id': PERSON_ID },
    })),
    ...jsonLdExtra,
  ],
})
---

<!doctype html>
<html lang="id" class={minimal ? 'page-minimal' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    {/* Google Tag Manager: container GTM-T4TCVQP8.
        Bootstrap GTM standar (bukan pola gtag.js) supaya dataLayer menerima
        event 'gtm.start' dan trigger Initialization jalan benar.
        is:inline wajib: hash sha256 script ini dihitung scripts/csp-hash.mjs
        saat postbuild dan disuntik ke CSP, sehingga CSP tetap tanpa
        'unsafe-inline'.

        DIMUAT SETELAH INTERAKSI (diminta performa): bootstrap asli berjalan di
        <head> dan gtm.js-nya mengeksekusi 2 long task (280 + 253 ms pada trace
        mobile) yang menahan cat elemen LCP. Sekarang container dimuat pada
        interaksi pertama (scroll, sentuh, klik, tombol) atau paling lambat
        8 detik setelah load, supaya pageview tetap tercatat untuk pengunjung
        yang benar-benar membaca, tetapi main thread tidak direbut saat paint
        pertama. Untuk memaksa perilaku lama (selalu saat load), ganti blok
        arm() di bawah dengan pemanggilan start() langsung. */}
    <script is:inline>
      ;(function (w, d, s, l, i) {
        var fired = false
        var start = function () {
          if (fired) return
          fired = true
          w[l] = w[l] || []
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : ''
          j.async = true
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
          f.parentNode.insertBefore(j, f)
        }
        var events = ['pointerdown', 'keydown', 'touchstart', 'wheel', 'scroll']
        var arm = function () {
          for (var k = 0; k < events.length; k++)
            w.addEventListener(events[k], start, { passive: true, once: true })
          w.setTimeout(start, 8000)
        }
        if (d.readyState === 'complete') arm()
        else w.addEventListener('load', arm, { once: true })
      })(window, document, 'script', 'dataLayer', 'GTM-T4TCVQP8')
    </script>

    <!-- Font: self-hosted via @fontsource (nol CDN eksternal, nol CSP hole) -->

    <!-- SEO dasar -->
    <title data-i18n-en={titleEn}>{title}</title>
    <meta name="description" content={description} data-i18n-meta={descriptionEn} />
    {!noindex && <link rel="canonical" href={Astro.url} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    {/* Schema.org JSON-LD. Tipe application/ld+json tidak dieksekusi
        peramban, jadi tidak butuh hash CSP. Halaman noindex tidak memasang
        schema karena tidak ada yang perlu diindeks. */}
    {!noindex && <script type="application/ld+json" set:html={jsonld} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} data-i18n-meta={titleEn} />
    <meta property="og:description" content={description} data-i18n-meta={descriptionEn} />
    <meta property="og:url" content={PAGE_HREF} />
    <meta property="og:site_name" content="Mifdlal Tsaqib Alfarras" />
    {/* og:image wajib absolut. Kartunya digambar ulang dari palet dan fonta
        situs sendiri lewat scripts/og-image.mjs, bukan berkas stok. */}
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Kartu mifdlal.com: nama Mifdlal Tsaqib Alfarras, web app, chatbot, dan otomasi alur kerja."
      data-i18n-meta="mifdlal.com card: Mifdlal Tsaqib Alfarras, web app, chatbot, and workflow automation."
    />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-i18n-meta={titleEn} />
    <meta name="twitter:description" content={description} data-i18n-meta={descriptionEn} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta
      name="twitter:image:alt"
      content="Kartu mifdlal.com: nama Mifdlal Tsaqib Alfarras, web app, chatbot, dan otomasi alur kerja."
      data-i18n-meta="mifdlal.com card: Mifdlal Tsaqib Alfarras, web app, chatbot, and workflow automation."
    />

    <!-- Favicon: monogram, dua versi warna mengikuti tema sistem.
         Latar transparan supaya menyatu dengan tab bar terang maupun gelap.
         Urutan: versi gelap dulu, versi terang terakhir, supaya peramban yang
         mengabaikan atribut media tetap memakai glyph hitam (default aman di
         tab bar terang). -->
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32-dark.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="64x64"
      href="/favicon-64-dark.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32-light.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="64x64"
      href="/favicon-64-light.png"
      media="(prefers-color-scheme: light)"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {/* /favicon.ico diambil otomatis oleh peramban dan Googlebot-Image tanpa
        melihat deklarasi di atas (12 permintaan tercatat di edge, semuanya 404).
        Berkas ini membawa 48, 32, dan 16 px dalam satu ICO. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />

    <!-- Anti-FOUC tema: set data-theme sebelum paint pertama.
         light = tanpa atribut, dark = data-theme="dark",
         system = data-theme="system" (CSS media query yang memetakan). -->
    <script is:inline>
      ;(function () {
        try {
          var s = localStorage.getItem('mifdlal-prefs')
          var mode = 'system'
          if (s) {
            var p = JSON.parse(s)
            if (p.theme === 'light' || p.theme === 'dark' || p.theme === 'system') mode = p.theme
            if (p.lang === 'id' || p.lang === 'en') window.__mifdlalLang = p.lang
          }
          if (mode !== 'light') document.documentElement.setAttribute('data-theme', mode)
          document.documentElement.classList.add('js')
          /* Failsafe: kalau script reveal (motion) tidak sempat menandai
             elemen dalam 4 detik, cabut kelas js supaya konten tetap tampil. */
          setTimeout(function () {
            if (document.documentElement.dataset.riseReady !== '1') {
              document.documentElement.classList.remove('js')
            }
          }, 4000)
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    {/* Fallback GTM untuk pengunjung tanpa JavaScript. Ukuran nol, tak terlihat,
        butuh googletagmanager.com di frame-src (sudah ditambahkan). */}
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-T4TCVQP8"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <a href="#main" class="skip-link" data-i18n-en="Skip to content">
      Lewati ke konten
    </a>
    <SiteNav />
    {minimal ? (
      <>
        <main id="main" class="minimal-main">
          <slot />
        </main>
        {/* Halaman minimal tetap memuat runtime bahasa+tema supaya bahasa
            yang sudah dipilih pengunjung berlaku juga di sini; tanpa ini 404
            selalu tampil Indonesia dan jadi tidak konsisten. */}
        <script src="/js/i18n.js" defer></script>
      </>
    ) : (
      <>
        <div class="page-track" data-track>
          <div class="page-layer" data-page>
            <main id="main">
              <slot />
            </main>
            <Footer />
            <div class="page-shadow" data-sheet-shadow aria-hidden="true"></div>
          </div>
        </div>
        <Wordmark />
        <ToTop />
        <SiteChat />
        <LenisScroll />
        <script is:inline src="/js/image-guard.js" defer></script>
        <script is:inline src="/js/reveal.js" defer></script>
        <script src="/js/i18n.js" defer></script>

        {/* Reveal saat scroll — Framer Motion. Astro membundel ini jadi modul
            eksternal ('self'), jadi aman terhadap CSP ketat. Tiap elemen .rise
            dianimasikan HANYA saat ±separuh masuk viewport, sekali saja, lalu
            inline style dibersihkan supaya hover CSS elemen tetap hidup. */}
        <script>
          import { animate, inView } from 'motion'

          const root = document.documentElement

          /* Tandai siap lebih dulu: failsafe di <head> hanya mencabut kelas js
             kalau script ini benar-benar gagal dimuat/di-setup. */
          const done = (el: HTMLElement) => {
            el.style.removeProperty('opacity')
            el.style.removeProperty('transform')
            el.style.removeProperty('translate')
            el.style.removeProperty('scale')
            el.style.removeProperty('left')
            el.style.removeProperty('top')
            el.style.removeProperty('clipPath')
            el.classList.add('is-in')
          }

          try {
            const els = Array.from(document.querySelectorAll<HTMLElement>('.rise'))
            root.dataset.riseReady = '1'

            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

            if (reduce) {
              els.forEach(done)
            } else {
              const FROM: Record<string, Record<string, number | string>> = {
                up: { y: 34 },
                left: { x: -30 },
                right: { x: 30 },
                scale: { scale: 0.93 },
                wipe: { clipPath: 'inset(0 100% 0 0)' },
              }

              els.forEach((el) => {
                const variant = el.dataset.rise || 'up'
                const from = FROM[variant] ?? FROM.up
                const raw = getComputedStyle(el).getPropertyValue('--rise-delay')
                const delay = (parseFloat(raw) || 0) / 1000

                /* Ambang trigger adaptif: elemen kecil menunggu ±separuh tampil,
                   elemen tinggi (lebih tinggi dari viewport) menunggu ±75% tinggi
                   viewport supaya tetap "kelihatan penuh dulu" sebelum beranimasi
                   dan tidak pernah gagal trigger. */
                const vh = window.innerHeight
                const h = el.getBoundingClientRect().height || 1
                const amount = Math.max(0.2, Math.min(0.5, (vh * 0.75) / h))

                /* Keyframes: nilai awal -> nilai akhir. */
                const to: Record<string, unknown> = { opacity: [0, 1] }
                for (const [key, value] of Object.entries(from)) {
                  if (typeof value === 'number') to[key] = [value, key === 'scale' ? 1 : 0]
                  else to[key] = [value, variant === 'wipe' ? 'inset(0 0 0 0)' : value]
                }

                let played = false
                let stop: () => void = () => {}
                stop = inView(
                  el,
                  () => {
                    if (played) return
                    played = true
                    animate(el, to as never, {
                      duration: 0.75,
                      delay,
                      ease: [0.22, 0.61, 0.36, 1],
                      onComplete: () => {
                        /* Motion menulis gaya akhir ke inline style SETELAH
                           onComplete; bersihkan di frame berikut supaya hover CSS
                           elemen tidak tertutup inline transform:motion. */
                        window.requestAnimationFrame(() =>
                          window.requestAnimationFrame(() => done(el))
                        )
                        stop()
                      },
                    })
                  },
                  { amount, margin: '0px 0px -8% 0px' }
                )
              })
            }
          } catch {
            /* Gagal setup: cabut kelas js supaya semua konten tampil. */
            root.classList.remove('js')
          }
        </script>
      </>
    )}
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: var(--z-skip);
    padding: 0.75rem 1rem;
    background: var(--color-ink);
    color: var(--color-lemon);
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    font-weight: 600;
    text-transform: none;
  }
  .skip-link:focus {
    left: 0;
  }

  /* ── Halaman minimal (404) ────────────────────────────────────────────
     Bidang rata putih, tanpa dot grid halaman, tanpa bayangan lapis, dan
     tanpa bingkai blueprint section. Navbar tetap: di sini ia berdiri di
     atas latar terang, jadi memakai state bawaan (teks ink, logo hitam). */
  :global(.page-minimal) {
    /* Permukaan diarahkan ke putih murni. Navbar memakai --color-paper,
       jadi ikut putih tanpa jahitan warna di bawahnya. Di tema gelap
       --color-white sudah memetakan ke permukaan gelap, jadi halaman tetap
       terbaca di mode gelap. */
    --color-paper: var(--color-white);
    background-image: none;
  }

  :global(.page-minimal) body {
    background-image: none;
    /* Navbar tetap, jadi isi perlu ruang setinggi navbar. */
    padding-block-start: var(--nav-h);
  }

  :global(.page-minimal .minimal-main) {
    /* Ruang isi = viewport dikurangi navbar; isi dipusatkan tegak. */
    min-height: calc(100dvh - var(--nav-h));
    display: grid;
    align-content: center;
  }

  :global(.page-minimal .section) {
    background-image: none;
    /* Pita dan bingkai dimatikan, jadi jarak section tidak diperlukan;
       jarak datang dari .error-wrap di halaman 404. */
    padding-block: 0;
  }

  :global(.page-minimal .section)::before,
  :global(.page-minimal .section)::after,
  :global(.page-minimal .section > .wrap)::before,
  :global(.page-minimal .section > .wrap)::after {
    display: none;
  }
</style>
