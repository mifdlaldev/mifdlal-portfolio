---
import Layout from '../../layouts/Layout.astro'
import RouteHero from '../../components/RouteHero.astro'
import { services, serviceSteps } from '../../data/site'

/* Halaman detail satu layanan. Isi diambil dari src/data/site.ts:
   cakupan layanan dari KONTEN.md, alur kerja dari serviceSteps. */

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }))
}

const { service: s } = Astro.props
const url = `https://mifdlal.com/layanan/${s.slug}/`

const jsonLdExtra = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: s.title,
    description: s.body,
    serviceType: s.title,
    url,
    inLanguage: ['id', 'en'],
    areaServed: { '@type': 'Country', name: 'Indonesia' },
    provider: { '@id': 'https://mifdlal.com/#person' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: s.title,
      itemListElement: s.covers.map((c) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: c },
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://mifdlal.com/' },
      { '@type': 'ListItem', position: 2, name: 'Layanan', item: 'https://mifdlal.com/layanan/' },
      { '@type': 'ListItem', position: 3, name: s.title, item: url },
    ],
  },
]
---

<Layout
  title={`${s.title} | Layanan | Mifdlal Tsaqib Alfarras`}
  titleEn={`${s.titleEn} | Services | Mifdlal Tsaqib Alfarras`}
  description={`${s.body} Remote dari Bandung.`}
  descriptionEn={`${s.bodyEn} Remote from Bandung.`}
  jsonLdExtra={jsonLdExtra}
>
  <RouteHero
    fig={`fig. 11.${s.no} · layanan / ${s.slug}`}
    figEn={`fig. 11.${s.no} · services / ${s.slug}`}
    title={s.title}
    titleEn={s.titleEn}
    lead={s.body}
    leadEn={s.bodyEn}
    crumbs={[
      { label: 'Beranda', labelEn: 'Home', href: '/' },
      { label: 'Layanan', labelEn: 'Services', href: '/layanan/' },
      { label: s.title, labelEn: s.titleEn, href: url },
    ]}
  />

  <section class="section detail">
    <div class="wrap detail-grid">
      <figure class="shot rise" data-rise="scale">
        <img
          src={s.image}
          width="1280"
          height="757"
          alt={`Ilustrasi layanan ${s.no}: ${s.title}`}
          loading="eager"
          decoding="async"
          draggable="false"
        />
      </figure>

      <div class="covers rise">
        <p class="covers-label" data-i18n-en="Covers">
          Cakupan
        </p>
        <ul class="cover-list">
          {s.covers.map((c, i) => (
            <li class="cover-item">
              <span class="cover-no" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span data-i18n-en={s.coversEn[i]}>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section detail-steps">
    <div class="wrap">
      <h2 class="section-headline rise" data-i18n-en="How the work runs">
        Cara kerjanya
      </h2>
      <ol class="step-list">
        {serviceSteps.map((st, i) => (
          <li class="step rise" data-rise="left" style={`--rise-delay:${i * 80}ms`}>
            <span class="step-no" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="step-label" data-i18n-en={st.labelEn}>
              {st.label}
            </span>
          </li>
        ))}
      </ol>

      <nav class="back rise" aria-label="Navigasi layanan" data-i18n-aria="Service navigation">
        <a href="/layanan/" class="btn btn-ghost" data-i18n-en="All services">
          Semua layanan
        </a>
        <a href="/#kontak" class="btn btn-primary" data-i18n-en="Discuss your project">
          Diskusikan proyek
        </a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .shot {
    margin: 0;
    border: 1px solid var(--color-line);
    background: var(--color-line-soft);
    overflow: hidden;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .covers-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    color: var(--color-muted);
  }

  .cover-list {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .cover-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--color-ink);
  }

  .cover-no,
  .step-no {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps-loose);
    color: var(--color-electric);
  }

  .step-list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
    counter-reset: step;
  }

  .step {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .step-label {
    font-family: var(--font-display);
    font-size: var(--text-title-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-title);
    color: var(--color-ink);
  }

  .back {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (min-width: 860px) {
    .detail-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
</style>
