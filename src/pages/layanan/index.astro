---
import Layout from '../../layouts/Layout.astro'
import RouteHero from '../../components/RouteHero.astro'
import { services } from '../../data/site'

const jsonLdExtra = [
  {
    '@type': 'CollectionPage',
    '@id': 'https://mifdlal.com/layanan/#page',
    name: 'Layanan',
    url: 'https://mifdlal.com/layanan/',
    inLanguage: ['id', 'en'],
    isPartOf: { '@id': 'https://mifdlal.com/#website' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://mifdlal.com/' },
      { '@type': 'ListItem', position: 2, name: 'Layanan', item: 'https://mifdlal.com/layanan/' },
    ],
  },
]
---

<Layout
  title="Layanan | Mifdlal Tsaqib Alfarras"
  titleEn="Services | Mifdlal Tsaqib Alfarras"
  description="Tiga layanan: website dan web app, chatbot, serta otomasi AI dan workflow. Remote dari Bandung."
  descriptionEn="Three services: websites and web apps, chatbots, and AI automation and workflow. Remote from Bandung."
  jsonLdExtra={jsonLdExtra}
>
  <RouteHero
    fig="fig. 11 · layanan"
    figEn="fig. 11 · services"
    title="Yang dapat saya kerjakan."
    titleEn="What I can build for you."
    lead="Tiga jalur, satu cara kerja. Pilih yang paling dekat dengan kebutuhan Anda, lalu ceritakan masalahnya."
    leadEn="Three tracks, one way of working. Pick the closest to your needs, then describe the problem."
    crumbs={[
      { label: 'Beranda', labelEn: 'Home', href: '/' },
      { label: 'Layanan', labelEn: 'Services', href: '/layanan/' },
    ]}
  />

  <section class="section service-index-section">
    <div class="wrap">
      <ul class="service-index">
        {services.map((s, i) => (
          <li
            class={`service-index-row${i === 0 ? '' : ' rise'}`}
            data-rise="up"
            style={`--rise-delay:${i * 90}ms`}
          >
            <a href={`/layanan/${s.slug}/`} class="service-index-link">
              <span class="service-index-no" aria-hidden="true">
                {s.no}
              </span>
              <span class="service-index-title" data-i18n-id={s.title}>
                {s.titleEn}
              </span>
              <span class="service-index-desc" data-i18n-id={s.body}>
                {s.bodyEn}
              </span>
              <span class="service-index-more">
                <span data-i18n-id="Detail">Details</span>
                <span class="service-index-arrow" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <nav class="back rise" aria-label="Page navigation" data-i18n-aria-id="Navigasi halaman">
        <a href="/proyek/" class="btn btn-ghost" data-i18n-id="Proyek">
          Work
        </a>
        <a href="/#kontak" class="btn btn-primary" data-i18n-id="Diskusikan proyek">
          Discuss your project
        </a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .service-index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .service-index-row {
    border-bottom: 1px solid var(--color-line);
  }

  .service-index-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    /* Area dasar (mobile): satu kolom bertumpuk. Tanpa ini, grid-area bernama
       di anak-anak membuat garis implisit dan kolom hantu 0px. */
    grid-template-areas:
      'no'
      'title'
      'desc'
      'more';
    gap: 0.75rem;
    padding: 2rem 0;
    color: inherit;
    text-decoration: none;
    transition: box-shadow var(--dur-fast) var(--ease);
  }

  /* Hover: garis aksen kiri, bukan latar abu penuh. box-shadow inset supaya
     tidak menggeser tata letak seperti border. Garis menempel di tepi baris,
     jadi jarak ke teks datang dari padding kiri baris. */
  .service-index-link:hover {
    box-shadow: inset 2px 0 0 0 var(--color-electric);
  }

  .service-index-link:focus-visible {
    outline: 2px solid var(--color-electric);
    outline-offset: 2px;
  }

  /* Nomor sebagai eyebrow di atas judul, membentang penuh satu baris grid
     supaya judul, deskripsi, dan label Detail mulai dari garis atas sama. */
  .service-index-no {
    grid-area: no;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps-loose);
    color: var(--color-electric);
  }

  .service-index-title {
    grid-area: title;
    min-width: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    color: var(--color-ink);
    text-wrap: balance;
  }

  .service-index-desc {
    grid-area: desc;
    max-width: 62ch;
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .service-index-more {
    grid-area: more;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    letter-spacing: var(--tracking-caps-tight);
    text-transform: uppercase;
    color: var(--color-electric);
    white-space: nowrap;
  }

  .service-index-arrow {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease);
  }

  .service-index-link:hover .service-index-arrow,
  .service-index-link:focus-visible .service-index-arrow {
    transform: translateX(0.15rem);
  }

  /* Tablet: judul sebaris dengan label Detail, deskripsi selebar baris penuh.
     Desktop (900px+): judul, deskripsi, dan Detail dalam satu baris.
     Padding kiri-kanan baris dihitung supaya sumbu teks tetap 3rem dari tepi
     dalam bingkai: hero dan tombol bawah ikut disisipi nilai yang sama, jadi
     teks judul halaman, teks baris, dan tombol berdiri di satu garis. */
  @media (min-width: 720px) {
    .service-index-link {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'no    no'
        'title more'
        'desc  desc';
      align-items: start;
      column-gap: 2rem;
      row-gap: 0.5rem;
      padding-inline: calc(3rem - var(--grid-gutter));
    }

    .service-index-more {
      justify-self: end;
    }

    :global(section.route-head .wrap) {
      padding-inline: 3rem;
    }

    .back {
      padding-inline: calc(3rem - var(--grid-gutter));
    }
  }

  @media (min-width: 900px) {
    .service-index-link {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) auto;
      grid-template-areas:
        'no    no    no'
        'title desc  more';
    }
  }

  /* 720-1228px gutter .wrap naik ke --wrap-gutter-tablet 36px, jadi sisipan
     baris menyesuaikan supaya totalnya tetap 3rem dari tepi dalam bingkai. */
  @media (min-width: 720px) and (max-width: 1228px) {
    .service-index-link,
    .back {
      padding-inline: calc(3rem - var(--wrap-gutter-tablet));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-index-link,
    .service-index-arrow {
      transition: none;
    }

    .service-index-link:hover .service-index-arrow {
      transform: none;
    }
  }

  .back {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* Ritme halaman: jarak lead hero ke baris pertama dipangkas dari 225px
     jadi 161px. Yang diubah hanya padding atas section daftar (64px); 64px
     lain dari padding bawah hero dan 32px dari padding atas .wrap. Ritme
     section global tetap, dan halaman ini tidak memakai pita komentar
     antarsection. */
  .service-index-section {
    padding-block-start: clamp(3rem, 4.6vw, 4rem);
  }

  /* Hero rute layanan: judul halaman ini butuh tingkat di atas judul baris
     (--text-h3). Token --text-h1 dipakai khusus di sini; rute lain tetap
     memakai --text-h2 lewat .section-headline. Lead diturunkan supaya
     selisih judul dan lead tidak lagi 1.48:1. */
  :global(section.route-head .route-title) {
    max-width: 20ch;
    font-size: var(--text-h1);
  }

  :global(section.route-head .route-lead) {
    max-width: 54ch;
    font-size: var(--text-title-sm);
  }
</style>
