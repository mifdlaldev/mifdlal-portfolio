---
import Layout from '../../layouts/Layout.astro'
import RouteHero from '../../components/RouteHero.astro'
import { projects } from '../../data/site'

/* Halaman detail satu proyek. Semua isi diambil dari src/data/site.ts:
   tidak ada klaim baru di luar yang sudah ada di beranda. */

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }))
}

const { project: p } = Astro.props
const url = `https://mifdlal.com/proyek/${p.slug}/`

const jsonLdExtra = [
  {
    '@type': 'CreativeWork',
    '@id': `${url}#work`,
    name: p.name,
    description: p.description,
    url,
    inLanguage: ['id', 'en'],
    creator: { '@id': 'https://mifdlal.com/#person' },
    keywords: p.stack.join(', '),
    image: `https://mifdlal.com${p.image}`,
    ...(p.live ? { sameAs: p.live } : {}),
    ...(p.repo ? { codeRepository: p.repo } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://mifdlal.com/' },
      { '@type': 'ListItem', position: 2, name: 'Proyek', item: 'https://mifdlal.com/proyek/' },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
]
---

<Layout
  title={`${p.name} | Proyek | Mifdlal Tsaqib Alfarras`}
  titleEn={`${p.nameEn || p.name} | Work | Mifdlal Tsaqib Alfarras`}
  description={`${p.role}: ${p.description} Tautan live dapat dibuka langsung.`}
  descriptionEn={`${p.roleEn || p.role}: ${p.descriptionEn || p.description} The live link opens directly.`}
  jsonLdExtra={jsonLdExtra}
>
  <RouteHero
    fig={`fig. 10.${p.no} · proyek / ${p.slug}`}
    figEn={`fig. 10.${p.no} · work / ${p.slug}`}
    title={p.name}
    titleEn={p.nameEn || p.name}
    lead={p.description}
    leadEn={p.descriptionEn}
    crumbs={[
      { label: 'Beranda', labelEn: 'Home', href: '/' },
      { label: 'Proyek', labelEn: 'Work', href: '/proyek/' },
      { label: p.name, labelEn: p.nameEn || p.name, href: url },
    ]}
  />

  <section class="section detail">
    <div class="wrap detail-grid">
      <figure class="shot">
        <img
          src={p.image}
          width="1000"
          height="563"
          alt={`Tampilan ${p.name}`}
          fetchpriority="high"
          loading="eager"
          decoding="async"
          draggable="false"
        />
      </figure>

      <div class="meta rise">
        <ul class="spec-list">
          <li>
            <span class="spec-k" data-i18n-en="Role">
              Peran
            </span>
            <span class="spec-v" data-i18n-en={p.roleEn}>
              {p.role}
            </span>
          </li>
          <li>
            <span class="spec-k" data-i18n-en="Stack">
              Stack
            </span>
            <span class="spec-v" data-i18n-en={p.stackEn?.join(' · ')}>
              {p.stack.join(' · ')}
            </span>
          </li>
          <li>
            <span class="spec-k" data-i18n-en="Status">
              Status
            </span>
            <span class="spec-v live" data-i18n-en="live, opens in a new tab">
              live, buka di tab baru
            </span>
          </li>
        </ul>

        <div class="actions">
          <a
            href={p.live}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
            data-i18n-en="Open website"
          >
            Buka situs
            <span aria-hidden="true">↗</span>
          </a>
          {p.repo && (
            <a
              href={p.repo}
              class="btn btn-ghost"
              target="_blank"
              rel="noopener noreferrer"
              data-i18n-en="Source code"
            >
              Kode sumber
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section detail-points">
    <div class="wrap">
      <h2 class="section-headline rise" data-i18n-en="What this project covers">
        Isi proyek ini
      </h2>
      <ul class="point-list">
        {p.highlights.map((h, i) => (
          <li class="point rise" data-rise="left" style={`--rise-delay:${i * 80}ms`}>
            <span class="point-no" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span data-i18n-en={p.highlightsEn[i]}>{h}</span>
          </li>
        ))}
      </ul>

      <nav class="back rise" aria-label="Navigasi proyek" data-i18n-aria="Project navigation">
        <a href="/proyek/" class="btn btn-ghost" data-i18n-en="All projects">
          Semua proyek
        </a>
        <a href="/#kontak" class="btn btn-primary" data-i18n-en="Start a project like this">
          Mulai proyek seperti ini
        </a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .shot {
    margin: 0;
    border: 1px solid var(--color-line);
    background: var(--color-line-soft);
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .spec-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .spec-list li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .spec-k {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    color: var(--color-muted);
  }

  .spec-v {
    font-family: var(--font-mono);
    font-size: var(--text-data);
    color: var(--color-ink);
  }

  .spec-v.live {
    color: var(--color-electric);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .point-list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .point {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--color-ink);
  }

  .point-no {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps-loose);
    color: var(--color-electric);
  }

  .back {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (min-width: 860px) {
    .detail-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
</style>
