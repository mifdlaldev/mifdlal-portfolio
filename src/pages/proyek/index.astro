---
import Layout from '../../layouts/Layout.astro'
import RouteHero from '../../components/RouteHero.astro'
import { projects } from '../../data/site'

const jsonLdExtra = [
  {
    '@type': 'CollectionPage',
    '@id': 'https://mifdlal.com/proyek/#page',
    name: 'Proyek',
    url: 'https://mifdlal.com/proyek/',
    inLanguage: ['id', 'en'],
    isPartOf: { '@id': 'https://mifdlal.com/#website' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://mifdlal.com/' },
      { '@type': 'ListItem', position: 2, name: 'Proyek', item: 'https://mifdlal.com/proyek/' },
    ],
  },
]
---

<Layout
  title="Proyek | Mifdlal Tsaqib Alfarras"
  titleEn="Work | Mifdlal Tsaqib Alfarras"
  description={`${projects.length} proyek yang dapat dibuka sendiri: situs perusahaan, aplikasi simulasi, landing page, alat web, e-commerce, dan alat CLI. Setiap tautan live dapat diperiksa.`}
  descriptionEn={`${projects.length} projects you can open yourself: a company site, a simulation app, a landing page, a web tool, an e-commerce store, and a CLI tool. Every live link can be checked.`}
  jsonLdExtra={jsonLdExtra}
>
  <RouteHero
    fig="fig. 10 · proyek"
    figEn="fig. 10 · work"
    title="Hasil kerja, satu per satu."
    titleEn="Work, one by one."
    lead="Tiap proyek di sini punya tautan live yang bisa Anda buka sendiri. Tidak ada klaim yang tidak bisa diperiksa."
    leadEn="Every project here has a live link you can open yourself. No claim that cannot be checked."
    crumbs={[
      { label: 'Beranda', labelEn: 'Home', href: '/' },
      { label: 'Proyek', labelEn: 'Work', href: '/proyek/' },
    ]}
  />

  <section class="section index-section">
    <div class="wrap">
      <ul class="index-list">
        {projects.map((p, i) => (
          <li
            class={`index-row${i === 0 ? '' : ' rise'}`}
            data-rise="up"
            style={`--rise-delay:${i * 90}ms`}
          >
            <a href={`/proyek/${p.slug}/`} class="index-link">
              <span class="index-shot">
                <img
                  src={p.image}
                  width="1000"
                  height="563"
                  alt=""
                  fetchpriority={i === 0 ? 'high' : undefined}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  draggable="false"
                />
              </span>
              <span class="index-no" aria-hidden="true">
                {p.no}
              </span>
              <span class="index-name" data-i18n-id={p.name}>
                {p.nameEn || p.name}
              </span>
              <span class="index-role" data-i18n-id={p.role}>
                {p.roleEn}
              </span>
              <span class="index-desc" data-i18n-id={p.description}>
                {p.descriptionEn}
              </span>
              <span class="index-stack" data-i18n-id={p.stack.join(' · ')}>
                {p.stackEn?.join(' · ')}
              </span>
              <span class="index-more">
                <span data-i18n-id="Detail">Details</span>
                <span class="index-arrow" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <nav class="back rise" aria-label="Page navigation" data-i18n-aria-id="Navigasi halaman">
        <a href="/layanan/" class="btn btn-ghost" data-i18n-id="Layanan">
          Services
        </a>
        <a href="/#kontak" class="btn btn-primary" data-i18n-id="Mulai proyek">
          Start a project
        </a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .index-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .index-row {
    border-bottom: 1px solid var(--color-line);
  }

  /* Baris daftar disusun seperti tabel, sama seperti halaman layanan: nomor
     sebagai eyebrow di baris penuh, lalu kolom gambar, kolom teks, dan kolom
     label Detail. Area dasar wajib dideklarasikan supaya grid-area bernama
     tidak membentuk kolom hantu 0px. */
  .index-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'no'
      'shot'
      'name'
      'role'
      'desc'
      'stack'
      'more';
    gap: 0.75rem;
    padding: 2rem 0;
    color: inherit;
    text-decoration: none;
    transition: box-shadow var(--dur-fast) var(--ease);
  }

  /* Hover: garis aksen kiri inset, sama seperti halaman layanan. Inset supaya
     tidak menggeser tata letak seperti border. */
  .index-link:hover {
    box-shadow: inset 2px 0 0 0 var(--color-electric);
  }

  .index-link:focus-visible {
    outline: 2px solid var(--color-electric);
    outline-offset: 2px;
  }

  .index-shot {
    grid-area: shot;
    display: block;
    align-self: start;
    border: 1px solid var(--color-line);
    background: var(--color-line-soft);
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .index-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .index-no {
    grid-area: no;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps-loose);
    color: var(--color-electric);
  }

  .index-name {
    grid-area: name;
    min-width: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    color: var(--color-ink);
    text-wrap: balance;
  }

  .index-role {
    grid-area: role;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .index-desc {
    grid-area: desc;
    max-width: 62ch;
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .index-stack {
    grid-area: stack;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps-tight);
    color: var(--color-muted);
  }

  .index-more {
    grid-area: more;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    letter-spacing: var(--tracking-caps-tight);
    text-transform: uppercase;
    color: var(--color-electric);
    white-space: nowrap;
  }

  .index-arrow {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease);
  }

  .index-link:hover .index-arrow,
  .index-link:focus-visible .index-arrow {
    transform: translateX(0.15rem);
  }

  /* Tablet dan desktop: baris menyerupai tabel tiga kolom (gambar, teks,
     label Detail). Susunan ini memakai token tipografi yang sama dengan
     halaman layanan supaya judul baris, deskripsi, dan label Detail berdiri
     pada tingkat yang identik. */
  @media (min-width: 720px) {
    .index-link {
      grid-template-columns: 15rem minmax(0, 1fr) auto;
      grid-template-areas:
        'no    no     no'
        'shot  name   more'
        'shot  role   .'
        'shot  desc   .'
        'shot  stack  .';
      align-items: start;
      column-gap: 2rem;
      row-gap: 0.4rem;
      padding-inline: calc(3rem - var(--grid-gutter));
    }

    .index-more {
      justify-self: end;
    }

    :global(section.route-head .wrap) {
      padding-inline: 3rem;
    }

    .back {
      padding-inline: calc(3rem - var(--grid-gutter));
    }
  }

  @media (min-width: 900px) {
    .index-link {
      grid-template-columns: 15rem minmax(0, 0.9fr) minmax(0, 1.1fr) auto;
      grid-template-areas:
        'no    no    no    no'
        'shot  name  desc  more'
        'shot  role  desc  .'
        'shot  .     stack .';
    }
  }

  /* 720-1228px gutter .wrap naik ke --wrap-gutter-tablet 36px, jadi sisipan
     baris menyesuaikan supaya totalnya tetap 3rem dari tepi dalam bingkai. */
  @media (min-width: 720px) and (max-width: 1228px) {
    .index-link,
    .back {
      padding-inline: calc(3rem - var(--wrap-gutter-tablet));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index-link,
    .index-arrow {
      transition: none;
    }

    .index-link:hover .index-arrow {
      transform: none;
    }
  }

  .back {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* Ritme disamakan dengan halaman layanan: token --space-section dikecilkan
     hanya di section daftar, supaya pita hatch dan garis awal konten turun
     bersama dan baris pertama tetap berdiri di bawah garis batas lembar. */
  .index-section {
    --space-section: clamp(4rem, 7vw, 6rem);
  }

  :global(section.route-head .route-title) {
    max-width: 20ch;
    font-size: var(--text-h1);
  }

  :global(section.route-head .route-lead) {
    max-width: 54ch;
    font-size: var(--text-title-sm);
  }
</style>
