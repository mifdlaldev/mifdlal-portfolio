---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Halaman tidak ditemukan | Mifdlal Tsaqib Alfarras"
  titleEn="Page not found | Mifdlal Tsaqib Alfarras"
  description="Halaman tidak ditemukan."
  descriptionEn="Page not found."
  noindex
  minimal
>
  <section class="section">
    <div class="wrap error-wrap">
      <span class="fig-label" data-i18n-id="error / 404">
        error / 404
      </span>
      <h1 class="section-headline" data-i18n-id="Halaman tidak ditemukan.">
        Page not found.
      </h1>
      <p
        class="error-copy"
        data-i18n-id="Halaman yang Anda cari tidak ada atau sudah dipindahkan. Kembali ke beranda untuk melihat proyek dan layanan."
      >
        The page you are looking for does not exist or has been moved. Go back home to see projects
        and services.
      </p>
      <a href="/" class="btn btn-primary" data-i18n-id="Kembali ke beranda">
        Back to home
      </a>
    </div>
  </section>
</Layout>

<style>
  .error-wrap {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    /* Jarak kecil saja: isi sudah dipusatkan tegak oleh main. Padding besar
       membuat halaman melebihi viewport dan memunculkan scrollbar tak perlu. */
    padding-block: clamp(1rem, 4vh, 3rem);
  }

  .error-wrap .section-headline {
    margin-top: 0.75rem;
  }

  .error-copy {
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    max-width: 42ch;
    margin: 1.25rem auto 2rem;
  }
</style>
